# Docker image configuration
REGISTRY=intel/
TAG=latest

# Compose project name
PROJECT_NAME=live-video-caption-rag

# Host address reachable by browser for WebRTC.
# Run `bash scripts/setup_env.sh` to fill this in automatically.
HOST_IP=127.0.0.1

# Ports
WHIP_SERVER_PORT=8889
EVAM_HOST_PORT=8040
EVAM_PORT=8080
DASHBOARD_PORT=4173
LIVE_VIDEO_RAG_HOST_PORT=4172
MQTT_PORT=1883
METRICS_SERVICE_PORT=9090
EMBEDDING_SERVER_PORT=9777
EMBEDDING_HOST_PORT=8000
VDMS_PORT=55555
VDMS_VDB_HOST_PORT=55555

# WebRTC defaults
WEBRTC_PEER_ID=stream

# Feature flags
ALERT_MODE=false
ENABLE_DETECTION_PIPELINE=false
ENABLE_EMBEDDING=true
CAPTION_HISTORY=3

# RAG chatbot mode: embedded / detached
RAG_CHATBOT_MODE=embedded

# Optional default stream URL shown in the UI
DEFAULT_RTSP_URL=

# Optional: NPU-specific configuration
# NPU_MAX_PROMPT_LENGTH: Maximum number of tokens that the model can process for the input prompt.
#                        Higher values may increase processing time, while lower values may limit the model's ability to process high resolution frames.
#                        Default set to 4096 tokens, which is adjusted to support 1080p frame. You can adjust this value based on your performance requirements.
# NPU_MIN_RESPONSE_LENGTH: Minimum number of tokens that the model can generate for the output response.
NPU_MAX_PROMPT_LENGTH=4096
NPU_MIN_RESPONSE_LENGTH=128

# LLM / embedding / vector-db configuration
# Default LLM_MODEL set to microsoft/Phi-3.5-mini-instruct and LLM_DEVICE set to CPU.
# Visit https://huggingface.co/collections/OpenVINO/llm for collection of OpenVINO optimized LLMs.
# For LLM optimized for NPU, you may visit https://huggingface.co/collections/OpenVINO/llms-optimized-for-npu for a list of supported models.
LLM_MODEL_ID=microsoft/Phi-3.5-mini-instruct
LLM_DEVICE=CPU
MAX_TOKENS=1024
TOP_K=1
SCORE_THRESHOLD=0.5
# NPU-specific configuration for LLM
# The NPU LLM pipeline uses static shapes. Sets the maximum input prompt length in tokens (default: 1024).
MAX_PROMPT_LEN=1024

# Embedding service configuration
# Default EMBEDDING_MODEL_NAME set to QwenText/qwen3-embedding-0.6b.
# Refer to https://github.com/open-edge-platform/edge-ai-libraries/blob/main/microservices/multimodal-embedding-serving/docs/user-guide/supported-models.md#qwen-text-embeddings for a list of supported embedding models.
# Note: NPU support is model-dependent. Verify that the selected model is supported on NPU by checking the https://docs.openvino.ai/2026/documentation/compatibility-and-support/supported-models.html
EMBEDDING_MODEL_NAME=QwenText/qwen3-embedding-0.6b
EMBEDDING_DEVICE=CPU
EMBEDDING_HOST=multimodal-embedding-serving
EMBEDDING_OV_MODELS_DIR=/app/ov_models
EMBEDDING_USE_OV=true
OV_PERFORMANCE_MODE=LATENCY

VDMS_HOST=vdms-vector-db
VDMS_VDB_HOST=vdms-vector-db

# Model download helper
OVMS_RELEASE_TAG=v2026.1.0
MODEL_DOWNLOAD_IMAGE_TAG=latest
HUGGINGFACEHUB_API_TOKEN=
MODEL_DOWNLOAD_EPHEMERAL_SCRIPT_URL=https://raw.githubusercontent.com/open-edge-platform/edge-ai-libraries/main/microservices/model-download/scripts/get_model.sh

# Host/group-specific values. setup_env.sh computes these automatically.
USER_GROUP_ID=1000
VIDEO_GROUP_ID=44
RENDER_GROUP_ID=109
MODEL_CACHE_PATH=/tmp/model_cache
