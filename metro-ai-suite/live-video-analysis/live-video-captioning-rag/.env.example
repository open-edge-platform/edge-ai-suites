# Docker image configuration
REGISTRY=intel/
TAG=2026.2.0-rc1

# Compose project name
PROJECT_NAME=live-video-caption-rag

# Host address reachable by browser for WebRTC.
# Run `bash scripts/setup_env.sh` to fill this in automatically.
HOST_IP=127.0.0.1

# Ports
WHIP_SERVER_PORT=8889
EVAM_HOST_PORT=8040
EVAM_PORT=8080
DASHBOARD_PORT=4173
LIVE_VIDEO_RAG_HOST_PORT=4172
MQTT_PORT=1883
METRICS_SERVICE_PORT=9090
EMBEDDING_SERVER_PORT=9777
EMBEDDING_HOST_PORT=8000
VDMS_PORT=55555
VDMS_VDB_HOST_PORT=55555

# WebRTC defaults
WEBRTC_PEER_ID=stream

# Feature flags
ALERT_MODE=false
ENABLE_DETECTION_PIPELINE=false
ENABLE_EMBEDDING=true
CAPTION_HISTORY=3

# Optional default stream URL shown in the UI
DEFAULT_RTSP_URL=

# Optional: NPU-specific configuration
# NPU_MAX_PROMPT_LENGTH: Maximum number of tokens that the model can process for the input prompt.
#                        Higher values may increase processing time, while lower values may limit the model's ability to process high resolution frames.
#                        Default set to 4096 tokens, which is adjusted to support 1080p frame. You can adjust this value based on your performance requirements.
# NPU_MIN_RESPONSE_LENGTH: Minimum number of tokens that the model can generate for the output response.
NPU_MAX_PROMPT_LENGTH=4096
NPU_MIN_RESPONSE_LENGTH=128

# LLM / embedding / vector-db configuration
# Default LLM_MODEL and EMBEDDING_MODEL set to Qwen2.5-3B-Instruct and Qwen3-embedding-0.6b, which are open-source models from Qwen.
# User may change these to any other model available on HuggingFace Hub which supported by OpenVINO.
# Default set to CPU device for LLM and embedding model. User may change to GPU if available on system.
LLM_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
LLM_DEVICE=CPU
MAX_TOKENS=1024
TOP_K=1
SCORE_THRESHOLD=0.3

EMBEDDING_MODEL_NAME=QwenText/qwen3-embedding-0.6b
EMBEDDING_DEVICE=CPU
EMBEDDING_HOST=multimodal-embedding-serving
EMBEDDING_OV_MODELS_DIR=/app/ov_models
EMBEDDING_USE_OV=true
OV_PERFORMANCE_MODE=LATENCY
DEFAULT_START_OFFSET_SEC=0
DEFAULT_CLIP_DURATION=-1
DEFAULT_NUM_FRAMES=64

VDMS_HOST=vdms-vector-db
VDMS_VDB_HOST=vdms-vector-db

# Model download helper
OVMS_RELEASE_TAG=v2026.1.0
MODEL_DOWNLOAD_IMAGE_TAG=2026.2.0-rc1
HUGGINGFACEHUB_API_TOKEN=
MODEL_DOWNLOAD_EPHEMERAL_SCRIPT_URL=https://raw.githubusercontent.com/open-edge-platform/edge-ai-libraries/release-2026.2.0/microservices/model-download/scripts/get_model.sh

# Host/group-specific values. setup_env.sh computes these automatically.
USER_GROUP_ID=1000
VIDEO_GROUP_ID=44
RENDER_GROUP_ID=109
MODEL_CACHE_PATH=/tmp/model_cache
