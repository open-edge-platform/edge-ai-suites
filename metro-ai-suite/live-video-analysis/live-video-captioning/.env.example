# Docker image configuration
REGISTRY=intel/
TAG=2026.2.0-rc1

# Compose project name
PROJECT_NAME=live-captioning

# Host address reachable by the browser for WebRTC.
# Run `bash scripts/setup_env.sh` to fill this in automatically.
HOST_IP=127.0.0.1

# Ports
WHIP_SERVER_PORT=8889
EVAM_HOST_PORT=8040
EVAM_PORT=8080
DASHBOARD_PORT=4173
MQTT_PORT=1883
METRICS_SERVICE_PORT=9090

# WebRTC defaults
WEBRTC_PEER_ID=stream
WEBRTC_BITRATE=2048

# Feature flags
ALERT_MODE=false
ENABLE_DETECTION_PIPELINE=false
CAPTION_HISTORY=3

# Optional default stream URL shown in the UI
DEFAULT_RTSP_URL=

# Set VLM_CACHE_SIZE to set the KV_CACHE_SIZE to enable caching of the VLM model in the pipeline server.
# The default value is 4. You can adjust this value based on your system's available memory and performance requirements. Increasing the cache size may improve performance but will also increase memory usage.
VLM_CACHE_SIZE=4

# Optional: NPU-specific configuration
# NPU_MAX_PROMPT_LENGTH: Maximum number of tokens that the model can process for the input prompt.
#                        Higher values may increase processing time, while lower values may limit the model's ability to process high resolution frames.
#                        Default set to 4096 tokens, which is adjusted to support 1080p frame. You can adjust this value based on your performance requirements.
# NPU_MIN_RESPONSE_LENGTH: Minimum number of tokens that the model can generate for the output response.
NPU_MAX_PROMPT_LENGTH=4096
NPU_MIN_RESPONSE_LENGTH=128

# Model download helper
OVMS_RELEASE_TAG=v2026.1.0
MODEL_DOWNLOAD_IMAGE_TAG=2026.2.0-rc1
HUGGINGFACEHUB_API_TOKEN=
MODEL_DOWNLOAD_EPHEMERAL_SCRIPT_URL=https://raw.githubusercontent.com/open-edge-platform/edge-ai-libraries/release-2026.2.0/microservices/model-download/scripts/get_model.sh
