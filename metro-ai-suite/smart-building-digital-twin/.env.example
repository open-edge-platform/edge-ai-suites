# Smart Building Digital Twin Configuration
# Copy to .env or run setup.sh
#
# Scenescape images are pulled from Docker Hub automatically by setup.sh.
# GST plugin scripts are fetched via sparse git clone (no manual build step needed).

# Scenescape image tag
SCENESCAPE_IMAGE_TAG=2026.2.0-rc3

# Git branch or tag to sparse-clone the DLStreamer GST plugin scripts from the Scenescape repo
SCENESCAPE_PLUGINS_REF=2026.2.0-rc3

# Primary scene to run (auto-detected from scenes/)
PRIMARY_SCENE=Showcase  
PRIMARY_DATASET=showcase

# Model configuration (default: int8 for both GPU and CPU; override to smartbuilding-fp16 if needed)
MODEL_NAME=smartbuilding-int8
DEVICE_TYPE=gpu
DETECTION_DEVICE=GPU

# Security
# SUPASS is provided interactively during setup or via environment at runtime.
DATABASE_PASSWORD=change_me
