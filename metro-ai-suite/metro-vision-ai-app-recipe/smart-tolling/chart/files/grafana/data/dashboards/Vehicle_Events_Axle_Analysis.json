      "targets": [
        {
          "datasource": {
            "type": "influxdb",
            "uid": "xU6Z19aVk"
          },
          "query": "from(bucket: \"smart-toll-bucket\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n \n  |> filter(fn: (r) =>\n      r._measurement == \"smart_tolling_events\"\n  )\n \n  |> pivot(\n      rowKey: [\"_time\"],\n      columnKey: [\"_field\"],\n      valueColumn: \"_value\"\n  )\n \n  |> filter(fn: (r) =>\n      exists r.license_plate_text and\n      r.license_plate_text != \"\"\n  )\n \n  |> filter(fn: (r) =>\n      exists r.front_plate_image_url or\n      exists r.rear_plate_image_url or\n      exists r.vehicle_front_image_url or\n      exists r.vehicle_rear_image_url\n  )\n \n  |> map(fn: (r) => ({\n \n      _time: r._time,\n      roi_name: r.region_name,\n      license_plate_text: r.license_plate_text,\n      axles: r.axle_count,\n      speed: string(v: r.speed) + \" km/h\",\n      dwell: string(v: r.dwell) + \" s\",\n      image_url:\n \n        if exists r.front_plate_image_url\n \n        then r.front_plate_image_url\n \n        else if exists r.rear_plate_image_url\n \n        then r.rear_plate_image_url\n \n        else \"\",\n \n      vehicle_image_url:\n \n        if exists r.vehicle_front_image_url\n \n        then r.vehicle_front_image_url\n \n        else if exists r.vehicle_rear_image_url\n \n        then r.vehicle_rear_image_url\n \n        else \"\",\n \n      toll_class:\n \n        if r.axle_count < 3 then \"Light\"\n \n        else if r.axle_count == 3 then \"Medium\"\n \n        else if r.axle_count > 3 then \"Heavy\"\n \n        else \"No Class\",\n \n      toll_fee:\n \n        if r.axle_count < 3 then 10\n \n        else if r.axle_count == 3 then 15\n \n        else if r.axle_count > 3 then 20\n \n        else 0\n \n  }))\n \n  |> keep(columns: [\n \n      \"_time\",\n \n      \"license_plate_text\",\n \n      \"axles\",\n \n      \"toll_class\",\n \n      \"toll_fee\",\n \n      \"speed\",\n \n      \"dwell\",\n \n      \"roi_name\",\n \n      \"image_url\",\n \n      \"vehicle_image_url\"\n \n  ])\n \n  |> sort(columns: [\"_time\"], desc: true)",
          "refId": "Events Table"
        }
      ],
