        "content": "<div style=\"\n  display: grid;\n  grid-template-columns: 1fr 1.2fr;\n  padding: 2px;\n  align-items: left;\n\">\n\n\n  <!-- RIGHT: IMAGE -->\n  <div style=\"\n    text-align:center;\n    background: rgba(255,255,255,0.03);\n    border-radius: 10px;\n    padding: 12px;\n  \">\n    <h3 style=\"margin-bottom: 10px; color:#a5d6a7;\">\n       License Plate Image\n    </h3>\n\n    <img\n      src=\"${image}\"\n      style=\"\n        width: 250px;\n        max-height: 420px;\n        border-radius: 8px;\n        border: 1px solid rgba(255,255,255,0.1);\n      \"\n      alt=\"License Plate Image\"\n    />\n <h3 style=\"margin-bottom: 10px; color:#a5d6a7;\">\n       Vehicle Image\n    </h3>\n\n    <img\n      src=\"${vehicle_img}\"\n      style=\"\n        width: 250px;\n        max-height: 420px;\n        border-radius: 8px;\n        border: 1px solid rgba(255,255,255,0.1);\n      \"\n      alt=\"Vehilce Image\"\n    />\n\n    <div style=\"margin-top:8px; font-size:12px; color:#777;\">\n      Click another row to update\n    </div>\n  </div>\n  <!-- LEFT: VEHICLE STATS -->\n  <div style=\"\n    background: rgba(255,255,255,0.03);\n    border-radius: 10px;\n    padding: 10px;\n  \">\n    <h4 style=\"margin-bottom: 2px; color:#90caf9;\">\n      Vehicle Details\n    </h4>\n\n    <table style=\"width:100%; border-collapse: collapse; font-size:12px;\">\n      <tr>\n        <td style=\"padding:6px; color:#aaa;\">License Plate</td>\n        <td style=\"padding:6px; font-weight:bold;\">${plate}</td>\n      </tr>\n      <!-- <tr>\n        <td style=\"padding:6px; color:#aaa;\">Axles </td>\n        <td style=\"padding:6px;\">${axles}</td>\n      </tr> -->\n      <tr>\n        <td style=\"padding:6px; color:#aaa;\">Toll Class </td>\n        <td style=\"padding:6px;\">${toll_class}</td>\n      </tr>\n      <tr>\n        <td style=\"padding:6px; color:#aaa;\">Toll Fee</td>\n        <td style=\"padding:6px;\">$${toll_fee}</td>\n      </tr>\n      <tr>\n        <td style=\"padding:6px; color:#aaa;\">Speed</td>\n        <td style=\"padding:6px;\">${speed}</td>\n      </tr>\n        <tr>\n        <td style=\"padding:6px; color:#aaa;\">Dwell</td>\n        <td style=\"padding:6px;\">${dwell} s</td>\n      </tr>\n    </table>\n  </div>\n\n\n\n</div>\n",
        "mode": "html"
      },
