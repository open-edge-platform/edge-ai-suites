#
# Console settings. The top-level docker-compose.yml reads this file but
# overrides every deployment-specific value below (HOST_IP, service URLs,
# proxy) from the root .env, so a fresh clone needs no edits here.
PIPELINE_SERVER_URL=http://dlstreamer-pipeline-server:8080
MQTT_HOST=broker
MQTT_PORT=1883
MEDIAMTX_URL=http://mediamtx-server:8889
PROMETHEUS_URL=http://prometheus:9090/prometheus
MODEL_ROOT=/home/pipeline-server/models
# Left unset so DEVICES is detected from /dev/dri,/dev/accel (see
# config.py's _probe_devices()) instead of guessing; set explicitly
# (e.g. "CPU,GPU") only to override that detection.
DEVICES=
# Optional x,y,w,h override in source-video pixels. Left unset so the console
# defaults to the zone in loitering_analytics_config.json, the same file the
# CLI sample pipelines use.
DEFAULT_ZONE=
LOITER_THRESHOLD_S=5.0
ZONE_VACANT_GRACE_S=3.0
TRACK_TTL_S=30.0
DETECTIONS_TOPIC_PREFIX=object_tracking
NO_PROXY_LIST=localhost,127.0.0.1,::1,dlstreamer-pipeline-server,mediamtx-server,prometheus,broker
SOURCES_JSON='[{"id":"virat-101","label":"VIRAT_S_000101","uri":"file:///home/pipeline-server/videos/VIRAT_S_000101.mp4"},{"id":"virat-102","label":"VIRAT_S_000102","uri":"file:///home/pipeline-server/videos/VIRAT_S_000102.mp4"},{"id":"virat-103","label":"VIRAT_S_000103","uri":"file:///home/pipeline-server/videos/VIRAT_S_000103.mp4"},{"id":"virat-104","label":"VIRAT_S_000104","uri":"file:///home/pipeline-server/videos/VIRAT_S_000104.mp4"}]'
