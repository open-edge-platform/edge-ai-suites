                    "defaultValue": false
                },
                {
                    "type": "ComboBox",
                    "name": "device",
                    "caption": "Device",
                    "description": "Inference device for the Loitering Detection pipeline",
                    "defaultValue": "CPU",
                    "range": ["CPU", "GPU", "NPU"]
                }
            ]
        },
        "objectActions": []
    },
    "deviceAgentManifest": {
        "supportedTypes": [
            {
                "objectTypeId": "python.detected.object",
                "attributes": ["boundingBox", "confidence"]
            },
            {
                "eventTypeId": "analytics.api.stub.lineCrossing",
                "attributes": []
            }
        ]
    }
}