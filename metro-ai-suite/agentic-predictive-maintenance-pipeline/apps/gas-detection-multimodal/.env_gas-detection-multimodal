
# Gas Detection (Multimodal) — Environment Configuration
# Copy this file and set values for your deployment
# Usage: ./setup.sh --use-case gas-detection-multimodal

# ── Deployment ────────────────────────────────────────────────────────────────
USE_CASE_ID=gas-detection-multimodal
APP_HOST_PORT=8080
# Host/IP shown in the "Application started" URL and used for any host-networked
# access. Defaults to localhost if left unset — override with your machine's LAN
# IP if you need to reach the dashboard from another device.
HOST_IP=localhost

# API key used by agent/storage mutating endpoints (X-API-Key header)
# Change this value before exposing the stack beyond localhost/trusted networks.
APM_API_KEY=change-me-apm-key

# ── LLM / VLM ────────────────────────────────────────────────────────────────
# This use case classifies a static image+sensor dataset (no live video), so
# it runs in rule-based fallback mode by default — no LLM/VLM service needed.
# Set LLM_MODE=llm and fill in the rest below to enable narrative reasoning.
LLM_MODE=fallback
LLM_MODEL_NAME=microsoft/Phi-4-mini-instruct
LLM_DEVICE=CPU
LLM_WEIGHT_FORMAT=int4
LLM_PORT=8010

# ── DL Streamer ───────────────────────────────────────────────────────────────
# Not used by this use case (no live video pipeline) — the dlstreamer
# container still starts (it's part of the always-on base stack) with an
# empty pipeline list (configs/pipeline-server-config.json).
DL_DEVICE=CPU
PIPELINE_SERVER_PORT=8554

# ── Model Download ────────────────────────────────────────────────────────────
# HuggingFace token — only needed if you switch LLM_MODE to "llm" above.
# HUGGINGFACEHUB_API_TOKEN=hf_...
MODEL_DOWNLOAD_PORT=8200

# ── MQTT ─────────────────────────────────────────────────────────────────────
MQTT_HOST=mqtt-broker
MQTT_PORT=1883
MQTT_TOPIC=dlstreamer/detections

# ── Pipeline execution model ──────────────────────────────────────────────────
# This use case has no "Run Pipeline" video trigger. Instead, POST to
# /api/detection/run-multimodal with the mounted docker config, e.g.:
#   curl -X POST http://${HOST_IP}:${APP_HOST_PORT}/api/detection/run-multimodal \
#        -H "Content-Type: application/json" \
#        -d '{"device":"CPU","config_path":"/app/configs/gas_detection.docker.json"}'
# Each call classifies every image in the mounted dataset + its paired sensor
# row, fuses both modalities, persists results to storage-service, and
# publishes the same "batch-complete" MQTT event the agent-service reacts to
# for the video pipeline path.

# ── Telemetry ─────────────────────────────────────────────────────────────────
METRICS_PORT=9091
PROMETHEUS_PORT=9090

# ── Registry (leave empty to use local builds) ───────────────────────────────
REGISTRY=
TAG=latest
