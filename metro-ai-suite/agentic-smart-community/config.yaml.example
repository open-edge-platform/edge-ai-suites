# ─────────────────────────────────────────────────────────────
# Core configuration
# ─────────────────────────────────────────────────────────────
# This reference config wires the dependent services, runtime knobs, and bundled
# use cases. It does not declare monitors; add monitors at runtime by chatting
# with the agent (video-summary-prompt-studio → use_case_register → monitor_ctl).
#
# To run the optional Fridge, Child Safety, and Elder Wakeup reference demo, see
# docs/user-guide/get-started/ready-to-run-demo.md. The demo launcher uses a
# monitor subset matching the user-provided videos.
#
# ─────────────────────────────────────────────────────────────
# Prerequisites
# ─────────────────────────────────────────────────────────────
# ffmpeg    — required by scene_query for frame resize
#             Ubuntu/Debian: sudo apt install ffmpeg
#             macOS:         brew install ffmpeg
#
# ─────────────────────────────────────────────────────────────
# Data directory
# ─────────────────────────────────────────────────────────────
# All runtime data (DB, segments, logs) is stored under a single root directory.
# Set via environment variable — NOT configurable here:
#
#   export SMARTBUILDING_DATA_DIR=/path/to/data   # default: ~/.mcp-smartbuilding
#
# Layout under that directory:
#   smartbuilding.db          — SQLite database
#   segments/<monitor_id>/    — video segments + latest.jpg (written by videostream-analytics)
#     latest.jpg              — latest frame (read by scene_query)
#     queries/                — archived frames from scene_query calls
#   logs/reports/             — SRT debug artifacts from generate_report
# ─────────────────────────────────────────────────────────────

# multilevel-video-understanding service (video segment analysis).
# Optional path_remap: when multilevel runs in a container that mounts the host's data
# dir at a different path, the client rewrites the host prefix to the container prefix
# before POSTing /v1/summary. Drop the block entirely when both sides see the same paths.
summary_service:
  url: http://localhost:8192
  path_remap:
    host_prefix: ${HOME}/.mcp-smartbuilding # host's SMARTBUILDING_DATA_DIR
    container_prefix: /data # container mount point

# vllm-serving-ipex (VLM for scene_query — single-frame queries)
vlm_service:
  url: http://localhost:41091/v1
  model: Qwen/Qwen3.6-35B-A3B
  max_edge_px: 720 # resize longest edge to this before sending to VLM (uses ffmpeg)

# videostream-analytics microservice (motion detection, RTSP processing)
videostream_analytics:
  url: http://localhost:8999

# Keepalive protocol with videostream-analytics
keepalive:
  enabled: true
  interval_ms: 30000 # MCP → VSA heartbeat cadence
  timeout_seconds: 90 # VSA auto-pause threshold (register payload)
  check_interval_seconds: 10 # VSA watchdog poll interval (register payload)

poll_interval_ms: 5000
video_summary_max_concurrent: 2

# Per-monitor log rotation (write target: logs/monitors/<monitor_id>/<YYYY-MM-DD>.log)
logging:
  retention_days: 14 # keep this many calendar days of .log files (today + 13 previous); older deleted
  max_file_mb: 50 # stop appending to a single day's file past this size

# Segment data retention. videostream-analytics writes recordings/motion_events/queries
# under $SMARTBUILDING_DATA_DIR/segments/<monitor_id>/<subdir>/<YYYY-MM-DD>/;
# MCP server keeps this many calendar days (today + N-1 previous) and purges older day-dirs.
# Cleanup runs at server startup and then daily at approximately 00:05 local time.
storage:
  retention_days: 2
  cleanup_subdirs: [ motion_events, recordings, queries ]

# MCP Server HTTP port (for OpenClaw / Claude Desktop connections)
mcp:
  port: 3100

# Events Webhook port (receives events from videostream-analytics microservice)
events_webhook:
  port: 3101

# ─────────────────────────────────────────────────────────────
# Use case library
# ─────────────────────────────────────────────────────────────
# Monitors reference use cases by their `use_case` key. The bundled entries are
# ready to use as starting points; register additional use cases at runtime via
# the smartbuilding_use_case_register tool (draft the prompt with the
# video-summary-prompt-studio skill).
#
# Each entry owns its own `schema:` (extension columns parsed on the shared
# video_summary_tasks table, applied via idempotent ALTER TABLE at startup),
# its `summarize:` tuning, an optional `evaluate_rules_path:` adapter under
# use-cases/<name>/evaluate_rules.py, and its `reports:` defaults. The `alerts`
# table stays use-case-agnostic — no extensions.
#
use_case_dict:
  fridge:
    description: "Fridge content tracking"
    video_summary_task: fridge_monitor
    schema:
      video_summary_tasks: { extensions: [] }
      custom_tables: []
    summarize:
      method: SIMPLE
      processor_kwargs:
        levels: 1
        level_sizes: [ -1 ]
        process_fps: 2
    reports:
      data_source: events
      default_type: daily
      filter: { motion_type: motion }

  child_safety:
    description: "Child safety monitoring"
    video_summary_task: child_safety_monitor
    schema:
      video_summary_tasks:
        extensions:
          - { name: "severity", type: "text", required: false }
          - { name: "event", type: "text", required: true }
          - { name: "desc", type: "text", required: true }
      custom_tables: []
    summarize:
      method: SIMPLE
      processor_kwargs:
        levels: 1
        level_sizes: [ -1 ]
        process_fps: 2
    reports:
      data_source: alerts
      default_type: daily
      filter: {}

  elder_wakeup:
    description: "Elder wakeup monitoring"
    video_summary_task: elder_wakeup_monitor
    evaluate_rules_path: ./use-cases/elder_wakeup/evaluate_rules.py
    schema:
      video_summary_tasks:
        extensions:
          - { name: "event", type: "text", required: true }
          - { name: "wakeup_time", type: "text", required: false }
          - { name: "desc", type: "text", required: true }
      custom_tables: []
    summarize:
      method: SIMPLE
      processor_kwargs:
        levels: 1
        level_sizes: [ -1 ]
        process_fps: 2
    reports:
      data_source: video_summary_tasks
      default_type: weekly
      filter:
        event: wakeup
