# Copy this file to .env and set your own values before starting the stack.
#
#   cp .env.example .env
#
# .env is gitignored and never committed.
# If .env is absent, Docker Compose falls back to the defaults shown here.

# ── UAV Identity ─────────────────────────────────────────────────────────────
# Identifier used in MQTT topics: uav/<UAV_ID>/telemetry/...
UAV_ID=uav-1

# ── InfluxDB ──────────────────────────────────────────────────────────────────
INFLUXDB_PASSWORD=change-me
INFLUXDB_TOKEN=change-me-token
INFLUXDB_ORG=uav-sdk

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=change-me
