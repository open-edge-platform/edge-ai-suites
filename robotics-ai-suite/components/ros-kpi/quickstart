# Quick Start - Interactive launcher for ROS2 KPI Toolkit

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Colors
GREEN=$(printf '\033[0;32m')
BLUE=$(printf '\033[0;34m')
YELLOW=$(printf '\033[1;33m')
NC=$(printf '\033[0m')

# Auto-setup
source ./auto-setup.sh

clear
echo "=========================================="
echo "  ROS2 KPI Toolkit - Quick Start"
echo "=========================================="
echo ""
echo "What would you like to do?"
echo ""
echo "  ${GREEN}1)${NC} Monitor my ROS2 application"
echo "  ${GREEN}2)${NC} Test DDS/RTSP latency (like performance_test)"
echo "  ${GREEN}3)${NC} Quick health check"
echo "  ${GREEN}4)${NC} Start Grafana dashboards"
echo "  ${GREEN}5)${NC} View previous results"
echo "  ${GREEN}6)${NC} Advanced options"
echo "  ${GREEN}0)${NC} Exit"
echo ""
read -p "Choice [0-6]: " choice

case $choice in
    1)
        echo ""
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "  Monitor ROS2 Application"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
        
        # Check if any nodes are running
        nodes=$(ros2 node list 2>/dev/null | grep -v "^$")
        node_count=$(echo "$nodes" | grep -v "^$" | wc -l)
        
        if [ "$node_count" -eq 0 ]; then
            echo -e "${YELLOW}⚠️  No ROS2 nodes detected.${NC}"
            echo ""
            echo "Please start your ROS2 application first, then run this again."
            echo ""
            echo "Examples:"
            echo "  ros2 launch wandering_gazebo_tutorial wandering.launch.py"
            echo "  ros2 run turtlesim turtlesim_node"
            exit 1
        fi
        
        echo "Available nodes:"
        echo "$nodes" | nl -w2 -s") "
        echo ""
        read -p "Monitor specific node? (enter number or 'a' for all): " node_choice
        
        if [[ "$node_choice" =~ ^[0-9]+$ ]]; then
            target_node=$(echo "$nodes" | sed -n "${node_choice}p")
            echo ""
            echo "Monitoring: $target_node"
            read -p "Duration (seconds, default=60): " duration
            duration=${duration:-60}
            
            make monitor-node NODE="$target_node" DURATION="$duration"
        else
            echo ""
            read -p "Duration (seconds, default=60): " duration
            duration=${duration:-60}
            
            make monitor DURATION="$duration"
        fi
        ;;
        
    2)
        echo ""
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "  DDS/RTSP Latency Testing"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
        echo "This requires TWO terminals:"
        echo ""
        echo -e "${YELLOW}Current terminal:${NC} Will run the Main test node"
        echo -e "${YELLOW}Second terminal:${NC} Must run the Relay node"
        echo ""
        echo "In a SECOND terminal, run:"
        echo -e "${BLUE}  cd ~/Documents/ros2-kpi && ./quickstart${NC}"
        echo "  Then select option 7 (Start Relay Node)"
        echo ""
        read -p "Is the Relay node running? (y/n): " relay_ready
        
        if [[ "$relay_ready" != "y" && "$relay_ready" != "Y" ]]; then
            echo ""
            echo "Please start the Relay node first, then try again."
            exit 0
        fi
        
        echo ""
        echo "Test configuration:"
        read -p "Rate (Hz, default=1000): " rate
        rate=${rate:-1000}
        
        read -p "Duration (seconds, default=60): " duration
        duration=${duration:-60}
        
        echo ""
        echo "Starting latency test: ${rate} Hz for ${duration} seconds..."
        make latency-test-main RATE="$rate" DURATION="$duration"
        ;;
        
    3)
        echo ""
        echo "Running quick health check (30 seconds)..."
        make quick-check
        ;;
        
    4)
        echo ""
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "  Grafana Dashboards"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
        echo "  1) Start Grafana/Prometheus"
        echo "  2) Stop Grafana/Prometheus"
        echo "  3) Check status"
        echo "  4) Open Grafana in browser"
        echo ""
        read -p "Choice: " grafana_choice
        
        case $grafana_choice in
            1) make grafana-start ;;
            2) make grafana-stop ;;
            3) make grafana-status ;;
            4) make grafana-open ;;
            *) echo "Invalid choice" ;;
        esac
        ;;
        
    5)
        echo ""
        echo "Previous monitoring sessions:"
        make list-sessions
        echo ""
        echo "  1) Visualize last session"
        echo "  2) Analyze specific session"
        echo "  3) Clean old sessions"
        echo ""
        read -p "Choice: " results_choice
        
        case $results_choice in
            1) make visualize-last ;;
            2) 
                read -p "Session name: " session_name
                make analyze-session SESSION="$session_name"
                ;;
            3) make clean ;;
            *) echo "Invalid choice" ;;
        esac
        ;;
        
    6)
        echo ""
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo "  Advanced Options"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        echo ""
        echo "  1) Extended monitoring (5 minutes)"
        echo "  2) Benchmark mode (10 minutes)"
        echo "  3) Remote monitoring"
        echo "  4) Interactive heatmap"
        echo "  5) Show all commands (make help)"
        echo ""
        read -p "Choice: " advanced_choice
        
        case $advanced_choice in
            1) 
                read -p "Node name (or press Enter for all): " node_name
                if [ -n "$node_name" ]; then
                    make monitor-long NODE="$node_name"
                else
                    make monitor-long
                fi
                ;;
            2) 
                read -p "Node name (or press Enter for all): " node_name
                if [ -n "$node_name" ]; then
                    make benchmark NODE="$node_name"
                else
                    make benchmark
                fi
                ;;
            3)
                read -p "Remote IP address: " remote_ip
                read -p "Remote user (default=$USER): " remote_user
                remote_user=${remote_user:-$USER}
                
                make monitor-remote REMOTE_IP="$remote_ip" REMOTE_USER="$remote_user"
                ;;
            4) make interactive-heatmap ;;
            5) make help ;;
            *) echo "Invalid choice" ;;
        esac
        ;;
    
    7)
        # Hidden option for relay node
        echo ""
        echo "Starting Relay node for latency testing..."
        echo "Keep this running while the Main test executes."
        echo ""
        make latency-test-relay
        ;;
        
    0)
        echo "Goodbye!"
        exit 0
        ;;
        
    *)
        echo "Invalid choice"
        exit 1
        ;;
esac

echo ""
echo "Done!"
