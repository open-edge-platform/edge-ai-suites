# Copy this file to .env and adjust as needed. .env is gitignored.
# Loaded automatically by src/log_config.py (no python-dotenv dependency needed).

# Logging verbosity for all Python scripts under src/ (DEBUG, INFO, WARNING, ERROR, CRITICAL).
# - DEBUG            : shows per-run and post-benchmark result tables (analyze_trigger_latency.py,
#                       aggregate_kpi.py) in addition to progress/status messages — recommended
#                       for local/interactive use.
# - INFO (default)   : progress/status messages only, no result tables.
# - WARNING          : quiet mode — only warnings/errors (useful for CI, equivalent to
#                       passing --log-level WARNING to individual scripts).
LOG_LEVEL=INFO
