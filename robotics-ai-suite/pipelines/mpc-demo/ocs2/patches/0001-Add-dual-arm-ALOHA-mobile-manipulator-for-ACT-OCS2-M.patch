+void MPC_ROS_Interface::launchNodes_mujoco(const rclcpp::Node::SharedPtr& node) {
+  RCLCPP_INFO(LOGGER, "MPC node is setting up ...");
+  node_ = node;
+
+  // Observation subscriber
+  // modify to /left_arm/pose and /right_arm/pose when applying dual-arm
+  mpcObservationSubscriber_ = node_->create_subscription<ocs2_msgs::msg::MpcObservation>(
+      "pose", 
+      1, 
+      std::bind(&MPC_ROS_Interface::mpcObservationCallback, this, std::placeholders::_1)
+  );
+
+  // MPC publisher — transient_local to match MRT subscriber QoS (DURABILITY_QOS_POLICY).
+  // Without this, MRT receives the DURABILITY_QOS_POLICY incompatibility warning and
+  // never receives any policy messages.
+  const auto latchedQos =
+      rclcpp::QoS(rclcpp::KeepLast(1)).transient_local().reliable();
+  mpcPolicyPublisher_ = node_->create_publisher<ocs2_msgs::msg::MpcFlattenedController>(
+      topicPrefix_ + "_mpc_policy",
+      latchedQos
+  );
+
+  // MPC reset service server
+  mpcResetServiceServer_ = node_->create_service<ocs2_msgs::srv::Reset>(
+      topicPrefix_ + "_mpc_reset",
+      [this](const std::shared_ptr<ocs2_msgs::srv::Reset::Request>& request,
+             const std::shared_ptr<ocs2_msgs::srv::Reset::Response>& response) {
+        return resetMpcCallback(request, response);
+      });
+
+  // display
+#ifdef PUBLISH_THREAD
+  RCLCPP_INFO(LOGGER, "Publishing SLQ-MPC messages on a separate thread.");
+#endif
+
+  RCLCPP_INFO(LOGGER, "MPC node is ready.");
+
+  // spin
+  spin();
+}
+
+/******************************************************************************************************/
+/******************************************************************************************************/
+/******************************************************************************************************/
+void MPC_ROS_Interface::launchNodes_aloha(const rclcpp::Node::SharedPtr& node) {
+  RCLCPP_INFO(LOGGER, "MPC node is setting up ...");
+  node_ = node;
+
+  // Observation subscriber according to namespace
+  std::string nodeNamespace = node_->get_namespace();
+  if (nodeNamespace == "/left_arm") {
+    alohaObservationSubscriber_ = node_->create_subscription<sensor_msgs::msg::JointState>(
+      "/follower_left/joint_states",
+      1,
+      std::bind(&MPC_ROS_Interface::alohaObservationCallback, this, std::placeholders::_1)
+    );
+  } else if (nodeNamespace == "/right_arm") {
+    alohaObservationSubscriber_ = node_->create_subscription<sensor_msgs::msg::JointState>(
+      "/follower_right/joint_states",
+      1,
+      std::bind(&MPC_ROS_Interface::alohaObservationCallback, this, std::placeholders::_1)
+    );
+  } else {
+    RCLCPP_ERROR_STREAM(LOGGER, "Unknown namespace '" << nodeNamespace << "' in mpc node");
+  }
+
+  // MPC publisher — transient_local to match MRT subscriber QoS (DURABILITY_QOS_POLICY).
+  const auto latchedQosAloha =
+      rclcpp::QoS(rclcpp::KeepLast(1)).transient_local().reliable();
+  mpcPolicyPublisher_ = node_->create_publisher<ocs2_msgs::msg::MpcFlattenedController>(
+      topicPrefix_ + "_mpc_policy", latchedQosAloha);
+
+  // MPC reset service server
+  mpcResetServiceServer_ = node_->create_service<ocs2_msgs::srv::Reset>(
+      topicPrefix_ + "_mpc_reset",
+      [this](const std::shared_ptr<ocs2_msgs::srv::Reset::Request>& request,
+             const std::shared_ptr<ocs2_msgs::srv::Reset::Response>& response) {
+        return resetMpcCallback(request, response);
+      });
+
+  // display
+#ifdef PUBLISH_THREAD
+  RCLCPP_INFO(LOGGER, "Publishing SLQ-MPC messages on a separate thread.");
+#endif
+
+  RCLCPP_INFO(LOGGER, "MPC node is ready.");
+
+  // spin
+  spin();
+}
+
+
 }  // namespace ocs2
