+/******************************************************************************************************/
+/******************************************************************************************************/
+/******************************************************************************************************/
+void MRT_ROS_Dummy_Loop::run_synchronizedWallClockLoop(const SystemObservation& initObservation,
+                             const TargetTrajectories& initTargetTrajectories) {
+  RCLCPP_INFO_STREAM(LOGGER, "Waiting for the initial policy ...");
+
+  rclcpp::Rate loop_rate(mrtDesiredFrequency_);
+  // Reset MPC node
+  mrt_.resetMpcNode(initTargetTrajectories);
+
+  // Wait for the initial policy
+  while (!mrt_.initialPolicyReceived() && rclcpp::ok()) {
+    mrt_.spinMRT();
+    mrt_.setCurrentObservation(initObservation);
+    loop_rate.sleep();
+  }
+  RCLCPP_INFO_STREAM(LOGGER, "Initial policy has been received.");
+
+  // Pick simulation loop mode
+  if (mpcDesiredFrequency_ > 0.0) {
+    synchronizedWallClockLoop(initObservation, initTargetTrajectories);
+  } else {
+    realtimeDummyLoop(initObservation, initTargetTrajectories);
+  }
+}
+
+/******************************************************************************************************/
+/******************************************************************************************************/
+/******************************************************************************************************/
+void MRT_ROS_Dummy_Loop::synchronizedWallClockLoop(
+    const SystemObservation& initObservation,
+    const TargetTrajectories& initTargetTrajectories) {
+  SystemObservation currentObservation = initObservation;
+  bool policyActive = false;
+
+  // Query time is anchored to wall-clock at first policy receipt:
+  //   rawQueryTime = timeAnchor + (wallNow - wallAnchor)
+  // This ensures query time advances at 1:1 wall-clock rate regardless of
+  // policy arrival frequency.  A forward-only clamp prevents regression.
+  rclcpp::Clock wallClock(RCL_STEADY_TIME);
+  scalar_t wallAnchor   = 0.0;
+  scalar_t timeAnchor   = 0.0;
+  bool     anchorSet    = false;
+  scalar_t queryTimePrev = -1.0;
+
+  // Lookahead offset keeps query time ahead of policyFront across policy updates.
+  scalar_t lookahead = 0.0;
+
+  // Linear blend over one MPC period at policy switches to smooth command discontinuities.
+  bool     transInProgress = false;
+  vector_t transOldState;
+  scalar_t transStartWall  = 0.0;
+  scalar_t transDuration   = 0.0;
+
+  rclcpp::Rate simRate(mrtDesiredFrequency_);
+  while (rclcpp::ok()) {
+    // Trigger MRT callbacks to receive any pending policies from the MPC.
+    mrt_.spinMRT();
+
+    if (mrt_.updatePolicy()) {
+      policyActive = true;
+      if (!anchorSet) {
+        // First policy: initialize wall-clock anchor and lookahead.
+        const scalar_t solutionWindow =
+            mrt_.getPolicy().timeTrajectory_.back() -
+            mrt_.getPolicy().timeTrajectory_.front();
+        const scalar_t mpcPeriod = 1.0 / mpcDesiredFrequency_;
+        // lookahead     = std::min(15.0 * mpcPeriod, 0.2 * solutionWindow);
+        lookahead     = 0.05; // 50 ms lookahead has good performance in simulation.
+        transDuration = mpcPeriod;
+        wallAnchor    = wallClock.now().seconds();
+        timeAnchor    = mrt_.getPolicy().timeTrajectory_.front() + lookahead;
+        anchorSet     = true;
+        RCLCPP_INFO_STREAM(rclcpp::get_logger("MRT_ROS_Dummy_Loop"),
+                           "lookahead=" << lookahead << " s"
+                           "  transDuration=" << transDuration << " s"
+                           "  (mpcPeriod=" << mpcPeriod << " s"
+                           ", solutionWindow=" << solutionWindow << " s)");
+      } else {
+        // Start (or restart) linear blend from current state to new policy.
+        transInProgress = true;
+        transOldState   = currentObservation.state;
+        transStartWall  = wallClock.now().seconds();
+      }
+    }
+
+    if (!policyActive) {
+      simRate.sleep();
+      continue;
+    }
+
+    mrtTimer_.startTimer();
+
+    const scalar_t policyFront = mrt_.getPolicy().timeTrajectory_.front();
+    const scalar_t policyBack  = mrt_.getPolicy().timeTrajectory_.back();
+
+    const scalar_t rawQueryTime = timeAnchor +
+                                  (wallClock.now().seconds() - wallAnchor);
+
+    // Forward-only + policy range clamp.
+    const scalar_t queryTime = std::min(
+        std::max(rawQueryTime, queryTimePrev < 0.0 ? policyFront : queryTimePrev),
+        policyBack);
+    queryTimePrev = queryTime;
+
+    SystemObservation nextObservation;
+    nextObservation.time = queryTime;
+    mrt_.evaluatePolicy(queryTime, currentObservation.state,
+                        nextObservation.state, nextObservation.input,
+                        nextObservation.mode);
+    mrtTimer_.endTimer();
+
+    // Save unblended state for MPC feedback (blended state would cause feedback loop).
+    const vector_t rawPolicyState = nextObservation.state;
+
+    // Blend robot command at policy switches; MPC feedback uses raw state above.
+    if (transInProgress) {
+      const scalar_t elapsed = wallClock.now().seconds() - transStartWall;
+      const scalar_t alpha   = std::min(elapsed / transDuration, 1.0);
+      nextObservation.state  = (1.0 - alpha) * transOldState
+                               + alpha       * nextObservation.state;
+      if (alpha >= 1.0) {
+        transInProgress = false;
+      }
+    }
+
+    currentObservation = nextObservation;
+
+    // Feed unblended state back to MPC.
+    SystemObservation mpcObservation = currentObservation;
+    mpcObservation.state = rawPolicyState;
+    mrt_.setCurrentObservation(mpcObservation);
+
+    // Publish blended state as robot command.
+    modifyObservation(currentObservation);
+    for (auto& observer : observers_) {
+      observer->update(currentObservation, mrt_.getPolicy(), mrt_.getCommand());
+    }
+
+    // //display
+    // std::cerr << '\n';
+    // std::cerr << "\n### FOR MRT_ROS Benchmarking";
+    // std::cerr << "\n###   Maximum : " << mrtTimer_.getMaxIntervalInMilliseconds() << "[ms] in interval " << mrtTimer_.getMaxIntervalIndex() << ".";
+    // std::cerr << "\n###   Average : " << mrtTimer_.getAverageInMilliseconds() << "[ms].";
+    // std::cerr << "\n###   Latest  : " << mrtTimer_.getLastIntervalInMilliseconds() << "[ms]." << std::endl;
+
+    simRate.sleep();
+  }
+}
