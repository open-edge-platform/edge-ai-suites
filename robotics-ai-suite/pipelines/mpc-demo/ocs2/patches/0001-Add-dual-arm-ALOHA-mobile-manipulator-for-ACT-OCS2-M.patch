+/******************************************************************************************************/
+/******************************************************************************************************/
+/******************************************************************************************************/
+void RosReferenceManager::subscribe_aloha_trajectory_end_effector(const rclcpp::Node::SharedPtr& node, PinocchioInterface pinocchioInterface, int eeFrameId, const std::string& armSide) {
+  node_ = node;
+
+  auto modeScheduleCallback = [this](const ocs2_msgs::msg::ModeSchedule& msg) {
+    auto modeSchedule = ros_msg_conversions::readModeScheduleMsg(msg);
+    referenceManagerPtr_->setModeSchedule(std::move(modeSchedule));
+  };
+  modeScheduleSubscriber_ =
+      node_->create_subscription<ocs2_msgs::msg::ModeSchedule>(
+          topicPrefix_ + "_mode_schedule", 1, modeScheduleCallback);
+
+  auto model = pinocchioInterface.getModel();
+
+  auto alohaTrajectoryCallback = [this, model, eeFrameId, armSide](const ocs2_msgs::msg::JointTrajectoryCommand& msg) {
+    if (msg.traj.points.empty()) {
+      RCLCPP_WARN(node_->get_logger(), "Received empty aloha joint trajectory.");
+      return;
+    }
+
+    // OCS2 trajectory input path: one JointTrajectoryCommand produces
+    // a time-aligned sequence of OCS2 targets.
+    //
+    // time_from_start[k] is a *relative* offset from the publish moment (0 ~ horizon s).
+    // Anchor it to the subscriber's wall-clock so that desiredTimeTrajectory lives in
+    // the same epoch as MPC's currentObservation.time (~1.78×10⁹ s).
+    // Without this anchor, MPC would receive targets at t=[0,1.5]s while its own
+    // clock is at ~1.78e9 s — LinearInterpolation clamps to the last point and
+    // the arm only ever tracks the final endpoint, ignoring all intermediate targets.
+    // Use the message's publish timestamp (header.stamp) instead of
+    // reception time (node_->now()) so that the time base is consistent
+    // with the publisher's clock and not delayed by transport latency.
+    const double startTime = rclcpp::Time(msg.traj.header.stamp).seconds();
+    scalar_array_t desiredTimeTrajectory;
+    vector_array_t desiredStateTrajectory;
+    vector_array_t desiredInputTrajectory;
+    desiredTimeTrajectory.reserve(msg.traj.points.size());
+    desiredStateTrajectory.reserve(msg.traj.points.size());
+    desiredInputTrajectory.reserve(msg.traj.points.size());
+
+    const auto jointTrajectory =
+      ros_msg_conversions::readAlohaTargetTrajectoryMsg(msg);
+
+    for (size_t i = 0; i < msg.traj.points.size(); ++i) {
+      // publisher-clock anchor + relative offset → absolute time aligned with MPC epoch.
+      desiredTimeTrajectory.emplace_back(
+          startTime + rclcpp::Duration(msg.traj.points[i].time_from_start).seconds());
+
+      pinocchio::Data data(model);
+      pinocchio::forwardKinematics(model, data, jointTrajectory[i]);
+      pinocchio::updateFramePlacements(model, data);
+      Eigen::Vector3d translation = data.oMf[eeFrameId].translation();
+      Eigen::Quaterniond quaternion(data.oMf[eeFrameId].rotation());
+      desiredStateTrajectory.emplace_back(
+        (vector_t(7) << translation, quaternion.coeffs()).finished());
+      desiredInputTrajectory.emplace_back(vector_t::Zero(model.nv));
+    }
+
+    // Merge with pendingTrajectory_:
+    //   - Keep every pending point whose time is strictly < new trajectory's start.
+    //   - Discard all pending points at or after that time (they are replaced by
+    //     the new trajectory, which may overlap or extend the existing one).
+    //   - Append the entire new trajectory after the kept prefix.
+    //
+    // This handles three cases uniformly:
+    // Traj1 [t₀, t₀+T]，Traj 2 [t₀+t', t₀+t'+T']
+    //   1. No overlap  (t' >= T): pure extension – entire pending is kept.
+    //   2. Partial overlap (t' < T): pending is truncated at t', new tail appended.
+    //   3. Full replacement (t' <= t₀): pending is empty after truncation.
+    const scalar_t newStartTime = desiredTimeTrajectory.front();
+    {
+      std::lock_guard<std::mutex> lock(pendingMutex_);
+
+      // Count how many pending points lie strictly before the new trajectory.
+      size_t keepCount = 0;
+      for (; keepCount < pendingTrajectory_.timeTrajectory.size(); ++keepCount) {
+        if (pendingTrajectory_.timeTrajectory[keepCount] >= newStartTime) {
+          break;
+        }
+      }
+
+      scalar_array_t mergedTime;
+      vector_array_t mergedState;
+      vector_array_t mergedInput;
+      mergedTime.reserve(keepCount + desiredTimeTrajectory.size());
+      mergedState.reserve(keepCount + desiredStateTrajectory.size());
+      mergedInput.reserve(keepCount + desiredInputTrajectory.size());
+
+      // Prefix: pending points before the new trajectory's start.
+      mergedTime.insert(mergedTime.end(),
+          pendingTrajectory_.timeTrajectory.begin(),
+          pendingTrajectory_.timeTrajectory.begin() + keepCount);
+      mergedState.insert(mergedState.end(),
+          pendingTrajectory_.stateTrajectory.begin(),
+          pendingTrajectory_.stateTrajectory.begin() + keepCount);
+      mergedInput.insert(mergedInput.end(),
+          pendingTrajectory_.inputTrajectory.begin(),
+          pendingTrajectory_.inputTrajectory.begin() + keepCount);
+
+      // Suffix: the new trajectory in its entirety.
+      mergedTime.insert(mergedTime.end(),
+          desiredTimeTrajectory.begin(), desiredTimeTrajectory.end());
+      mergedState.insert(mergedState.end(),
+          desiredStateTrajectory.begin(), desiredStateTrajectory.end());
+      mergedInput.insert(mergedInput.end(),
+          desiredInputTrajectory.begin(), desiredInputTrajectory.end());
+
+      pendingTrajectory_ = TargetTrajectories(
+          std::move(mergedTime), std::move(mergedState), std::move(mergedInput));
+
+      RCLCPP_DEBUG(node_->get_logger(),
+          "[subscribe_aloha_trajectory_end_effector] merged: kept %zu pending points before t=%.3f, "
+          "appended %zu new points (merged total=%zu)",
+          keepCount, newStartTime, desiredTimeTrajectory.size(),
+          pendingTrajectory_.timeTrajectory.size());
+
+      referenceManagerPtr_->setTargetTrajectories(pendingTrajectory_);
+    }
+  };
+
+  if (armSide == "LEFT") {
+    alohaTrajectorySubscriber_ =
+        node_->create_subscription<ocs2_msgs::msg::JointTrajectoryCommand>(
+            "/follower_left/mpc_commands/joint_trajectory", 1,
+            alohaTrajectoryCallback);
+  } else if (armSide == "RIGHT") {
+    alohaTrajectorySubscriber_ =
+        node_->create_subscription<ocs2_msgs::msg::JointTrajectoryCommand>(
+            "/follower_right/mpc_commands/joint_trajectory", 1,
+            alohaTrajectoryCallback);
+  } else {
+    std::cerr << "[Error] Invalid armSide parameter " << armSide << ". Use LEFT or RIGHT.\n";
+    return;
+  }
+}
