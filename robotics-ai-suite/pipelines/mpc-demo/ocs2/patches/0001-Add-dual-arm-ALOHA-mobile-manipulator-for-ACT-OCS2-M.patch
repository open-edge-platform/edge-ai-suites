+    pinocchio::updateFramePlacements(model, data);
+
+    // stateTrajectory format: [ee_pos(3), ee_quat(4)]  (legacy, 7D)
+    Eigen::Quaterniond quaternion(data.oMf[eeFrameId].rotation());
+    const vector_t target = (vector_t(7)
+        << data.oMf[eeFrameId].translation(), quaternion.coeffs()).finished();
+
+    // OCS2 point input path: one JointGroupCommand produces one target point at current time.
+    const scalar_array_t desiredTimeTrajectory{static_cast<float>(node_->now().seconds())};
