+
+namespace ocs2 {
+namespace mobile_manipulator {
+
+/**
+ * Quadratic joint-state tracking cost for the mobile manipulator.
+ *
+ * Expects the reference stateTrajectory to use the extended format:
+ *   [joints(stateDim), ee_position(3), ee_quaternion(4)]
+ *
+ * Whether this cost is active is controlled by the "stateCost.activate" flag
+ * in task.info.  When the flag is false the cost is never registered and
+ * the stateTrajectory format is unconstrained.
+ */
+class QuadraticJointStateCost final : public QuadraticStateCost {
+ public:
+  QuadraticJointStateCost(matrix_t Q, size_t stateDim)
+      : QuadraticStateCost(std::move(Q)), stateDim_(stateDim) {}
+
+  ~QuadraticJointStateCost() override = default;
+  QuadraticJointStateCost(const QuadraticJointStateCost& rhs) = default;
+  QuadraticJointStateCost* clone() const override { return new QuadraticJointStateCost(*this); }
+
+ protected:
+  vector_t getStateDeviation(scalar_t time, const vector_t& state, const TargetTrajectories& targetTrajectories) const override {
+    const vector_t desiredState = targetTrajectories.getDesiredState(time);
+    return state - desiredState.head(stateDim_);
+  }
+
+ private:
+  const size_t stateDim_;
+};
+
+}  // namespace mobile_manipulator
+}  // namespace ocs2
