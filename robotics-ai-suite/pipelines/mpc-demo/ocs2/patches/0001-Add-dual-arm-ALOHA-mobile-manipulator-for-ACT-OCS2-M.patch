+
+  // get robot model for forward kinematics
+  auto model = pinocchioInterface.getModel();
+
+  // TargetTrajectories
+  auto alohaTargetTrajectoriesCallback = [this, model, eeFrameId](const ocs2_msgs::msg::JointGroupCommand& msg) {
+    // msg.cmd contains target joint positions for this arm (6 DOF for ALOHA).
+    auto jointCommands = ros_msg_conversions::readAlohaTargetQposMsg(msg);
+    pinocchio::Data data(model);
