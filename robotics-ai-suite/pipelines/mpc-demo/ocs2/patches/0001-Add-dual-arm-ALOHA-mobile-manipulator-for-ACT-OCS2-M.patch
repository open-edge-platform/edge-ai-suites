+vector_t readActTargetQposMsg(const std_msgs::msg::Float32MultiArray& actTargetMsg) {
+
+  if (actTargetMsg.data.empty()) {
+      throw std::runtime_error("Input array is empty.");
+  }
+
+  std::vector<float> act_state(actTargetMsg.data.size());
+  for (int i = 0; i < actTargetMsg.data.size(); i++){
+    act_state[i] = actTargetMsg.data.at(i);
+  }
+
+  return Eigen::Map<const Eigen::VectorXf>(act_state.data(), act_state.size()).cast<scalar_t>();
+}
+
+/******************************************************************************************************/
+/******************************************************************************************************/
+/******************************************************************************************************/
+vector_t readAlohaTargetQposMsg(const ocs2_msgs::msg::JointGroupCommand& alohaTargetMsg) {
+
+  if (alohaTargetMsg.cmd.empty()) {
+      throw std::runtime_error("Input array is empty.");
+  }
+
+  const std::vector<float>& cmd_data = alohaTargetMsg.cmd;
+  return Eigen::Map<const Eigen::VectorXf>(cmd_data.data(), cmd_data.size()).cast<scalar_t>();
+}
+
+/******************************************************************************************************/
+/******************************************************************************************************/
+/******************************************************************************************************/
+vector_array_t readAlohaTargetTrajectoryMsg(const ocs2_msgs::msg::JointTrajectoryCommand& alohaTrajectoryMsg) {
+
+  if (alohaTrajectoryMsg.traj.points.empty()) {
+    throw std::runtime_error("Input trajectory is empty.");
+  }
+
+  vector_array_t jointTrajectory;
+  jointTrajectory.reserve(alohaTrajectoryMsg.traj.points.size());
+
+  for (const auto& point : alohaTrajectoryMsg.traj.points) {
+    if (point.positions.empty()) {
+      throw std::runtime_error("Joint trajectory point positions are empty.");
+    }
+
+    jointTrajectory.emplace_back(
+        Eigen::Map<const Eigen::VectorXd>(point.positions.data(),
+                                          point.positions.size())
+            .cast<scalar_t>());
+  }
+
+  return jointTrajectory;
+}
