index 000000000..1c3a40a7e
--- /dev/null
+++ b/ocs2_robotic_examples/ocs2_mobile_manipulator_nonros/src/ShmTransport.cpp
@@ -0,0 +1,142 @@
+/******************************************************************************
+Copyright (c) 2026, Intel Corporation. All rights reserved.
+******************************************************************************/
+
+#include "ocs2_mobile_manipulator_nonros/ShmTransport.h"
+
+#include <algorithm>
+#include <chrono>
+#include <set>
+
+#include "ocs2_mobile_manipulator_nonros/Topics.h"
+
+namespace ocs2 {
+namespace mobile_manipulator {
+namespace nonros {
+
+ShmTransport::ShmTransport(std::string ownPrefix, std::vector<std::string> broadcastPrefixes,
+                           bool persistPublisherBlocks)
+    : ownPrefix_(std::move(ownPrefix)),
+      broadcastPrefixes_(std::move(broadcastPrefixes)),
+      persistPublisherBlocks_(persistPublisherBlocks) {
+  // Reject empty / duplicate broadcast prefixes: an empty entry (e.g. --left "")
+  // produces block 'act_target_qpos__' that no node subscribes to, and a duplicate
+  // would shm_blkbuf_init the same block twice. Fail fast at construction.
+  std::set<std::string> seen;
+  for (const std::string& prefix : broadcastPrefixes_) {
+    if (prefix.empty()) {
+      throw std::invalid_argument("ShmTransport: broadcastPrefixes contains an empty prefix");
+    }
+    if (!seen.insert(prefix).second) {
+      throw std::invalid_argument("ShmTransport: broadcastPrefixes contains a duplicate prefix '" +
+                                  prefix + "'");
+    }
+  }
+}
+
+ShmTransport::~ShmTransport() {
+  // Stop the receiver BEFORE closing any handle it might still touch.
+  receiverRunning_.store(false, std::memory_order_release);
+  if (receiver_.joinable()) {
+    receiver_.join();
+  }
+  // Ownership model (see below): shm_blkbuf_close() unconditionally shm_unlink()s the
+  // block, so ONLY the creator (publisher, shm_blkbuf_init) may close. Subscriber
+  // handles (shm_blkbuf_open) are intentionally NOT closed here — closing one would
+  // delete a block another process still owns, breaking restart. The subscriber's mmap
+  // is reclaimed by the kernel on process exit (the handle itself is the mmap'd region),
+  // so this leaks nothing in practice for a process-lifetime transport.
+  //
+  // persistPublisherBlocks_ extends that same "don't unlink a block peers still use"
+  // reasoning to the CREATED blocks: skipping close keeps them named in /dev/shm so a
+  // restarted publisher reattaches to the same segment (shm_open O_CREAT, no O_EXCL) and
+  // the already-running consumers keep receiving. The kernel reclaims our mmap on exit.
+  if (!persistPublisherBlocks_) {
+    for (auto handle : pubHandles_) {
+      if (handle != nullptr) {
+        shm_blkbuf_close(handle);
+      }
+    }
+  }
+}
+
+std::string ShmTransport::toBlockName(const std::string& topic) {
+  std::string block = topic;
+  std::replace(block.begin(), block.end(), '/', '_');
+  return block;
+}
+
+bool ShmTransport::isBroadcastTopic(const std::string& topic) {
+  // The only global (prefix-less) topic that must reach every arm process.
+  return topic == topics::kActTargetQpos;
+}
+
+std::string ShmTransport::blockForPrefix(const std::string& topic, const std::string& prefix) {
+  return toBlockName(topic) + "__" + prefix;
+}
+
+std::vector<std::string> ShmTransport::publisherBlockNames(const std::string& topic) const {
+  if (!isBroadcastTopic(topic)) {
+    return {toBlockName(topic)};
+  }
+  if (broadcastPrefixes_.empty()) {
+    throw std::runtime_error("ShmTransport: publishing broadcast topic '" + topic +
+                             "' requires a non-empty broadcastPrefixes list");
+  }
+  std::vector<std::string> blocks;
+  blocks.reserve(broadcastPrefixes_.size());
+  for (const std::string& prefix : broadcastPrefixes_) {
+    blocks.push_back(blockForPrefix(topic, prefix));
+  }
+  return blocks;
+}
+
+std::string ShmTransport::subscriberBlockName(const std::string& topic) const {
+  if (!isBroadcastTopic(topic)) {
+    return toBlockName(topic);
+  }
+  if (ownPrefix_.empty()) {
+    throw std::runtime_error("ShmTransport: subscribing broadcast topic '" + topic +
+                             "' requires ownPrefix to be set");
+  }
+  return blockForPrefix(topic, ownPrefix_);
+}
+
+void ShmTransport::startReceiverIfNeeded() {
+  bool expected = false;
+  if (receiverRunning_.compare_exchange_strong(expected, true)) {
+    receiver_ = std::thread(&ShmTransport::receiverLoop, this);
+  }
+}
+
+void ShmTransport::receiverLoop() {
+  while (receiverRunning_.load(std::memory_order_acquire)) {
+    {
+      std::lock_guard<std::mutex> lock(pollersMutex_);
+      for (auto& entry : pollers_) {
+        if (!entry->active.load(std::memory_order_acquire)) {
+          continue;
+        }
+        // Lazily open the block; the publisher process may not exist yet. Throttle the
+        // retry (shmringbuf logs on every failed open) — attempt only once per ~1s.
+        if (entry->handle == nullptr) {
+          const bool attempt = (entry->tick % kOpenRetryTicks) == 0;
+          ++entry->tick;
+          if (!attempt) {
+            continue;
+          }
+          entry->handle = shm_blkbuf_open(const_cast<char*>(entry->blockName.c_str()));
+          if (entry->handle == nullptr) {
+            continue;
+          }
+        }
+        entry->pollOnce(entry->handle);
+      }
+    }
+    std::this_thread::sleep_for(std::chrono::microseconds(kPollIntervalUs));
+  }
+}
+
+}  // namespace nonros
+}  // namespace mobile_manipulator
+}  // namespace ocs2
diff --git a/ocs2_robotic_examples/ocs2_mobile_manipulator_nonros/test/aloha_act_publisher.cpp b/ocs2_robotic_examples/ocs2_mobile_manipulator_nonros/test/aloha_act_publisher.cpp
new file mode 100644
index 000000000..f6eaf9ad1
--- /dev/null
+++ b/ocs2_robotic_examples/ocs2_mobile_manipulator_nonros/test/aloha_act_publisher.cpp
@@ -0,0 +1,351 @@
+/******************************************************************************
+Copyright (c) 2026, Intel Corporation. All rights reserved.
+******************************************************************************/
+
+// ALOHA ACT target publisher / state reader, modeled on the old
+// franka_control.cpp but using the ITransport abstraction:
+//   * publish   act/target_qpos                    (14 ACT values -> both arm nodes)
+//   * publish   {left,right}_arm/state/gripper      (gripper passthrough -> viewer)
+//   * subscribe {left,right}_arm/state/end_effector (read back EE pose)
+//
+// It closes the loop "publish target -> MPC/MRT -> published EE state" and prints
+// each arm's latest EE pose so convergence to the target FK pose can be checked.
+// stamp is irrelevant (the node uses reception wall-clock, Scheme A).
+//
+// Grippers are NOT part of the MPC state: the arm nodes slice only their 6 arm DOF
+// from the ACT target and ignore the two gripper slots. So the grippers would never
+// reach the MuJoCo viewer through the MPC path. To still visualize gripper motion,
+// this publisher forwards the raw ACT gripper value for each arm straight to the
+// viewer on {prefix}/state/gripper (a JointStateMsg, dof=1). mujoco_viewer.py maps
+// that normalized opening onto the arm's left_finger/right_finger slide joints.
+//
+// Trajectory playback: by default it streams the points in
+// target_trajectories_with_grippers.txt, pacing each point by its abs_point_time_s
+// column. Fall back to a single static qpos with --qpos.
+#include <atomic>
+#include <chrono>
+#include <csignal>
+#include <cstring>
+#include <fstream>
+#include <iostream>
+#include <map>
+#include <mutex>
+#include <sstream>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "ocs2_mobile_manipulator_nonros/ShmTransport.h"
+#include "ocs2_mobile_manipulator_nonros/Topics.h"
+#include "ocs2_mobile_manipulator_nonros/Transport.h"
+
+using namespace ocs2::mobile_manipulator::nonros;
+
+namespace {
+std::atomic_bool g_running{true};
+void signalHandler(int /*signum*/) { g_running.store(false); }
+
+double nowSeconds() {
+  return std::chrono::duration<double>(std::chrono::system_clock::now().time_since_epoch()).count();
+}
+
+// Default ACT target — MUST match aloha_converter_test's sample so its printed FK
+// pose is the expected convergence target:
+//   LEFT  ee_pos = [0.363503, 0.0323929, 0.386514]
+//   RIGHT ee_pos = [0.505871, -0.18613,  0.268637]
+const std::vector<double> kDefaultQpos = {0.10, -0.20, 0.30, -0.40, 0.15, 0.25, 0.5,
+                                          -0.35, 0.45, -0.15, 0.20, -0.10, 0.30, 0.5};
+
+// One playback sample: absolute point time (s) and the 14-value ACT qpos vector
+// [left_arm(6), left_grip, right_arm(6), right_grip].
+struct TrajPoint {
+  double t{0.0};
+  std::vector<double> qpos;  // 14 values
+};
+
+// Parse target_trajectories_with_grippers.txt: a whitespace-separated text table
+// whose first line is the column-name header (22 names). Values are looked up BY
+// HEADER NAME rather than by fixed column index, so the file's column order can
+// change without silently misaligning the fields. Columns consumed:
+//   left_abs_point_time_s                                            -> playback timing
+//   left_{waist,shoulder,elbow,forearm_roll,wrist_angle,wrist_rotate}, left_gripper
+//   right_{waist,shoulder,elbow,forearm_roll,wrist_angle,wrist_rotate}, right_gripper
+// These are remapped into the ACT qpos layout the arm nodes expect:
+//   [ left_arm(6), left_gripper(1), right_arm(6), right_gripper(1) ].
+// Both arms share the same abs_point_time here, so we pace on the left column.
+std::vector<TrajPoint> loadTrajectory(const std::string& path) {
+  // Header names for the six arm joints, in ACT qpos order, per side prefix.
+  static const char* kArmJoints[6] = {"waist", "shoulder", "elbow", "forearm_roll", "wrist_angle", "wrist_rotate"};
+
+  std::vector<TrajPoint> traj;
+  std::ifstream in(path);
+  if (!in) {
+    std::cerr << "[act_publisher] cannot open trajectory file: " << path << "\n";
+    return traj;
+  }
+
+  // First non-empty line is the header. Build a column-name -> index map.
+  std::string line;
+  std::map<std::string, size_t> col;
+  while (std::getline(in, line)) {
+    std::stringstream hs(line);
+    std::string name;
+    size_t idx = 0;
+    while (hs >> name) col[name] = idx++;
+    if (idx > 0) break;  // consumed a real header row
+  }
+
+  // Resolve the columns we need up front; bail if any is missing.
+  auto columnOf = [&](const std::string& name) -> long {
+    auto it = col.find(name);
+    if (it == col.end()) {
+      std::cerr << "[act_publisher] trajectory file missing column '" << name << "'\n";
+      return -1;
+    }
+    return static_cast<long>(it->second);
+  };
+  const long tCol = columnOf("left_abs_point_time_s");
+  const long leftGripCol = columnOf("left_gripper");
+  const long rightGripCol = columnOf("right_gripper");
+  long leftArmCol[6], rightArmCol[6];
+  bool ok = (tCol >= 0 && leftGripCol >= 0 && rightGripCol >= 0);
+  for (int i = 0; i < 6; ++i) {
+    leftArmCol[i] = columnOf(std::string("left_") + kArmJoints[i]);
+    rightArmCol[i] = columnOf(std::string("right_") + kArmJoints[i]);
+    ok = ok && leftArmCol[i] >= 0 && rightArmCol[i] >= 0;
+  }
+  if (!ok) return traj;  // header missing a required column -> give up (static fallback)
+
+  size_t lineNo = 1;  // header already consumed
+  while (std::getline(in, line)) {
+    ++lineNo;
+    if (line.empty()) continue;
+    std::vector<double> cols;
+    std::stringstream ss(line);
+    double v;
+    while (ss >> v) cols.push_back(v);
+    if (cols.size() < col.size()) {
+      std::cerr << "[act_publisher] skipping malformed line " << lineNo << " (" << cols.size()
+                << " values, need " << col.size() << ")\n";
+      continue;
+    }
+    TrajPoint p;
+    p.t = cols[tCol];  // left_abs_point_time_s (== right_abs_point_time_s here)
+    p.qpos.resize(14, 0.0);
+    for (int i = 0; i < 6; ++i) p.qpos[i] = cols[leftArmCol[i]];       // left arm     -> [0..5]
+    p.qpos[6] = cols[leftGripCol];                                     // left gripper -> [6]
+    for (int i = 0; i < 6; ++i) p.qpos[7 + i] = cols[rightArmCol[i]];  // right arm    -> [7..12]
+    p.qpos[13] = cols[rightGripCol];                                   // right gripper-> [13]
+    traj.push_back(std::move(p));
+  }
+  return traj;
+}
+
+struct LatestEe {
+  std::mutex mtx;
+  EndEffectorStateMsg msg{};
+  bool got{false};
+  void set(const EndEffectorStateMsg& m) {
+    std::lock_guard<std::mutex> lock(mtx);
+    msg = m;
+    got = true;
+  }
+  bool snapshot(EndEffectorStateMsg& out) {
+    std::lock_guard<std::mutex> lock(mtx);
+    out = msg;
+    return got;
+  }
+};
+
+void printEe(const std::string& label, LatestEe& latest) {
+  EndEffectorStateMsg m{};
+  if (latest.snapshot(m)) {
+    std::cout << "  " << label << " ee_pos=[" << m.position[0] << ", " << m.position[1] << ", "
+              << m.position[2] << "]  quat_xyzw=[" << m.orientation[0] << ", " << m.orientation[1] << ", "
+              << m.orientation[2] << ", " << m.orientation[3] << "]\n";
+  } else {
+    std::cout << "  " << label << " (no state yet)\n";
+  }
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+  double seconds = 10.0;
+  std::string leftPrefix = "left_arm";
+  std::string rightPrefix = "right_arm";
+  std::string trajPath = "target_trajectories_with_grippers.txt";
+  bool loopTraj = false;
+  std::vector<double> qpos = kDefaultQpos;
+
+  std::vector<double> cliQpos;  // non-empty -> force single static qpos, skip trajectory file
+  for (int i = 1; i < argc; ++i) {
+    const std::string a = argv[i];
+    auto next = [&]() -> std::string {
+      if (i + 1 >= argc) throw std::runtime_error("missing value after " + a);
+      return argv[++i];
+    };
+    if (a == "--seconds") {
+      seconds = std::stod(next());
+    } else if (a == "--left") {
+      leftPrefix = next();
+    } else if (a == "--right") {
+      rightPrefix = next();
+    } else if (a == "--traj" || a == "--csv") {  // --csv kept as a backward-compatible alias
+      trajPath = next();
+    } else if (a == "--loop") {
+      loopTraj = true;
+    } else if (a == "--qpos") {
+      cliQpos.assign(kDefaultQpos.begin(), kDefaultQpos.end());  // force static mode
+    } else {
+      cliQpos.push_back(std::stod(a));  // positional: qpos values (static mode)
+    }
+  }
+  if (!cliQpos.empty()) {
+    qpos = cliQpos;
+  }
+  if (qpos.size() < 13) {
+    std::cerr << "Need at least 13 qpos values (got " << qpos.size() << ")\n";
+    return 1;
+  }
+
+  // Trajectory file playback is the default; a positional/--qpos static target disables it.
+  std::vector<TrajPoint> traj;
+  if (cliQpos.empty()) {
+    traj = loadTrajectory(trajPath);
+    if (traj.empty()) {
+      std::cerr << "[act_publisher] no trajectory loaded from '" << trajPath
+                << "'; falling back to static default qpos.\n";
+    }
+  }
+
+  std::signal(SIGINT, signalHandler);
+  std::signal(SIGTERM, signalHandler);
+
+  // Fan the single ACT target out to both arms' per-consumer blocks: shmringbuf is a
+  // competing-consumer queue, so one shared block would let LEFT/RIGHT steal each
+  // other's frames (see ShmTransport.h). Each block carries the same full 14 values;
+  // each node still slices its arm (LEFT=head(6), RIGHT=segment(7,6)) via the converter.
+  //
+  // persistPublisherBlocks=true: this publisher is short-lived but the MPC nodes and the
+  // MuJoCo viewer that consume its ACT/gripper blocks are long-running. If the publisher
+  // unlinked those blocks on exit, a second `ros2 run` would create fresh segments that
+  // the still-running consumers never reattach to (they keep polling the orphaned old
+  // mapping), so the arms would freeze. Keeping the blocks linked lets a re-run reattach
+  // to the same segment (shm_open is O_CREAT without O_EXCL) and reconnect seamlessly.
+  ShmTransport transport(/*ownPrefix=*/"", /*broadcastPrefixes=*/{leftPrefix, rightPrefix},
+                         /*persistPublisherBlocks=*/true);
+  transport.init();
+
+  auto pub = transport.createPublisher<ActTargetQposMsg>(topics::kActTargetQpos);
+
+  // Gripper passthrough to the viewer, one block per arm. Not a broadcast topic (the
+  // prefix is baked into the block name), so each publisher maps to a single block:
+  // {leftPrefix}_state_gripper / {rightPrefix}_state_gripper.
+  auto pubGripLeft = transport.createPublisher<JointStateMsg>(topics::stateGripper(leftPrefix));
+  auto pubGripRight = transport.createPublisher<JointStateMsg>(topics::stateGripper(rightPrefix));
+
+  // Scene reset signal to the viewer: a monotonically increasing loop index, bumped at
+  // the start of each playback pass. The viewer resets the free-joint box to its keyframe
+  // pose whenever the index changes, so a looping run doesn't accumulate the box's drift.
+  // JointStateMsg reused as the carrier (dof = loop index; positions unused).
+  auto pubReset = transport.createPublisher<JointStateMsg>(topics::kWorldReset);
+  int32_t loopIndex = 0;
+  auto publishReset = [&]() {
+    JointStateMsg r{};
+    r.time = nowSeconds();
+    r.dof = loopIndex++;
+    pubReset->publish(r);
+  };
+
+  LatestEe leftEe, rightEe;
+  auto subLeft = transport.createSubscriber<EndEffectorStateMsg>(
+      topics::stateEndEffector(leftPrefix), [&](const EndEffectorStateMsg& m) { leftEe.set(m); });
+  auto subRight = transport.createSubscriber<EndEffectorStateMsg>(
+      topics::stateEndEffector(rightPrefix), [&](const EndEffectorStateMsg& m) { rightEe.set(m); });
+
+  ActTargetQposMsg target{};
+
+  // Publish one arm's normalized gripper opening as a dof=1 JointStateMsg.
+  auto publishGripper = [&](Publisher<JointStateMsg>* gpub, double opening, double stamp) {
+    JointStateMsg g{};
+    g.time = stamp;
+    g.dof = 1;
+    g.positions[0] = opening;
+    gpub->publish(g);
+  };
+
+  auto publishQpos = [&](const std::vector<double>& q) {
+    target.size = static_cast<int32_t>(std::min<size_t>(q.size(), 16));
+    for (int i = 0; i < target.size; ++i) target.qpos[i] = q[i];
+    target.stamp = nowSeconds();
+    pub->publish(target);
+
+    // ACT layout: qpos[6] = left gripper, qpos[13] = right gripper. Forward each to
+    // its arm's viewer block (0 if a short static qpos omits the slot).
+    const double leftGrip = q.size() > 6 ? q[6] : 0.0;
+    const double rightGrip = q.size() > 13 ? q[13] : 0.0;
+    publishGripper(pubGripLeft.get(), leftGrip, target.stamp);
+    publishGripper(pubGripRight.get(), rightGrip, target.stamp);
+  };
+
+  if (!traj.empty()) {
+    // Trajectory playback: pace each point by its abs_point_time_s, anchored to the
+    // wall clock at the first point. Prints EE state every 0.5 s.
+    std::cout << "[act_publisher] playing " << traj.size() << " trajectory points from '" << trajPath
+              << "' (span " << (traj.back().t - traj.front().t) << "s" << (loopTraj ? ", looping" : "")
+              << "); reading '" << leftPrefix << "' / '" << rightPrefix << "' EE state.\n";
+
+    double lastPrint = -1.0;
+    do {
+      // Signal the viewer to reset the box before each pass. The first pass (index 0)
+      // only syncs the viewer's baseline (box already at its keyframe pose); every
+      // subsequent pass bumps the index and triggers a reset.
+      publishReset();
+      const double wallStart = nowSeconds();
+      const double trajStart = traj.front().t;
+      for (size_t k = 0; k < traj.size() && g_running.load(); ++k) {
+        const double due = wallStart + (traj[k].t - trajStart);
+        double wait = due - nowSeconds();
+        while (wait > 0.0 && g_running.load()) {
+          std::this_thread::sleep_for(std::chrono::duration<double>(std::min(0.02, wait)));  // ≤20 ms slices
+          wait = due - nowSeconds();
+        }
+        publishQpos(traj[k].qpos);
+
+        const double elapsed = nowSeconds() - wallStart;
+        if (elapsed - lastPrint >= 0.5) {
+          lastPrint = elapsed;
+          std::cout << "t=" << elapsed << "s (point " << k << "/" << traj.size() << ")\n";
+          printEe(leftPrefix, leftEe);
+          printEe(rightPrefix, rightEe);
+        }
+      }
+      lastPrint = -1.0;
+    } while (loopTraj && g_running.load());
+  } else {
+    // Static single-target mode (positional/--qpos, or CSV fallback).
+    std::cout << "[act_publisher] publishing static act/target_qpos (size=" << std::min<size_t>(qpos.size(), 16)
+              << ") for " << seconds << "s; reading '" << leftPrefix << "' / '" << rightPrefix
+              << "' EE state.\n";
+
+    const double t0 = nowSeconds();
+    double lastPrint = 0.0;
+    while (g_running.load() && (nowSeconds() - t0) < seconds) {
+      publishQpos(qpos);
+
+      const double elapsed = nowSeconds() - t0;
+      if (elapsed - lastPrint >= 0.5) {
+        lastPrint = elapsed;
+        std::cout << "t=" << elapsed << "s\n";
+        printEe(leftPrefix, leftEe);
+        printEe(rightPrefix, rightEe);
+      }
+      std::this_thread::sleep_for(std::chrono::milliseconds(50));  // 20 Hz
+    }
+  }
+
+  std::cout << "\n[act_publisher] final EE state:\n";
+  printEe(leftPrefix, leftEe);
+  printEe(rightPrefix, rightEe);
+  return 0;
+}
diff --git a/ocs2_robotic_examples/ocs2_mobile_manipulator_nonros/test/aloha_converter_test.cpp b/ocs2_robotic_examples/ocs2_mobile_manipulator_nonros/test/aloha_converter_test.cpp
new file mode 100644
index 000000000..ee7bedfe3
--- /dev/null
+++ b/ocs2_robotic_examples/ocs2_mobile_manipulator_nonros/test/aloha_converter_test.cpp
@@ -0,0 +1,115 @@
+/******************************************************************************
+Copyright (c) 2026, Intel Corporation. All rights reserved.
+******************************************************************************/
+
+// Verification: AlohaReferenceConverter::fromActQpos must
+// produce, element-for-element, the same extended target that the ROS
+// RosReferenceManager::subscribe_act_joint path produces for the same input.
+//
+// The PinocchioInterface is built exactly as MobileManipulatorInterface builds
+// it (createPinocchioInterface(urdf, type, removeJoints)) — NO MPC/CppAD codegen —
+// and handed to both the converter and an inline ROS-equivalent reference. The
+// two extended targets are compared component-wise.
+#include <cmath>
+#include <iostream>
+#include <string>
+#include <vector>
+
+#include <boost/property_tree/info_parser.hpp>
+#include <boost/property_tree/ptree.hpp>
+
+#include <ocs2_core/Types.h>
+#include <ocs2_core/misc/LoadData.h>
+#include <ocs2_mobile_manipulator/FactoryFunctions.h>
+
+#include <pinocchio/algorithm/frames.hpp>
+#include <pinocchio/algorithm/kinematics.hpp>
+
+#include "ocs2_mobile_manipulator_nonros/AlohaReferenceConverter.h"
+
+using namespace ocs2;
+using namespace ocs2::mobile_manipulator;
+using namespace ocs2::mobile_manipulator::nonros;
+
+// Inline copy of the ROS extended-target computation (RosReferenceManager L118-141),
+// used only as the reference oracle for this test.
+static vector_t rosReference(const PinocchioInterface& pin, size_t eeFrameId, const std::string& armSide,
+                             const std::vector<double>& qpos) {
+  const vector_t act = Eigen::Map<const vector_t>(qpos.data(), static_cast<Eigen::Index>(qpos.size()));
+  vector_t armTargetQpos = (armSide == "LEFT") ? vector_t(act.head(6)) : vector_t(act.segment(7, 6));
+
+  const auto& model = pin.getModel();
+  pinocchio::Data data(model);
+  pinocchio::forwardKinematics(model, data, armTargetQpos);
+  pinocchio::updateFramePlacements(model, data);
+
+  const Eigen::Quaterniond quaternion(data.oMf[eeFrameId].rotation());
+  return (vector_t(armTargetQpos.size() + 7) << armTargetQpos, data.oMf[eeFrameId].translation(),
+          quaternion.coeffs())
+      .finished();
+}
+
+int main(int argc, char** argv) {
+  if (argc < 3) {
+    std::cerr << "Usage: " << argv[0] << " <taskFile> <urdfFile>\n";
+    return 2;
+  }
+  const std::string taskFile = argv[1];
+  const std::string urdfFile = argv[2];
+
+  // Replicate MobileManipulatorInterface's pinocchio interface construction.
+  std::vector<std::string> removeJoints;
+  loadData::loadStdVector<std::string>(taskFile, "model_information.removeJoints", removeJoints, false);
+  const ManipulatorModelType type = loadManipulatorType(taskFile, "model_information.manipulatorModelType");
+
+  boost::property_tree::ptree pt;
+  boost::property_tree::read_info(taskFile, pt);
+  const std::string eeFrame = pt.get<std::string>("model_information.eeFrame");
+
+  PinocchioInterface pin = createPinocchioInterface(urdfFile, type, removeJoints);
+  const size_t eeFrameId = pin.getModel().getFrameId(eeFrame);
+  std::cout << "model.nq=" << pin.getModel().nq << " nv=" << pin.getModel().nv
+            << " eeFrame='" << eeFrame << "' id=" << eeFrameId << "\n";
+
+  // Sample ACT qpos: left(6), left_grip(1), right(6), right_grip(1).
+  const std::vector<double> qpos = {0.10, -0.20, 0.30, -0.40, 0.15, 0.25, 0.5,
+                                    -0.35, 0.45, -0.15, 0.20, -0.10, 0.30, 0.5};
+
+  const double tol = 1e-9;
+  bool ok = true;
+  for (const char* side : {"LEFT", "RIGHT"}) {
+    AlohaReferenceConverter converter(pin, eeFrameId, armSideFromString(side));
+    const TargetTrajectories tt = converter.fromActQpos(qpos.data(), static_cast<int>(qpos.size()));
+    const vector_t got = tt.stateTrajectory.front();
+    const vector_t ref = rosReference(pin, eeFrameId, side, qpos);
+
+    double maxErr = 0.0;
+    for (Eigen::Index i = 0; i < ref.size(); ++i) {
+      maxErr = std::max(maxErr, std::abs(got(i) - ref(i)));
+    }
+    const bool sideOk = (got.size() == ref.size()) && (maxErr <= tol);
+    ok = ok && sideOk;
+
+    // Scheme A: time must be wall-clock (epoch seconds), not 0 / message stamp.
+    const double t = tt.timeTrajectory.front();
+    const bool timeOk = t > 1.0e9;
+    ok = ok && timeOk;
+
+    std::cout << (sideOk ? "PASS" : "FAIL") << " [" << side << "] dim=" << got.size()
+              << " maxErr=" << maxErr << " time=" << t << (timeOk ? " (wall-clock)" : " (BAD TIME)")
+              << "\n  ee_pos=[" << got(6) << ", " << got(7) << ", " << got(8) << "]"
+              << " ee_quat_xyzw=[" << got(9) << ", " << got(10) << ", " << got(11) << ", " << got(12)
+              << "]\n";
+
+    // input must be Zero(nv).
+    const vector_t in = tt.inputTrajectory.front();
+    if (in.size() != pin.getModel().nv || in.norm() != 0.0) {
+      std::cout << "FAIL [" << side << "] input not Zero(nv): size=" << in.size() << " norm=" << in.norm()
+                << "\n";
+      ok = false;
+    }
+  }
+
+  std::cout << (ok ? "ALL PASS" : "FAILED") << "\n";
+  return ok ? 0 : 1;
+}
diff --git a/ocs2_robotic_examples/ocs2_mobile_manipulator_nonros/test/shm_fanout_test.cpp b/ocs2_robotic_examples/ocs2_mobile_manipulator_nonros/test/shm_fanout_test.cpp
new file mode 100644
index 000000000..95127c6f9
--- /dev/null
+++ b/ocs2_robotic_examples/ocs2_mobile_manipulator_nonros/test/shm_fanout_test.cpp
@@ -0,0 +1,143 @@
+/******************************************************************************
+Copyright (c) 2026, Intel Corporation. All rights reserved.
+******************************************************************************/
+
+// Broadcast fan-out regression test (guards the shmringbuf competing-consumer fix).
+//
+// shmringbuf's read cursor lives in the shared segment, so two readers of ONE block
+// steal each other's frames. ShmTransport fans a broadcast topic (act/target_qpos)
+// out to per-arm blocks so BOTH arms get every frame. This test asserts:
+//   1. one publish reaches both subscribers exactly once, POD byte-identical;
+//   2. the un-fanned block 'act_target_qpos' is NEVER created (only __<prefix>);
+//   3. bad configuration is rejected (empty / duplicate prefix, missing prefix).
+//
+// OCS2-independent — links libshmringbuf alone, like shm_transport_test.
+#include <unistd.h>
+
+#include <atomic>
+#include <chrono>
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <thread>
+
+#include "ocs2_mobile_manipulator_nonros/ShmTransport.h"
+#include "ocs2_mobile_manipulator_nonros/Topics.h"
+
+using namespace ocs2::mobile_manipulator::nonros;
+
+namespace {
+int g_failures = 0;
+
+void check(bool cond, const std::string& what) {
+  std::cout << (cond ? "  ok  : " : "  FAIL: ") << what << "\n";
+  if (!cond) {
+    ++g_failures;
+  }
+}
+
+bool shmBlockExists(const std::string& block) {
+  return access(("/dev/shm/" + block).c_str(), F_OK) == 0;
+}
+
+ActTargetQposMsg makeSample() {
+  ActTargetQposMsg msg{};
+  msg.stamp = 987.654;
+  msg.size = 14;
+  for (int i = 0; i < 16; ++i) {
+    msg.qpos[i] = 0.25 * i - 1.0;
+  }
+  return msg;
+}
+
+// A subscriber that records how many messages it saw and the last payload.
+struct Sink {
+  std::atomic<int> count{0};
+  ActTargetQposMsg last{};
+  void operator()(const ActTargetQposMsg& m) {
+    last = m;
+    count.fetch_add(1, std::memory_order_release);
+  }
+};
+
+template <class Fn>
+bool throwsInvalidArg(Fn&& fn) {
+  try {
+    fn();
+  } catch (const std::exception&) {
+    return true;
+  }
+  return false;
+}
+}  // namespace
+
+int main() {
+  const std::string leftBlock = "act_target_qpos__left_arm";
+  const std::string rightBlock = "act_target_qpos__right_arm";
+  const std::string unfannedBlock = "act_target_qpos";  // must NOT be created
+
+  // ---- 1. fan-out delivery ----
+  {
+    ShmTransport pubT(/*ownPrefix=*/"", /*broadcastPrefixes=*/{"left_arm", "right_arm"});
+    ShmTransport leftT("left_arm");
+    ShmTransport rightT("right_arm");
+
+    Sink left, right;
+    auto subL = leftT.createSubscriber<ActTargetQposMsg>(topics::kActTargetQpos, std::ref(left));
+    auto subR = rightT.createSubscriber<ActTargetQposMsg>(topics::kActTargetQpos, std::ref(right));
+
+    auto pub = pubT.createPublisher<ActTargetQposMsg>(topics::kActTargetQpos);
+
+    // Let both subscribers open their (lazily retried) blocks before the single publish.
+    std::this_thread::sleep_for(std::chrono::milliseconds(50));
+
+    const ActTargetQposMsg sent = makeSample();
+    pub->publish(sent);  // publish exactly once
+
+    // Wait (bounded) for both to receive.
+    for (int i = 0; i < 500; ++i) {
+      if (left.count.load(std::memory_order_acquire) >= 1 &&
+          right.count.load(std::memory_order_acquire) >= 1) {
+        break;
+      }
+      std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    }
+    // A little longer to catch an (erroneous) second delivery.
+    std::this_thread::sleep_for(std::chrono::milliseconds(50));
+
+    check(left.count.load() == 1, "left arm received exactly once (got " + std::to_string(left.count.load()) + ")");
+    check(right.count.load() == 1, "right arm received exactly once (got " + std::to_string(right.count.load()) + ")");
+    check(std::memcmp(&sent, &left.last, sizeof(ActTargetQposMsg)) == 0, "left payload byte-identical");
+    check(std::memcmp(&sent, &right.last, sizeof(ActTargetQposMsg)) == 0, "right payload byte-identical");
+
+    check(shmBlockExists(leftBlock), "per-arm block '" + leftBlock + "' created");
+    check(shmBlockExists(rightBlock), "per-arm block '" + rightBlock + "' created");
+    check(!shmBlockExists(unfannedBlock), "un-fanned block '" + unfannedBlock + "' NOT created");
+  }
+
+  // ---- 2. bad configuration is rejected ----
+  check(throwsInvalidArg([] { ShmTransport t("", {"left_arm", ""}); }),
+        "empty broadcast prefix rejected");
+  check(throwsInvalidArg([] { ShmTransport t("", {"left_arm", "left_arm"}); }),
+        "duplicate broadcast prefix rejected");
+  check(throwsInvalidArg([] {
+          ShmTransport t;  // no broadcastPrefixes
+          auto p = t.createPublisher<ActTargetQposMsg>(topics::kActTargetQpos);
+          (void)p;
+        }),
+        "publishing broadcast topic without broadcastPrefixes rejected");
+  check(throwsInvalidArg([] {
+          ShmTransport t;  // empty ownPrefix
+          auto s = t.createSubscriber<ActTargetQposMsg>(topics::kActTargetQpos, [](const ActTargetQposMsg&) {});
+          (void)s;
+        }),
+        "subscribing broadcast topic without ownPrefix rejected");
+
+  if (g_failures == 0) {
+    std::cout << "PASS: broadcast fan-out\n";
+    return 0;
+  }
+  std::cout << "FAIL: " << g_failures << " check(s) failed\n";
+  return 1;
+}
diff --git a/ocs2_robotic_examples/ocs2_mobile_manipulator_nonros/test/shm_transport_test.cpp b/ocs2_robotic_examples/ocs2_mobile_manipulator_nonros/test/shm_transport_test.cpp
new file mode 100644
index 000000000..9e6b23eb0
--- /dev/null
+++ b/ocs2_robotic_examples/ocs2_mobile_manipulator_nonros/test/shm_transport_test.cpp
@@ -0,0 +1,112 @@
+/******************************************************************************
+Copyright (c) 2026, Intel Corporation. All rights reserved.
+******************************************************************************/
+
+// Verification: one process publishes, another
+// subscribes, and the POD message must round-trip field-for-field.
+//
+// A child process subscribes; the parent publishes; the child ships the received
+// struct back over a pipe and the parent compares it byte-for-byte. Uses only
+// ShmTransport (no OCS2/pinocchio), so it links against libshmringbuf alone.
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include <atomic>
+#include <chrono>
+#include <cstring>
+#include <iostream>
+#include <thread>
+
+#include "ocs2_mobile_manipulator_nonros/ShmTransport.h"
+
+using namespace ocs2::mobile_manipulator::nonros;
+
+namespace {
+constexpr const char* kTopic = "test/roundtrip";
+
+ActTargetQposMsg makeSample() {
+  ActTargetQposMsg msg{};
+  msg.stamp = 12345.678;
+  msg.size = 14;
+  for (int i = 0; i < 16; ++i) {
+    msg.qpos[i] = 0.1 * i;
+  }
+  return msg;
+}
+
+bool equalMsg(const ActTargetQposMsg& a, const ActTargetQposMsg& b) {
+  return std::memcmp(&a, &b, sizeof(ActTargetQposMsg)) == 0;
+}
+}  // namespace
+
+int main() {
+  const ActTargetQposMsg sent = makeSample();
+
+  int pipefd[2];
+  if (pipe(pipefd) != 0) {
+    std::perror("pipe");
+    return 2;
+  }
+
+  const pid_t pid = fork();
+  if (pid < 0) {
+    std::perror("fork");
+    return 2;
+  }
+
+  if (pid == 0) {
+    // ---- child: subscriber ----
+    close(pipefd[0]);
+    ShmTransport transport;
+    transport.init();
+
+    std::atomic<bool> got{false};
+    ActTargetQposMsg received{};
+    auto sub = transport.createSubscriber<ActTargetQposMsg>(
+        kTopic, [&](const ActTargetQposMsg& m) {
+          received = m;
+          got.store(true, std::memory_order_release);
+        });
+
+    for (int i = 0; i < 5000 && !got.load(std::memory_order_acquire); ++i) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    if (got.load(std::memory_order_acquire)) {
+      ssize_t n = write(pipefd[1], &received, sizeof(received));
+      (void)n;
+    }
+    close(pipefd[1]);
+    _exit(0);
+  }
+
+  // ---- parent: publisher ----
+  close(pipefd[1]);
+  ShmTransport transport;
+  transport.init();
+  auto pub = transport.createPublisher<ActTargetQposMsg>(kTopic);
+
+  // Publish repeatedly so the later-starting subscriber catches it. All payloads
+  // are identical, so ring ordering is irrelevant to the comparison.
+  for (int i = 0; i < 200; ++i) {
+    pub->publish(sent);
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  }
+
+  ActTargetQposMsg received{};
+  const ssize_t n = read(pipefd[0], &received, sizeof(received));
+  close(pipefd[0]);
+  int status = 0;
+  waitpid(pid, &status, 0);
+
+  if (n != static_cast<ssize_t>(sizeof(received))) {
+    std::cerr << "FAIL: subscriber did not receive a message\n";
+    return 1;
+  }
+  if (!equalMsg(sent, received)) {
+    std::cerr << "FAIL: round-trip mismatch\n";
+    return 1;
+  }
+  std::cout << "PASS: POD round-trip (stamp=" << received.stamp << " size=" << received.size
+            << " qpos[13]=" << received.qpos[13] << ")\n";
+  return 0;
+}
