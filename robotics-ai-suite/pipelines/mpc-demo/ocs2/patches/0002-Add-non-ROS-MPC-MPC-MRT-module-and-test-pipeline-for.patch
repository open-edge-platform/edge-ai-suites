index 000000000..9fe157a9b
--- /dev/null
+++ b/ocs2_robotic_examples/ocs2_mobile_manipulator_nonros/aloha_dual_arm_viewer.xml
@@ -0,0 +1,225 @@
+<?xml version="1.0"?>
+<!--
+  Copyright (c) 2026, Intel Corporation. All rights reserved.
+
+  ALOHA dual-arm MuJoCo scene TAILORED for scripts/mujoco_viewer.py (non-ROS demo).
+
+  This is a self-contained rework of MujocoRosUtils/xml/bimanual_viperx_transfer_cube_dual_arm.xml.
+  vs. the reference scene it drops everything the viewer would strip anyway and fixes
+  a gripper-range bug, so what the viewer compiles is exactly what is written here:
+
+    * NO <include>          - both arms + table + box are inlined (the reference pulled
+                              in scene.xml / vx300s_dependencies.xml / vx300s_left|right.xml
+                              from another workspace; here there is no include/cwd dependency).
+    * NO MujocoRosUtils      - the <extension>, the <sensor> PosePublisher plugins, and the
+      plugins                 four <plugin> ActuatorCommand actuators are gone. They only ever
+                              worked inside MuJoCo's ROS `simulate`; pure-Python MuJoCo cannot
+                              load the .so and the viewer strips them regardless.
+    * meshes from THIS        - the 10 vx300s STLs are referenced from the in-workspace
+      workspace                ocs2_robotic_assets package (already a <depend> of this package),
+                              not the ocs2_rebase_ws copy. The viewer's _collect_assets resolves
+                              mesh file= paths relative to THIS file, so the paths are relative
+                              (no <compiler meshdir>, which _collect_assets ignores).
+    * table is a box         - the reference tabletop.stl is a 12-triangle box (1.219 x 0.762 x
+                              0.030 m, top face at z=0); reproduced exactly as a <geom type="box">
+                              so no table mesh is needed.
+    * declutter              - ROS-only calibration sites, camera_focus bodies and the
+                              wrist/front cameras that targeted them are removed; four fixed
+                              overview cameras (targeting the table) are kept for the viewer.
+    * left gripper fix       - the reference gave vx300s_left's finger actuators ctrlrange
+                              0.021..0.057 / -0.057..-0.021, OUTSIDE the finger JOINT range
+                              0.007..0.043 (right arm was already correct). The viewer maps the
+                              normalized gripper opening onto the ACTUATOR ctrlrange, so the left
+                              gripper never fully closed and its "open" fell past the joint stop.
+                              Both arms now use the joint-consistent 0.007..0.043 / -0.043..-0.007.
+
+  Joint / actuator order (drives the keyframe qpos/ctrl and the shm block layout in
+  mujoco_viewer.py):
+    left  arm  : waist shoulder elbow forearm_roll wrist_angle wrist_rotate
+    left  grip : left_finger right_finger
+    right arm  : waist shoulder elbow forearm_roll wrist_angle wrist_rotate
+    right grip : left_finger right_finger
+    box        : free joint (7)
+-->
+<mujoco model="aloha_dual_arm_viewer">
+    <compiler angle="radian" inertiafromgeom="auto" inertiagrouprange="4 5"/>
+
+    <asset>
+        <!-- Meshes come from the in-workspace ocs2_robotic_assets package; paths are
+             relative to THIS file because mujoco_viewer._collect_assets joins them onto
+             the scene dir and ignores <compiler meshdir>. -->
+        <mesh name="vx300s_1_base"          file="../../../frameworks.industrial.motion-control.ocs2-robotic-assets/resources/mobile_manipulator/aloha/meshes/vx300s_meshes/base.stl"           scale="0.001 0.001 0.001"/>
+        <mesh name="vx300s_2_shoulder"      file="../../../frameworks.industrial.motion-control.ocs2-robotic-assets/resources/mobile_manipulator/aloha/meshes/vx300s_meshes/shoulder.stl"       scale="0.001 0.001 0.001"/>
+        <mesh name="vx300s_3_upper_arm"     file="../../../frameworks.industrial.motion-control.ocs2-robotic-assets/resources/mobile_manipulator/aloha/meshes/vx300s_meshes/upper_arm.stl"      scale="0.001 0.001 0.001"/>
+        <mesh name="vx300s_4_upper_forearm" file="../../../frameworks.industrial.motion-control.ocs2-robotic-assets/resources/mobile_manipulator/aloha/meshes/vx300s_meshes/upper_forearm.stl"  scale="0.001 0.001 0.001"/>
+        <mesh name="vx300s_5_lower_forearm" file="../../../frameworks.industrial.motion-control.ocs2-robotic-assets/resources/mobile_manipulator/aloha/meshes/vx300s_meshes/lower_forearm.stl"  scale="0.001 0.001 0.001"/>
+        <mesh name="vx300s_6_wrist"         file="../../../frameworks.industrial.motion-control.ocs2-robotic-assets/resources/mobile_manipulator/aloha/meshes/vx300s_meshes/wrist.stl"          scale="0.001 0.001 0.001"/>
+        <mesh name="vx300s_7_gripper"       file="../../../frameworks.industrial.motion-control.ocs2-robotic-assets/resources/mobile_manipulator/aloha/meshes/vx300s_meshes/gripper.stl"        scale="0.001 0.001 0.001"/>
+        <mesh name="vx300s_8_gripper_prop"  file="../../../frameworks.industrial.motion-control.ocs2-robotic-assets/resources/mobile_manipulator/aloha/meshes/vx300s_meshes/gripper_prop.stl"   scale="0.001 0.001 0.001"/>
+        <mesh name="vx300s_9_gripper_bar"   file="../../../frameworks.industrial.motion-control.ocs2-robotic-assets/resources/mobile_manipulator/aloha/meshes/vx300s_meshes/gripper_bar.stl"    scale="0.001 0.001 0.001"/>
+        <mesh name="vx300s_10_gripper_finger_left"  file="../../../frameworks.industrial.motion-control.ocs2-robotic-assets/resources/mobile_manipulator/aloha/meshes/vx300s_meshes/custom_finger_left.stl"  scale="0.001 0.001 0.001"/>
+        <mesh name="vx300s_10_gripper_finger_right" file="../../../frameworks.industrial.motion-control.ocs2-robotic-assets/resources/mobile_manipulator/aloha/meshes/vx300s_meshes/custom_finger_right.stl" scale="0.001 0.001 0.001"/>
+    </asset>
+
+    <visual>
+        <map fogstart="1.5" fogend="5" force="0.1" znear="0.1"/>
+        <quality shadowsize="4096" offsamples="4"/>
+        <headlight ambient="0.4 0.4 0.4"/>
+    </visual>
+
+    <worldbody>
+        <light castshadow="false" directional="true" diffuse=".3 .3 .3" specular="0.3 0.3 0.3" pos="-1 -1 1" dir="1 1 -1"/>
+        <light directional="true" diffuse=".3 .3 .3" specular="0.3 0.3 0.3" pos="1 -1 1" dir="-1 1 -1"/>
+        <light castshadow="false" directional="true" diffuse=".3 .3 .3" specular="0.3 0.3 0.3" pos="0 1 1" dir="0 -1 -1"/>
+
+        <!-- Fixed overview cameras for the viewer (targeting the table). -->
+        <camera name="left_pillar"  pos="-0.5 0.2 0.6" fovy="78" mode="targetbody" target="table"/>
+        <camera name="right_pillar" pos="0.5 0.2 0.6"  fovy="78" mode="targetbody" target="table"/>
+        <camera name="top"          pos="0 0.6 0.8"    fovy="78" mode="targetbody" target="table"/>
+        <camera name="angle"        pos="0 0 0.6"      fovy="78" mode="targetbody" target="table"/>
+
