+# =============================================================================
+# Copyright (c) 2026, Intel Corporation. All rights reserved.
+# =============================================================================
+cmake_minimum_required(VERSION 3.14.4)
+project(ocs2_mobile_manipulator_nonros LANGUAGES CXX)
+
+# Default to C++17
+if(NOT CMAKE_CXX_STANDARD)
+  set(CMAKE_CXX_STANDARD 17)
+endif()
+
+if(CMAKE_COMPILER_IS_GNUCXX OR CMAKE_CXX_COMPILER_ID MATCHES "Clang")
+  add_compile_options(-Wall -Wextra -Wpedantic -Wno-unused-parameter -Wno-unused-variable
+    -Wno-return-type -Wno-sign-compare -Wno-deprecated-declarations -Wno-reorder)
+endif()
+
+# Generate compile_commands.json for clang tools
+set(CMAKE_EXPORT_COMPILE_COMMANDS ON)
+
+# ---------------------------------------------------------------------------
+# Dependencies (NO rclcpp). Executables are added in later phases together
+# with their sources; this phase only establishes a buildable ament package.
+# ---------------------------------------------------------------------------
+set(dependencies
+  ocs2_core
+  ocs2_ddp
+  ocs2_mpc
+  ocs2_mobile_manipulator
+  ocs2_pinocchio_interface
+  ocs2_robotic_tools
+  ocs2_robotic_assets
+)
+
+find_package(ament_cmake REQUIRED)
+
+# Find third-party deps FIRST so their imported targets (pinocchio::pinocchio,
+# Boost::log, ...) already exist when the OCS2 export files reference them.
+find_package(eigen3_cmake_module REQUIRED)
+find_package(Eigen3 REQUIRED)
+# Components match ocs2_core so its exported imported-targets (Boost::log, ...) resolve.
+find_package(Boost REQUIRED COMPONENTS system filesystem log_setup log)
+find_package(urdfdom REQUIRED)  # FactoryFunctions.h pulls in urdf_parser/urdf_parser.h
+
+find_package(PkgConfig REQUIRED)
+# Distinct prefix: pkg_check_modules(pinocchio ...) would set pinocchio_FOUND and
+# prevent find_package(pinocchio) from creating the pinocchio::pinocchio target.
+pkg_check_modules(PINOCCHIO REQUIRED pinocchio)
+find_package(pinocchio REQUIRED)  # defines the pinocchio::pinocchio imported target
+
+find_package(ocs2_core REQUIRED)
+find_package(ocs2_ddp REQUIRED)
+find_package(ocs2_mpc REQUIRED)
+find_package(ocs2_mobile_manipulator REQUIRED)
+find_package(ocs2_pinocchio_interface REQUIRED)
+find_package(ocs2_robotic_tools REQUIRED)
+find_package(ocs2_robotic_assets REQUIRED)
+
+include_directories(${urdfdom_INCLUDE_DIRS})
+
+# --- shmringbuf (Phase 2) ---
+find_path(
+  PLCOPEN_CMAKE_MODULE_PATH
+  NAMES find_libshm.cmake
+  HINTS ${ROOTDIR}/usr/include ${ROOTDIR}/usr/local/include
+)
+if(NOT PLCOPEN_CMAKE_MODULE_PATH)
+  message(FATAL_ERROR "find_libshm.cmake not found; install libshmringbuf-dev plcopen-databus-dev")
+endif()
+message(STATUS "PLCOPEN_CMAKE_MODULE_PATH: ${PLCOPEN_CMAKE_MODULE_PATH}")
+include(${PLCOPEN_CMAKE_MODULE_PATH}/find_libshm.cmake)
+include_directories(${LIBSHM_INCLUDE_DIRS})
+
+###########
+## Build ##
+###########
+
+# Compile flags for OCS2/pinocchio targets (mirrors ocs2_mobile_manipulator).
+set(FLAGS
+  ${OCS2_CXX_FLAGS}
+  ${PINOCCHIO_CFLAGS_OTHER}
+  -Wno-ignored-attributes
+  -Wno-invalid-partial-specialization
+  -DPINOCCHIO_URDFDOM_TYPEDEF_SHARED_PTR
+  -DPINOCCHIO_URDFDOM_USE_STD_SHARED_PTR
+)
+link_directories(${PINOCCHIO_LIBRARY_DIRS})
+
+# ocs2_self_collision.a (static, pulled in transitively by ocs2_mobile_manipulator) references
+# tinyxml2 symbols, but the workspace does not export tinyxml2 — so a plain `tinyxml2` link item
+# lands before the archive (direct-before-transitive) and the symbol goes unresolved. Wrap the
+# whole library section in --start-group/--end-group so the linker rescans regardless of order.
+set(CMAKE_CXX_LINK_EXECUTABLE
+  "<CMAKE_CXX_COMPILER> <FLAGS> <CMAKE_CXX_LINK_FLAGS> <LINK_FLAGS> <OBJECTS> -o <TARGET> -Wl,--start-group <LINK_LIBRARIES> -Wl,--end-group")
+
+# ShmTransport is intentionally OCS2-independent (raw POD over shmringbuf), so
+# the transport round-trip test links against libshmringbuf alone.
+add_executable(shm_transport_test
+  test/shm_transport_test.cpp
+  src/ShmTransport.cpp
+)
+target_include_directories(shm_transport_test
+  PRIVATE
+    "$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>"
+    ${LIBSHM_INCLUDE_DIRS}
+)
+target_link_libraries(shm_transport_test ${LIBSHM_LIBRARIES} pthread)
+
+# Broadcast fan-out regression test (competing-consumer fix). Also OCS2-independent.
+add_executable(shm_fanout_test
+  test/shm_fanout_test.cpp
+  src/ShmTransport.cpp
+)
+target_include_directories(shm_fanout_test
+  PRIVATE
+    "$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>"
+    ${LIBSHM_INCLUDE_DIRS}
+)
+target_link_libraries(shm_fanout_test ${LIBSHM_LIBRARIES} pthread)
+
+# AlohaReferenceConverter FK check (Phase 3). Links the OCS2 manipulator stack;
+# no shmringbuf.
+add_executable(aloha_converter_test
+  test/aloha_converter_test.cpp
+  src/AlohaReferenceConverter.cpp
+)
+target_include_directories(aloha_converter_test
+  PRIVATE "$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>"
+)
+target_compile_options(aloha_converter_test PUBLIC ${FLAGS})
+# Link pinocchio explicitly (as ocs2_mobile_manipulator does) so the imported
+# target is used rather than the bare "pinocchio::pinocchio" string from exports.
+target_link_libraries(aloha_converter_test pinocchio::pinocchio)
+ament_target_dependencies(aloha_converter_test ${dependencies})
+
+# MPC/MRT node (Phase 4): OCS2 stack + shmringbuf transport.
+add_executable(mobile_manipulator_mpc_mrt_node
+  src/MobileManipulatorMpcMrtNode.cpp
+  src/ShmTransport.cpp
+  src/AlohaReferenceConverter.cpp
+)
+target_include_directories(mobile_manipulator_mpc_mrt_node
+  PRIVATE
+    "$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>"
+    ${LIBSHM_INCLUDE_DIRS}
+)
+target_compile_options(mobile_manipulator_mpc_mrt_node PUBLIC ${FLAGS})
+target_link_libraries(mobile_manipulator_mpc_mrt_node pinocchio::pinocchio ${LIBSHM_LIBRARIES} tinyxml2 pthread)
+ament_target_dependencies(mobile_manipulator_mpc_mrt_node ${dependencies})
+
+# ACT target publisher / state reader (Phase 7). OCS2-independent, like shm_transport_test.
+add_executable(aloha_act_publisher
+  test/aloha_act_publisher.cpp
+  src/ShmTransport.cpp
+)
+target_include_directories(aloha_act_publisher
+  PRIVATE
+    "$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/include>"
+    ${LIBSHM_INCLUDE_DIRS}
+)
+target_link_libraries(aloha_act_publisher ${LIBSHM_LIBRARIES} pthread)
+
+# NOTE (deferred to later phases):
+#   * option(WITH_MSGCHAN OFF) msgchan reserved path in Phase 5.
+
+#############
+## Install ##
+#############
+
+install(
+  DIRECTORY include/
+  DESTINATION include
+)
+
+install(
+  TARGETS mobile_manipulator_mpc_mrt_node aloha_act_publisher shm_transport_test shm_fanout_test aloha_converter_test
+  DESTINATION lib/${PROJECT_NAME}
+)
+
+# run_aloha_dual_arm.sh must keep its executable bit and land next to the node
+# (lib/${PROJECT_NAME}) so it can find the binary alongside it => install(PROGRAMS).
+install(
+  PROGRAMS scripts/run_aloha_dual_arm.sh
+  DESTINATION lib/${PROJECT_NAME}
+)
+
+# launch file + the MuJoCo viewer / README (Phase 7) — plain data. The runnable
+# .sh is excluded here since it is installed (executable) under lib/ above.
+install(
+  DIRECTORY launch scripts
+  DESTINATION share/${PROJECT_NAME}
+  PATTERN "run_aloha_dual_arm.sh" EXCLUDE
+)
+
+ament_export_dependencies(${dependencies})
+ament_package()
