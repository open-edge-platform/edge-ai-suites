+/******************************************************************************
+Copyright (c) 2026, Intel Corporation. All rights reserved.
+******************************************************************************/
+
+#pragma once
+
+#include <string>
+
+// Logical topic names shared by ShmTransport (this phase) and the reserved
+// MsgchanTransport. The business layer only ever uses these logical strings;
+// ShmTransport maps them to legal shm block names (see ShmTransport::toBlockName,
+// '/' -> '_'). Keeping the names identical across transports is what makes the
+// msgchan migration a "swap the transport" change.
+namespace ocs2 {
+namespace mobile_manipulator {
+namespace nonros {
+namespace topics {
+
+// --- Subscribed target (ACT). Global, NO prefix; shared by both arms, each
+//     arm slices by armSide (LEFT=head(6), RIGHT=segment(7,6)). Main path.
+//     This logical topic is global for both transports. Under msgchan it is a real
+//     broadcast; ShmTransport, whose ring is a competing-consumer queue, fans it out
+//     to per-arm blocks internally (ShmTransport::isBroadcastTopic) — the business
+//     layer stays unaware. ---
+inline const std::string kActTargetQpos = "act/target_qpos";
+
+// --- Scene reset signal (viewer only). Global, NO prefix. A looping publisher bumps
+//     a monotonically increasing loop index on this block at the start of each playback
+//     pass; mujoco_viewer.py resets the free-joint tabletop box to its keyframe pose
+//     whenever the index changes, so a `--loop` run starts every pass from a clean
+//     scene instead of accumulating the box's physical drift. Carried as a JointStateMsg
+//     with dof = loop index (positions unused). ---
+inline const std::string kWorldReset = "world/reset";
+
+// --- Published state. {prefix} in {left_arm,right_arm}, chosen by --armSide. ---
+inline std::string stateEndEffector(const std::string& prefix) { return prefix + "/state/end_effector"; }
+inline std::string stateJoint(const std::string& prefix) { return prefix + "/state/joint"; }
+inline std::string stateBase(const std::string& prefix) { return prefix + "/state/base"; }
+
+// --- Gripper passthrough. The grippers are NOT part of the MPC state (the arm nodes
+//     ignore the gripper slots of the ACT target), so the publisher forwards the raw
+//     ACT gripper value straight to the visualizer on its own per-arm block. Carried as
+//     a JointStateMsg with dof=1 (positions[0] = normalized gripper opening, ~[0,1]). ---
+inline std::string stateGripper(const std::string& prefix) { return prefix + "/state/gripper"; }
+
+// --- Reserved (declared now, not implemented this phase). ---
+inline std::string targetJointCommand(const std::string& prefix) { return prefix + "/target/joint_command"; }
+inline std::string targetJointTrajectory(const std::string& prefix) { return prefix + "/target/joint_trajectory"; }
+
+}  // namespace topics
+}  // namespace nonros
+}  // namespace mobile_manipulator
+}  // namespace ocs2
