@@ -0,0 +1,195 @@
+#!/usr/bin/env bash
+# =============================================================================
+# Copyright (c) 2026, Intel Corporation. All rights reserved.
+# =============================================================================
+# =============================================================================
+# run_aloha_dual_arm.sh — pure-shell launcher for the ALOHA dual-arm nonros
+# MPC/MRT demo (two single-arm processes over shared memory, no ros2launch).
+#
+# Three stages:
+#   1. Pre-generate CppAD codegen: run ONE warm-up process, watch its stdout for
+#      "Initial policy has been received." then SIGTERM it (the node does NOT
+#      self-exit — after that line it enters the MPC/MRT loops). Confirms the
+#      shared libFolder holds the generated .so before two processes race on it.
+#   2. Use a TEMPORARY COPY of task.info with `recompileLibraries false`. The
+#      source config/aloha/task.info ships `true`; editing it in place risks a
+#      polluted workspace on Ctrl-C, so we never touch it.
+#   3. Launch LEFT (--prefix left_arm) + RIGHT (--prefix right_arm) together and
+#      reap both on SIGINT/SIGTERM/EXIT; the temp taskFile is removed on exit.
+#
+# Resource paths auto-resolve from the script's install location and
+# AMENT_PREFIX_PATH; override any of them via the env vars below.
+#
+# Env overrides:
+#   NODE_BIN         path to mobile_manipulator_mpc_mrt_node
+#   TASK_FILE        single-arm ALOHA task.info (manipulatorModelType 0, 6-DOF)
+#   URDF_FILE        vx300s.urdf
+#   LIB_FOLDER       CppAD auto_generated folder (shared by both arms)
+#   WARMUP_TIMEOUT   seconds to wait for the warm-up policy (default 180)
+#   SEPARATE_LIBS    1 => isolate arms with <LIB_FOLDER>_{left,right} and
+#                    pre-generate each sequentially (alternative to shared+false)
+# =============================================================================
+set -euo pipefail
+
+# --- locate this script (resolve symlinks) -----------------------------------
+SOURCE="${BASH_SOURCE[0]}"
+while [ -h "$SOURCE" ]; do
+  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
+  SOURCE="$(readlink "$SOURCE")"
+  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
+done
+SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
+
+# --- resource discovery ------------------------------------------------------
+# Search: explicit env override -> alongside the script -> AMENT_PREFIX_PATH
+# entries -> workspace install root siblings (isolated-install layout).
+find_first() {
+  # $1 = suffix relative to a package prefix (e.g. share/pkg/... or lib/pkg/bin)
+  local suffix="$1" cand
+  # AMENT_PREFIX_PATH entries (colon separated); set by sourcing install/setup.bash
+  local IFS=:
+  for p in ${AMENT_PREFIX_PATH:-}; do
+    cand="$p/$suffix"
+    [ -e "$cand" ] && { echo "$cand"; return 0; }
+  done
+  # workspace install root: SCRIPT_DIR = <install>/<pkg>/lib/<pkg> when installed
+  local ws_install
+  ws_install="$(cd "$SCRIPT_DIR/../../.." >/dev/null 2>&1 && pwd || true)"
+  if [ -n "$ws_install" ]; then
+    for cand in "$ws_install"/*/"$suffix"; do
+      [ -e "$cand" ] && { echo "$cand"; return 0; }
+    done
+  fi
+  return 1
+}
+
+NODE_BIN="${NODE_BIN:-}"
+if [ -z "$NODE_BIN" ]; then
+  # The node is installed next to this script in lib/<pkg>/.
+  if [ -x "$SCRIPT_DIR/mobile_manipulator_mpc_mrt_node" ]; then
+    NODE_BIN="$SCRIPT_DIR/mobile_manipulator_mpc_mrt_node"
+  else
+    NODE_BIN="$(find_first lib/ocs2_mobile_manipulator_nonros/mobile_manipulator_mpc_mrt_node || true)"
+  fi
+fi
+TASK_FILE="${TASK_FILE:-$(find_first share/ocs2_mobile_manipulator/config/aloha/task.info || true)}"
+URDF_FILE="${URDF_FILE:-$(find_first share/ocs2_robotic_assets/resources/mobile_manipulator/aloha/urdf/vx300s.urdf || true)}"
+LIB_FOLDER="${LIB_FOLDER:-$(find_first share/ocs2_mobile_manipulator/auto_generated/aloha_dual_arm || true)}"
+WARMUP_TIMEOUT="${WARMUP_TIMEOUT:-180}"
+SEPARATE_LIBS="${SEPARATE_LIBS:-0}"
+# Codegen-complete marker; must match _CODEGEN_MARKER in the launch file so pregen=auto
+# / pregen=never there can trust a folder this script populated.
+CODEGEN_MARKER=".ocs2_nonros_codegen_complete"
+
+die() { echo "[run] ERROR: $*" >&2; exit 1; }
+[ -n "$NODE_BIN" ]  && [ -x "$NODE_BIN" ]  || die "node binary not found (set NODE_BIN); tried '$NODE_BIN'"
+[ -n "$TASK_FILE" ] && [ -f "$TASK_FILE" ] || die "task.info not found (set TASK_FILE); tried '$TASK_FILE'"
+[ -n "$URDF_FILE" ] && [ -f "$URDF_FILE" ] || die "vx300s.urdf not found (set URDF_FILE); tried '$URDF_FILE'"
+[ -n "$LIB_FOLDER" ] || die "libFolder not resolved (set LIB_FOLDER)"
+
+echo "[run] node   : $NODE_BIN"
+echo "[run] task   : $TASK_FILE"
+echo "[run] urdf   : $URDF_FILE"
+echo "[run] libDir : $LIB_FOLDER"
+
+# --- cleanup / signal handling ----------------------------------------------
+LEFT_PID=""
+RIGHT_PID=""
+TASK_FILE_RUN=""
+cleanup() {
+  trap - INT TERM EXIT
+  echo "[run] shutting down..."
+  for pid in "$LEFT_PID" "$RIGHT_PID"; do
+    [ -n "$pid" ] && kill -TERM "$pid" 2>/dev/null || true
+  done
+  wait 2>/dev/null || true
+  [ -n "$TASK_FILE_RUN" ] && rm -f "$TASK_FILE_RUN"
+}
+trap cleanup INT TERM EXIT
+
+# --- stage 1: pre-generate codegen for one arm, then stop it -----------------
+# Runs a warm-up process, waits for the "Initial policy" line on stdout, sends
+# SIGTERM (the node keeps running otherwise), and checks a .so appeared.
+pregenerate() {
+  local armSide="$1" prefix="$2" libFolder="$3" taskFile="$4"
+  local logfile pid waited
+  mkdir -p "$libFolder"
+  logfile="$(mktemp)"
+  echo "[run] pre-generating codegen ($armSide -> $libFolder) ..."
+  "$NODE_BIN" "$taskFile" "$libFolder" "$URDF_FILE" \
+      --armSide "$armSide" --prefix "$prefix" --subscribeMode act >"$logfile" 2>&1 &
+  pid=$!
+  waited=0
+  while kill -0 "$pid" 2>/dev/null; do
+    if grep -q "Initial policy has been received." "$logfile"; then
+      echo "[run] codegen ready; stopping warm-up (pid=$pid)"
+      kill -TERM "$pid" 2>/dev/null || true
+      wait "$pid" 2>/dev/null || true
+      break
+    fi
+    sleep 0.5
+    waited=$((waited + 1))
+    if [ "$waited" -ge "$((WARMUP_TIMEOUT * 2))" ]; then
+      echo "[run] --- warm-up log ---" >&2; cat "$logfile" >&2
+      kill -TERM "$pid" 2>/dev/null || true; wait "$pid" 2>/dev/null || true
+      rm -f "$logfile"
+      die "warm-up timed out after ${WARMUP_TIMEOUT}s"
+    fi
+  done
+  # process may have exited on its own (e.g. build error) before the line
+  if ! grep -q "Initial policy has been received." "$logfile"; then
+    echo "[run] --- warm-up log ---" >&2; cat "$logfile" >&2
+    rm -f "$logfile"
+    die "warm-up process ended before initial policy was received"
+  fi
+  rm -f "$logfile"
+  if ! find "$libFolder" -name '*.so' -print -quit | grep -q .; then
+    die "no .so found under $libFolder after warm-up"
+  fi
+  # Write the codegen-complete marker (shared with the launch file's pregen=auto/never
+  # so it can trust this folder without re-running a warm-up). Atomic: temp + mv.
+  local marker_tmp
+  marker_tmp="$(mktemp "$libFolder/.marker.XXXXXX")"
+  mv -f "$marker_tmp" "$libFolder/$CODEGEN_MARKER"
+  echo "[run] codegen .so present under $libFolder (marker written)"
+}
+
+# --- task.info temp copy with recompileLibraries false -----------------------
+make_norecompile_taskfile() {
+  local src="$1" dst
+  dst="$(mktemp --suffix=.info)"
+  # only rewrite the standalone `recompileLibraries true` -> `false`
+  sed -E 's/^([[:space:]]*recompileLibraries[[:space:]]+)true/\1false/' "$src" >"$dst"
+  grep -Eq '^[[:space:]]*recompileLibraries[[:space:]]+false' "$dst" \
+    || die "failed to set recompileLibraries false in temp taskFile"
+  echo "$dst"
+}
+
+if [ "$SEPARATE_LIBS" = "1" ]; then
+  # Alternative: isolate each arm's codegen dir (no shared-folder race). We still
+  # pre-generate sequentially to avoid two simultaneous codegens (OOM). Each arm
+  # then runs with recompileLibraries false against its own populated folder.
+  LIB_LEFT="${LIB_FOLDER}_left"
+  LIB_RIGHT="${LIB_FOLDER}_right"
+  pregenerate LEFT  left_arm  "$LIB_LEFT"  "$TASK_FILE"
+  pregenerate RIGHT right_arm "$LIB_RIGHT" "$TASK_FILE"
+  TASK_FILE_RUN="$(make_norecompile_taskfile "$TASK_FILE")"
+  echo "[run] launching LEFT + RIGHT (separate libFolders) ..."
+  "$NODE_BIN" "$TASK_FILE_RUN" "$LIB_LEFT"  "$URDF_FILE" --armSide LEFT  --prefix left_arm  --subscribeMode act &
+  LEFT_PID=$!
+  "$NODE_BIN" "$TASK_FILE_RUN" "$LIB_RIGHT" "$URDF_FILE" --armSide RIGHT --prefix right_arm --subscribeMode act &
+  RIGHT_PID=$!
+else
+  # Default: shared libFolder. Pre-generate once (LEFT), then run both with a
+  # no-recompile temp taskFile so neither process re-triggers codegen.
+  pregenerate LEFT left_arm "$LIB_FOLDER" "$TASK_FILE"
+  TASK_FILE_RUN="$(make_norecompile_taskfile "$TASK_FILE")"
+  echo "[run] launching LEFT + RIGHT (shared libFolder) ..."
+  "$NODE_BIN" "$TASK_FILE_RUN" "$LIB_FOLDER" "$URDF_FILE" --armSide LEFT  --prefix left_arm  --subscribeMode act &
+  LEFT_PID=$!
+  "$NODE_BIN" "$TASK_FILE_RUN" "$LIB_FOLDER" "$URDF_FILE" --armSide RIGHT --prefix right_arm --subscribeMode act &
+  RIGHT_PID=$!
+fi
+
+echo "[run] LEFT pid=$LEFT_PID  RIGHT pid=$RIGHT_PID  (Ctrl-C to stop both)"
+wait
