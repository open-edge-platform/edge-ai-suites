@@ -0,0 +1,60 @@
+/******************************************************************************
+Copyright (c) 2026, Intel Corporation. All rights reserved.
+******************************************************************************/
+
+#pragma once
+
+#include <string>
+
+#include <ocs2_core/Types.h>
+#include <ocs2_core/reference/TargetTrajectories.h>
+#include <ocs2_pinocchio_interface/PinocchioInterface.h>
+
+// Pure (no ROS, no IPC) reference converter for the ALOHA arms. It turns a raw
+// ACT target qpos vector into an OCS2 TargetTrajectories via forward kinematics.
+//
+// The FK logic is lifted verbatim from RosReferenceManager::subscribe_act_joint
+// (ocs2_ros_interfaces/.../RosReferenceManager.cpp L118-152), with rclcpp and
+// ros_msg_conversions stripped out. The converter never touches the transport:
+// its input is a plain double* (decoded from the POD ActTargetQposMsg by
+// ShmTransport) and its output is an OCS2 TargetTrajectories. On msgchan
+// migration only "who decodes the double*" changes; this class does not.
+namespace ocs2 {
+namespace mobile_manipulator {
+namespace nonros {
+
+enum class ArmSide { LEFT, RIGHT };
+
+// Parse "LEFT"/"RIGHT" (case-sensitive, matching the ROS armSide param).
+// Throws std::invalid_argument on anything else.
+ArmSide armSideFromString(const std::string& side);
+
+class AlohaReferenceConverter {
+ public:
+  // pinocchioInterface: a copy from MobileManipulatorInterface::getPinocchioInterface().
+  // eeFrameId: model.getFrameId(eeFrame) for this arm.
+  AlohaReferenceConverter(PinocchioInterface pinocchioInterface, size_t eeFrameId, ArmSide armSide);
+
+  // ACT main path. qpos layout (14 values, optional trailing stamp):
+  //   [ left_arm(6), left_gripper(1), right_arm(6), right_gripper(1) ].
+  // Slices this arm's 6 DOF (LEFT=head(6), RIGHT=segment(7,6)), runs FK, and returns
+  // an extended target [ joints(6), ee_pos(3), ee_quat(4, xyzw) ] stamped at the
+  // reception wall-clock time (Scheme A — not the message stamp). input = Zero(nv).
+  // Throws std::invalid_argument if n is too small for the selected arm.
+  TargetTrajectories fromActQpos(const double* qpos, int n) const;
+
+  // ---- Reserved (declared, not implemented this phase) ----
+  // TargetTrajectories fromJointCommand(const double* joints, int n) const;             // single point, extended
+  // TargetTrajectories fromEndEffectorJointCommand(const double* joints, int n) const;  // legacy 7D EE-only
+  // TargetTrajectories fromJointTrajectory(...) const;                                   // multi-point + merge
+  // TargetTrajectories fromEndEffectorTrajectory(...) const;
+
+ private:
+  PinocchioInterface pinocchioInterface_;
+  size_t eeFrameId_;
+  ArmSide armSide_;
+};
+
+}  // namespace nonros
+}  // namespace mobile_manipulator
+}  // namespace ocs2
