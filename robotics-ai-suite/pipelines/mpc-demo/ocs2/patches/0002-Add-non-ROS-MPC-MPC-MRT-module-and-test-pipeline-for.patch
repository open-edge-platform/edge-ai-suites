@@ -0,0 +1,320 @@
+/******************************************************************************
+Copyright (c) 2026, Intel Corporation. All rights reserved.
+******************************************************************************/
+
+// Non-ROS ALOHA single-arm MPC/MRT node (one process per arm; run two for dual-arm).
+//
+// Skeleton ported from ~/non-ros-ocs2/.../MobileManipulatorMpcMrtNode.cpp, with the
+// direct shm_blkbuf_* calls replaced by the ITransport abstraction:
+//   * subscribe  act/target_qpos          -> AlohaReferenceConverter -> setTargetTrajectories
+//   * publish    {prefix}/state/end_effector,joint,base   (MRT thread)
+//
+// Time base is Scheme A: initObservation.time and every target stamp use the
+// reception wall-clock so the target never looks "expired" to the MPC.
+#include <pthread.h>
+
+#include <atomic>
+#include <chrono>
+#include <csignal>
+#include <iostream>
+#include <string>
+#include <thread>
+
+#include <ocs2_core/thread_support/ExecuteAndSleep.h>
+#include <ocs2_core/thread_support/SetThreadPriority.h>
+#include <ocs2_ddp/GaussNewtonDDP_MPC.h>
+#include <ocs2_mpc/MPC_MRT_Interface.h>
+#include <ocs2_mobile_manipulator/AccessHelperFunctions.h>
+#include <ocs2_mobile_manipulator/MobileManipulatorInterface.h>
+
+#include <ocs2_pinocchio_interface/PinocchioInterface.h>
+#include <pinocchio/algorithm/frames.hpp>
+#include <pinocchio/algorithm/kinematics.hpp>
+
+#include "ocs2_mobile_manipulator_nonros/AlohaReferenceConverter.h"
+#include "ocs2_mobile_manipulator_nonros/ShmTransport.h"
+#include "ocs2_mobile_manipulator_nonros/Topics.h"
+#include "ocs2_mobile_manipulator_nonros/Transport.h"
+
+using namespace ocs2;
+using namespace ocs2::mobile_manipulator;
+using namespace ocs2::mobile_manipulator::nonros;
+
+namespace {
+
+std::atomic_bool g_running{true};
+void signalHandler(int /*signum*/) { g_running.store(false); }
+
+double nowSeconds() {
+  return std::chrono::duration<double>(std::chrono::system_clock::now().time_since_epoch()).count();
+}
+
+// End-effector pose via forward kinematics on the given state.
+pinocchio::SE3 getEndEffectorPose(const MobileManipulatorInterface& interface, const vector_t& state,
+                                  const std::string& eeFrameName) {
+  const auto& pin = interface.getPinocchioInterface();
+  const auto& model = pin.getModel();
+  auto& data = const_cast<pinocchio::Data&>(pin.getData());
+  pinocchio::forwardKinematics(model, data, state);
+  pinocchio::updateFramePlacements(model, data);
+  return data.oMf[model.getFrameId(eeFrameName)];
+}
+
+// Extract arm joint positions/velocities (+ base for wheel-based; zero for ALOHA).
+void getJointInfo(const MobileManipulatorInterface& interface, const vector_t& state, const vector_t& input,
+                  std::vector<double>& jointPositions, std::vector<double>& jointVelocities,
+                  std::vector<double>& baseState) {
+  const auto& info = interface.getManipulatorModelInfo();
+  const int armDim = static_cast<int>(info.armDim);
+  jointPositions.assign(armDim, 0.0);
+  jointVelocities.assign(armDim, 0.0);
+  baseState.assign(3, 0.0);
+
+  if (info.manipulatorModelType == ManipulatorModelType::WheelBasedMobileManipulator) {
+    baseState[0] = state(0);
+    baseState[1] = state(1);
+    baseState[2] = state(2);
+  }
+
+  const auto armAngles = getArmJointAngles(state, info);
+  for (int i = 0; i < armDim; ++i) {
+    jointPositions[i] = static_cast<double>(armAngles(i));
+  }
+  if (input.size() >= armDim) {
+    const auto armVel = input.tail(armDim);
+    for (int i = 0; i < armDim; ++i) {
+      jointVelocities[i] = static_cast<double>(armVel(i));
+    }
+  }
+}
+
+vector_t mpcTrackingController(const SystemObservation& currentObservation, MPC_MRT_Interface& mpcMrtInterface) {
+  mpcMrtInterface.setCurrentObservation(currentObservation);
+  if (mpcMrtInterface.updatePolicy()) {
+    std::cout << "<<< New MPC policy received at " << currentObservation.time << std::endl;
+  }
+  vector_t optimizedState;
+  vector_t optimizedInput;
+  size_t plannedMode;
+  mpcMrtInterface.evaluatePolicy(currentObservation.time, currentObservation.state, optimizedState,
+                                 optimizedInput, plannedMode);
+  return optimizedInput;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  if (argc < 4) {
+    std::cerr << "Usage: " << argv[0]
+              << " <taskFile> <libraryFolder> <urdfFile> [--armSide LEFT|RIGHT] [--prefix <name>] "
+                 "[--subscribeMode act]\n";
+    return 1;
+  }
+  const std::string taskFile = argv[1];
+  const std::string libraryFolder = argv[2];
+  const std::string urdfFile = argv[3];
+
+  std::string armSideStr = "LEFT";
+  std::string prefix;
+  std::string subscribeMode = "act";
+  for (int i = 4; i < argc; ++i) {
+    const std::string a = argv[i];
+    auto next = [&]() -> std::string {
+      if (i + 1 >= argc) {
+        throw std::runtime_error("missing value after " + a);
+      }
+      return argv[++i];
+    };
+    if (a == "--armSide") {
+      armSideStr = next();
+    } else if (a == "--prefix") {
+      prefix = next();
+    } else if (a == "--subscribeMode") {
+      subscribeMode = next();
+    } else {
+      std::cerr << "Unknown argument: " << a << "\n";
+      return 1;
+    }
+  }
+  if (subscribeMode != "act") {
+    std::cerr << "subscribeMode '" << subscribeMode << "' is reserved; only 'act' is implemented.\n";
+    return 1;
+  }
+  const ArmSide armSide = armSideFromString(armSideStr);
+  if (prefix.empty()) {
+    prefix = (armSide == ArmSide::LEFT) ? "left_arm" : "right_arm";
+  }
+  std::cout << "[nonros] armSide=" << armSideStr << " prefix=" << prefix << " subscribeMode=" << subscribeMode
+            << "\n";
+
+  std::signal(SIGINT, signalHandler);
+  std::signal(SIGTERM, signalHandler);
+
+  // --- Robot interface / MPC (unchanged from the reference skeleton) ---
+  MobileManipulatorInterface manipulatorInterface(taskFile, libraryFolder, urdfFile);
+  const auto& info = manipulatorInterface.getManipulatorModelInfo();
+  const std::string eeFrame = info.eeFrame;
+
+  GaussNewtonDDP_MPC mpc(manipulatorInterface.mpcSettings(), manipulatorInterface.ddpSettings(),
+                         manipulatorInterface.getRollout(), manipulatorInterface.getOptimalControlProblem(),
+                         manipulatorInterface.getInitializer());
+  mpc.getSolverPtr()->setReferenceManager(manipulatorInterface.getReferenceManagerPtr());
+
+  MPC_MRT_Interface mpcMrtInterface(mpc);
+  mpcMrtInterface.initRollout(&manipulatorInterface.getRollout());
+
+  // --- IPC layer (ITransport). Converter and interface must outlive the transport, so the
+  //     transport is declared last => destroyed first (its dtor joins the receiver thread). ---
+  AlohaReferenceConverter converter(manipulatorInterface.getPinocchioInterface(),
+                                    static_cast<size_t>(manipulatorInterface.getEeFrameId()), armSide);
+  // ownPrefix lets ShmTransport pick this arm's per-consumer block for the broadcast
+  // ACT target (shmringbuf can't broadcast; see ShmTransport.h). State topics already
+  // carry the prefix in their name, so they are unaffected.
+  ShmTransport transport(prefix);
+  transport.init();
+
+  auto pubEe = transport.createPublisher<EndEffectorStateMsg>(topics::stateEndEffector(prefix));
+  auto pubJoint = transport.createPublisher<JointStateMsg>(topics::stateJoint(prefix));
+  auto pubBase = transport.createPublisher<BaseStateMsg>(topics::stateBase(prefix));
+
+  // ACT target subscription. Buffered semantics: the callback only calls setTargetTrajectories
+  // (swapped in on the next preSolverRun); it never touches the active target or updateFromBuffer.
+  auto subTarget = transport.createSubscriber<ActTargetQposMsg>(
+      topics::kActTargetQpos, [&converter, &mpcMrtInterface](const ActTargetQposMsg& msg) {
+        try {
+          TargetTrajectories tt = converter.fromActQpos(msg.qpos, msg.size);
+          mpcMrtInterface.getReferenceManager().setTargetTrajectories(std::move(tt));
+        } catch (const std::exception& e) {
+          std::cerr << "[nonros] dropping ACT target: " << e.what() << "\n";
+        }
+      });
+
+  // --- Initial observation. Scheme A: start on wall-clock, not 0. ---
+  SystemObservation initObservation;
+  initObservation.state = manipulatorInterface.getInitialState();
+  initObservation.input.setZero(info.inputDim);
+  initObservation.time = nowSeconds();
+
+  SystemObservation currentObservation = initObservation;
+
+  // Initial target = current pose (extended [joints(6), ee_pos(3), ee_quat(4)]) so the arm holds
+  // still until an external ACT target arrives.
+  const auto initEePose = getEndEffectorPose(manipulatorInterface, initObservation.state, eeFrame);
+  const Eigen::Quaterniond initQuat(initEePose.rotation());
+  const vector_t initTarget = (vector_t(initObservation.state.size() + 7) << initObservation.state,
+                               initEePose.translation(), initQuat.coeffs())
+                                  .finished();
+  const vector_t zeroInput = vector_t::Zero(info.inputDim);
+  TargetTrajectories initTargetTrajectories({initObservation.time}, {initTarget}, {zeroInput});
+
+  std::cout << "Waiting for the initial policy ..." << std::endl;
+  mpcMrtInterface.setCurrentObservation(initObservation);
+  mpcMrtInterface.getReferenceManager().setTargetTrajectories(initTargetTrajectories);
+  while (g_running.load() && !mpcMrtInterface.initialPolicyReceived()) {
+    mpcMrtInterface.advanceMpc();
+    std::this_thread::sleep_for(std::chrono::milliseconds(
+        static_cast<int>(1000.0 / manipulatorInterface.mpcSettings().mrtDesiredFrequency_)));
+  }
+  std::cout << "Initial policy has been received." << std::endl;
+
+  // --- MPC thread ---
+  std::atomic_bool mpcRunning{true};
+  auto mpcThread = std::thread([&]() {
+    pthread_setname_np(pthread_self(), "mpc_thread");
+    while (mpcRunning.load() && g_running.load()) {
+      try {
+        executeAndSleep([&]() { mpcMrtInterface.advanceMpc(); },
+                        manipulatorInterface.mpcSettings().mpcDesiredFrequency_);
+      } catch (const std::exception& e) {
+        mpcRunning = false;
+        std::cerr << "[nonros MPC thread] Error: " << e.what() << std::endl;
+      }
+    }
+  });
+  setThreadPriority(manipulatorInterface.ddpSettings().threadPriority_, mpcThread);
+
+  // --- MRT thread: rollout -> FK -> publish state ---
+  auto mrtThread = std::thread([&]() {
+    pthread_setname_np(pthread_self(), "mrt_thread");
+    while (mpcRunning.load() && g_running.load()) {
+      try {
+        executeAndSleep(
+            [&]() {
+              const auto systemInput = mpcTrackingController(currentObservation, mpcMrtInterface);
+
+              const double dt = 1.0 / manipulatorInterface.mpcSettings().mrtDesiredFrequency_;
+              SystemObservation nextObservation;
+              nextObservation.time = currentObservation.time + dt;
+              if (mpcMrtInterface.isRolloutSet()) {
+                mpcMrtInterface.rolloutPolicy(currentObservation.time, currentObservation.state, dt,
+                                              nextObservation.state, nextObservation.input,
+                                              nextObservation.mode);
+              } else {
+                mpcMrtInterface.evaluatePolicy(currentObservation.time + dt, currentObservation.state,
+                                               nextObservation.state, nextObservation.input,
+                                               nextObservation.mode);
+              }
+
+              // Publish end-effector state.
+              const auto eePose = getEndEffectorPose(manipulatorInterface, currentObservation.state, eeFrame);
+              const Eigen::Quaterniond quat(eePose.rotation());
+              EndEffectorStateMsg eeMsg{};
+              eeMsg.time = currentObservation.time;
+              eeMsg.position[0] = eePose.translation().x();
+              eeMsg.position[1] = eePose.translation().y();
+              eeMsg.position[2] = eePose.translation().z();
+              eeMsg.orientation[0] = quat.x();
+              eeMsg.orientation[1] = quat.y();
+              eeMsg.orientation[2] = quat.z();
+              eeMsg.orientation[3] = quat.w();
+              pubEe->publish(eeMsg);
+
+              // Publish joint state.
+              std::vector<double> jointPositions, jointVelocities, baseState;
+              getJointInfo(manipulatorInterface, currentObservation.state, systemInput, jointPositions,
+                           jointVelocities, baseState);
+              JointStateMsg jointMsg{};
+              jointMsg.time = currentObservation.time;
+              jointMsg.dof = static_cast<int32_t>(jointPositions.size());
+              const size_t nJoint = std::min<size_t>(jointPositions.size(), 32);
+              for (size_t i = 0; i < nJoint; ++i) {
+                jointMsg.positions[i] = jointPositions[i];
+                jointMsg.velocities[i] = jointVelocities[i];
+              }
+              pubJoint->publish(jointMsg);
+
+              // Publish base state (ALOHA: fixed base, all zero).
+              BaseStateMsg baseMsg{};
+              baseMsg.time = currentObservation.time;
+              baseMsg.x = baseState[0];
+              baseMsg.y = baseState[1];
+              baseMsg.yaw = baseState[2];
+              pubBase->publish(baseMsg);
+
+              // "state estimation": advance to the simulated next observation.
+              currentObservation = nextObservation;
+            },
+            manipulatorInterface.mpcSettings().mrtDesiredFrequency_);
+      } catch (const std::exception& e) {
+        mpcRunning = false;
+        std::cerr << "[nonros MRT thread] Error: " << e.what() << std::endl;
+      }
+    }
+  });
+  setThreadPriority(manipulatorInterface.ddpSettings().threadPriority_, mrtThread);
+
+  // --- main thread: wait for shutdown ---
+  while (mpcRunning.load() && g_running.load()) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(200));
+  }
+
+  mpcRunning = false;
+  if (mpcThread.joinable()) {
+    mpcThread.join();
+  }
+  if (mrtThread.joinable()) {
+    mrtThread.join();
+  }
+  std::cout << "[nonros] shutting down (" << prefix << ")." << std::endl;
+  return 0;
+}
