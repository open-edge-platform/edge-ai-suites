@@ -0,0 +1,285 @@
+#!/usr/bin/env python3
+# =============================================================================
+# Copyright (c) 2026, Intel Corporation. All rights reserved.
+# =============================================================================
+"""Launch the ALOHA dual-arm *nonros* MPC/MRT demo as two single-arm processes.
+
+Unlike the ROS version (manipulator_aloha_dual_arm.launch.py), the nonros node is
+NOT an rclcpp Node: it is a plain executable that talks over shared memory. So this
+file uses ExecuteProcess (pure `launch` orchestration, no rclcpp / no DDS) and passes
+CLI *positional* args + flags, not ROS `parameters`:
+
+    mobile_manipulator_mpc_mrt_node <taskFile> <libraryFolder> <urdfFile> \
+        --armSide LEFT|RIGHT --prefix left_arm|right_arm --subscribeMode act
+
+The executable installs to lib/ocs2_mobile_manipulator_nonros/ (not on PATH), so its
+full path is resolved via get_package_prefix().
+
+CppAD codegen safety (mirrors scripts/run_aloha_dual_arm.sh three stages):
+  Both arms share ONE libFolder. The default task.info ships `recompileLibraries true`,
+  which forces createModels() every start (regardless of existing .so). Starting both
+  arms at once against a cold, shared folder double-triggers codegen writing the same
+  files -> race / corruption / OOM. Even with `recompileLibraries false`, an INCOMPLETE
+  folder is unsafe: CppAdInterface::loadModelsIfAvailable() falls back to createModels()
+  per missing library, so two processes still race to generate whatever is absent. A
+  fixed TimerAction delay cannot fix this — it does not know when codegen finished.
+
+  This launch instead:
+    1. Runs the two arms against a TEMPORARY task.info copy with `recompileLibraries
+       false` (never mutates the source config).
+    2. Treats codegen as ready ONLY when a completion MARKER file exists in the
+       libFolder. The marker is written atomically by launch after a warm-up process
+       has (a) reported "Initial policy has been received." and (b) cleanly exited.
+       Presence of some .so is NOT trusted — a partial/interrupted codegen leaves
+       stray .so with no marker. scripts/run_aloha_dual_arm.sh writes the same marker.
+    3. When the folder is not ready it runs ONE warm-up process (a single process,
+       so its own createModels() fallback for any missing library is race-free),
+       waits for the ready line, SIGTERMs it, writes the marker on clean exit, and
+       only THEN starts LEFT + RIGHT together (now a pure load, no codegen, no race).
+
+  Launch args:
+    pregen         auto (default) | always | never
+                   auto   : warm up only when the marker is absent.
+                   always : always warm up first (then refresh the marker).
+                   never  : skip warm-up; REQUIRES the marker (fails fast on a cold or
+                            partial folder instead of racing). Use auto/always or the
+                            shell script to generate it first.
+    warmup_timeout seconds to wait for the warm-up ready line before aborting
+                   (default 180, matching run_aloha_dual_arm.sh WARMUP_TIMEOUT).
+                   Reliably catches a HUNG / quiet warm-up (stuck solver, deadlock,
+                   no stdout). Note: launch's single-threaded event loop reads the
+                   warm-up's stdout inline, so a warm-up that floods stdout without
+                   ever reaching the ready line can delay the timer; the common
+                   stuck-and-quiet case is unaffected.
+"""
+
+import os
+import re
+import signal
+import tempfile
+
+from ament_index_python.packages import get_package_prefix, get_package_share_directory
+from launch import LaunchDescription
+from launch.actions import (
+    DeclareLaunchArgument,
+    EmitEvent,
+    ExecuteProcess,
+    LogInfo,
+    OpaqueFunction,
+    RegisterEventHandler,
+    TimerAction,
+)
+from launch.event_handlers import OnProcessExit, OnProcessIO, OnShutdown
+from launch.events import Shutdown, matches_action
+from launch.events.process import SignalProcess
+from launch.substitutions import LaunchConfiguration
+
+_WARMUP_READY_LINE = 'Initial policy has been received.'
+# Written into the libFolder once codegen is verified complete (warm-up reached the
+# ready line AND exited cleanly). Shared with scripts/run_aloha_dual_arm.sh.
+_CODEGEN_MARKER = '.ocs2_nonros_codegen_complete'
+
+
+def _marker_path(folder):
+    return os.path.join(folder, _CODEGEN_MARKER)
+
+
+def _codegen_ready(folder):
+    """Ready == the completion marker exists. Presence of stray .so is NOT enough
+    (a partial/interrupted codegen leaves .so files but no marker)."""
+    return bool(folder) and os.path.isfile(_marker_path(folder))
+
+
+def _write_marker(folder):
+    """Atomically create the completion marker in folder (tmp + os.replace)."""
+    os.makedirs(folder, exist_ok=True)
+    fd, tmp = tempfile.mkstemp(prefix='.marker_', dir=folder)
+    os.close(fd)
+    os.replace(tmp, _marker_path(folder))
+
+
+def _make_norecompile_taskfile(src):
+    """Write a temp copy of task.info with `recompileLibraries true` -> false.
+
+    Never touches the source config (a Ctrl-C mid-run must not leave it polluted).
+    Mirrors run_aloha_dual_arm.sh::make_norecompile_taskfile. Raises if the flag is
+    not present false afterwards (absent key would default to true -> recompile race).
+    """
+    with open(src) as f:
+        content = f.read()
+    rewritten = re.sub(r'(?m)^([ \t]*recompileLibraries[ \t]+)true\b', r'\1false', content)
+    if not re.search(r'(?m)^[ \t]*recompileLibraries[ \t]+false\b', rewritten):
+        raise RuntimeError(
+            "could not set 'recompileLibraries false' in a temp copy of " + src +
+            " (flag missing?); dual-arm launch would race on shared-folder codegen")
+    fd, path = tempfile.mkstemp(prefix='aloha_task_', suffix='.info')
+    with os.fdopen(fd, 'w') as f:
+        f.write(rewritten)
+    return path
+
+
+def _remove_quietly(path):
+    try:
+        os.remove(path)
+    except OSError:
+        pass
+    return None
+
+
+def launch_setup(context, *args, **kwargs):
+    nonros_prefix = get_package_prefix('ocs2_mobile_manipulator_nonros')
+    node_exe = os.path.join(
+        nonros_prefix, 'lib', 'ocs2_mobile_manipulator_nonros',
+        'mobile_manipulator_mpc_mrt_node')
+
+    task_file = LaunchConfiguration('taskFile').perform(context)
+    lib_folder = LaunchConfiguration('libFolder').perform(context)
+    urdf_file = LaunchConfiguration('urdfFile').perform(context)
+    subscribe_mode = LaunchConfiguration('subscribeMode').perform(context)
+    pregen = LaunchConfiguration('pregen').perform(context).strip().lower()
+    if pregen not in ('auto', 'always', 'never'):
+        raise RuntimeError("pregen must be one of auto|always|never, got '%s'" % pregen)
+    try:
+        warmup_timeout = float(LaunchConfiguration('warmup_timeout').perform(context))
+    except ValueError:
+        raise RuntimeError('warmup_timeout must be a number of seconds')
+    if warmup_timeout <= 0.0:
+        raise RuntimeError('warmup_timeout must be > 0')
+
+    # Both arms always run against a no-recompile temp copy so neither re-triggers
+    # codegen (see module docstring). Removed on shutdown.
+    run_task_file = _make_norecompile_taskfile(task_file)
+
+    def arm_process(arm_side, prefix):
+        return ExecuteProcess(
+            cmd=[node_exe, run_task_file, lib_folder, urdf_file,
+                 '--armSide', arm_side, '--prefix', prefix,
+                 '--subscribeMode', subscribe_mode],
+            name='%s_mpc_mrt_node' % prefix,
+            output='screen',
+        )
+
+    left = arm_process('LEFT', 'left_arm')
+    right = arm_process('RIGHT', 'right_arm')
+
+    cleanup = RegisterEventHandler(OnShutdown(
+        on_shutdown=lambda event, ctx: _remove_quietly(run_task_file)))
+
+    ready = _codegen_ready(lib_folder)
+
+    if pregen == 'never' and not ready:
+        # Fail fast: skipping the warm-up on a cold/partial folder would let both arms
+        # race to createModels() the missing libraries. Do NOT silently start them.
+        raise RuntimeError(
+            "pregen=never but no codegen completion marker in '%s'.\n"
+            "The folder is cold or only partially generated; starting both arms would "
+            "race on codegen. Run with pregen=auto/always or scripts/run_aloha_dual_arm.sh "
+            "first to generate it." % lib_folder)
+
+    need_pregen = pregen == 'always' or (pregen == 'auto' and not ready)
+
+    if not need_pregen:
+        # Marker present: codegen verified complete -> false loads it, no codegen, no race.
+        return [
+            cleanup,
+            LogInfo(msg='[launch] codegen marker present in %s — launching LEFT + RIGHT '
+                        'with recompile disabled' % lib_folder),
+            left,
+            right,
+        ]
+
+    # Not ready (or forced): generate once via a single warm-up process, then start
+    # both arms only after it has exited AND the marker has been written. The warm-up
+    # uses the no-recompile task file too: loadModelsIfAvailable() falls back to
+    # createModels() for any missing library, and being a single process it completes a
+    # cold OR partial folder race-free.
+    os.makedirs(lib_folder, exist_ok=True)
+    warmup = ExecuteProcess(
+        cmd=[node_exe, run_task_file, lib_folder, urdf_file,
+             '--armSide', 'LEFT', '--prefix', 'left_arm', '--subscribeMode', subscribe_mode],
+        name='warmup_pregen',
+        output='screen',
+    )
+    state = {'signalled': False, 'finished': False, 'buf': ''}
+
+    def on_warmup_stdout(event):
+        if state['signalled']:
+            return None
+        text = event.text
+        state['buf'] += text.decode(errors='replace') if isinstance(text, bytes) else str(text)
+        if _WARMUP_READY_LINE in state['buf']:
+            state['signalled'] = True
+            return [
+                LogInfo(msg='[launch] codegen ready — stopping warm-up, then starting both arms'),
+                EmitEvent(event=SignalProcess(
+                    signal_number=signal.SIGTERM, process_matcher=matches_action(warmup))),
+            ]
+        return None
+
+    def on_warmup_exit(event, ctx):
+        state['finished'] = True
+        if not state['signalled']:
+            return [
+                LogInfo(msg='[launch] ERROR: warm-up exited before initial policy — aborting '
+                            '(inspect codegen/build output above)'),
+                EmitEvent(event=Shutdown(reason='warm-up failed before codegen completed')),
+            ]
+        _write_marker(lib_folder)
+        return [
+            LogInfo(msg='[launch] warm-up complete (marker written) — launching LEFT + RIGHT '
+                        '(recompile disabled)'),
+            left,
+            right,
+        ]
+
+    def on_warmup_timeout(context, *a, **k):
+        # Fires warmup_timeout seconds after the warm-up was launched. No-op if the
+        # warm-up already reported ready or exited; otherwise abort (codegen stuck /
+        # no policy / no stdout flush) instead of waiting forever.
+        if state['signalled'] or state['finished']:
+            return None
+        return [
+            LogInfo(msg='[launch] ERROR: warm-up did not reach initial policy within '
+                        '%gs — aborting' % warmup_timeout),
+            EmitEvent(event=SignalProcess(
+                signal_number=signal.SIGTERM, process_matcher=matches_action(warmup))),
+            EmitEvent(event=Shutdown(reason='warm-up timed out')),
+        ]
+
+    return [
+        cleanup,
+        LogInfo(msg='[launch] no codegen marker in %s — pre-generating once via a LEFT '
+                    'warm-up (timeout %gs) before starting both arms'
+                    % (lib_folder, warmup_timeout)),
+        RegisterEventHandler(OnProcessIO(target_action=warmup, on_stdout=on_warmup_stdout)),
+        RegisterEventHandler(OnProcessExit(target_action=warmup, on_exit=on_warmup_exit)),
+        TimerAction(period=warmup_timeout, actions=[OpaqueFunction(function=on_warmup_timeout)]),
+        warmup,
+    ]
+
+
+def generate_launch_description():
+    manipulator_share = get_package_share_directory('ocs2_mobile_manipulator')
+    assets_share = get_package_share_directory('ocs2_robotic_assets')
+
+    default_task = os.path.join(manipulator_share, 'config', 'aloha', 'task.info')
+    default_lib = os.path.join(manipulator_share, 'auto_generated', 'aloha_dual_arm')
+    default_urdf = os.path.join(
+        assets_share, 'resources', 'mobile_manipulator', 'aloha', 'urdf', 'vx300s.urdf')
+
+    return LaunchDescription([
+        DeclareLaunchArgument('taskFile', default_value=default_task),
+        DeclareLaunchArgument('libFolder', default_value=default_lib),
+        DeclareLaunchArgument('urdfFile', default_value=default_urdf),
+        DeclareLaunchArgument('subscribeMode', default_value='act'),
+        DeclareLaunchArgument(
+            'pregen', default_value='auto',
+            description='auto|always|never: run a serial codegen warm-up before starting '
+                        'both arms. auto warms up only when the codegen completion marker '
+                        'is absent; never requires the marker and fails fast without it.'),
+        DeclareLaunchArgument(
+            'warmup_timeout', default_value='180',
+            description='seconds to wait for the warm-up "Initial policy" line before '
+                        'aborting (matches run_aloha_dual_arm.sh WARMUP_TIMEOUT).'),
+        OpaqueFunction(function=launch_setup),
+    ])
