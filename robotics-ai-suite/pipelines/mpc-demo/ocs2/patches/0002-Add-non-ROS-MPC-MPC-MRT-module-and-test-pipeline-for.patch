+++ b/ocs2_robotic_examples/ocs2_mobile_manipulator_nonros/include/ocs2_mobile_manipulator_nonros/Transport.h
@@ -0,0 +1,113 @@
+/******************************************************************************
+Copyright (c) 2026, Intel Corporation. All rights reserved.
+******************************************************************************/
+
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <memory>
+#include <string>
+
+// Abstract IPC transport. The business layer talks ONLY to this
+// interface — never to shm_blkbuf_* or msgchan::* directly. Two implementations
+// are foreseen:
+//   * ShmTransport      (this phase) — POD structs over shmringbuf.
+//   * MsgchanTransport  (reserved)   — protobuf over msgchan.
+//
+// The POD structs below are the transport-neutral DTOs: ShmTransport memcpy's
+// them raw; MsgchanTransport (reserved) converts them to/from protobuf. Because
+// the business layer always passes these DTOs, swapping the transport requires
+// zero business-logic changes.
+//
+// createPublisher<T> / createSubscriber<T> are non-virtual template sugar (a
+// virtual template is not possible in C++); they dispatch via tag overloads to
+// per-type pure-virtual creators. The supported message types are single-sourced
+// in OCS2_NONROS_MSG_TYPES — adding a type is a one-line change there.
+namespace ocs2 {
+namespace mobile_manipulator {
+namespace nonros {
+
+// ------------------------------- wire POD messages -------------------------------
+struct EndEffectorStateMsg {
+  double time;
+  double position[3];
+  double orientation[4];  // quaternion, xyzw
+};
+
+struct JointStateMsg {
+  double time;
+  int32_t dof;
+  double positions[32];
+  double velocities[32];
+};
+
+struct BaseStateMsg {
+  double time;
+  double x, y, yaw;  // ALOHA fixed base: always 0, kept for layout parity
+};
+
+struct ActTargetQposMsg {
+  double stamp;      // publisher timestamp (node ignores it, uses recv wall-clock; Scheme A)
+  int32_t size;      // number of valid entries in qpos (ACT: 14)
+  double qpos[16];   // left(6)+left_grip(1)+right(6)+right_grip(1)
+};
+
+// Single source of the supported message types. Each X(T) expands per type.
+#define OCS2_NONROS_MSG_TYPES(X) \
+  X(EndEffectorStateMsg)         \
+  X(JointStateMsg)               \
+  X(BaseStateMsg)                \
+  X(ActTargetQposMsg)
+
+// ------------------------------- handles -------------------------------
+template <class T>
+class Publisher {
+ public:
+  virtual ~Publisher() = default;
+  virtual void publish(const T& msg) = 0;
+};
+
+template <class T>
+class Subscriber {
+ public:
+  virtual ~Subscriber() = default;  // callback registered at construction
+};
+
+// Tag used to route the createPublisher<T>/createSubscriber<T> template calls
+// to the matching per-type virtual creator.
+template <class T>
+struct MsgTag {};
+
+// ------------------------------- transport interface -------------------------------
+class ITransport {
+ public:
+  virtual ~ITransport() = default;
+
+  // shm: no-op (blocks are created lazily on createPublisher/createSubscriber).
+  // msgchan (reserved): msgchan::init().
+  virtual void init() = 0;
+
+  template <class T>
+  std::unique_ptr<Publisher<T>> createPublisher(const std::string& topic) {
+    return doCreatePublisher(topic, MsgTag<T>{});
+  }
+
+  template <class T>
+  std::unique_ptr<Subscriber<T>> createSubscriber(const std::string& topic,
+                                                  std::function<void(const T&)> callback) {
+    return doCreateSubscriber(topic, std::move(callback), MsgTag<T>{});
+  }
+
+ protected:
+#define OCS2_NONROS_DECL_CREATORS(T)                                                            \
+  virtual std::unique_ptr<Publisher<T>> doCreatePublisher(const std::string& topic, MsgTag<T>) = 0; \
+  virtual std::unique_ptr<Subscriber<T>> doCreateSubscriber(                                    \
+      const std::string& topic, std::function<void(const T&)> callback, MsgTag<T>) = 0;
+  OCS2_NONROS_MSG_TYPES(OCS2_NONROS_DECL_CREATORS)
+#undef OCS2_NONROS_DECL_CREATORS
+};
+
+}  // namespace nonros
+}  // namespace mobile_manipulator
+}  // namespace ocs2
