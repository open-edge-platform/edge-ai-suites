index 000000000..d81010b4d
--- /dev/null
+++ b/ocs2_robotic_examples/ocs2_mobile_manipulator_nonros/scripts/mujoco_viewer.py
@@ -0,0 +1,461 @@
+#!/usr/bin/env python3
+# =============================================================================
+# Copyright (c) 2026, Intel Corporation. All rights reserved.
+# =============================================================================
+"""MuJoCo simulation for the non-ROS ALOHA dual-arm demo.
+
+Single merged viewer driven by a MuJoCo XML scene: ONE process loads a scene
+config (e.g. the reference `bimanual_viperx_transfer_cube_dual_arm.xml`) and
+displays BOTH vx300s arms plus the tabletop box in one window. Each arm's 6 joints
+are driven independently by its own shared-memory block (`left_arm_state_joint` /
+`right_arm_state_joint`) published by the two MPC/MRT node processes; each arm's
+gripper is driven by a second block (`left_arm_state_gripper` /
+`right_arm_state_gripper`) published directly by aloha_act_publisher (the grippers
+bypass the MPC, which ignores them).
+
+The viewer runs FULL PHYSICS: incoming joint/gripper commands are fed to the
+scene's `<position>` actuators via `data.ctrl` and `mujoco.mj_step` integrates the
+whole model with the scene's authored collisions, so the grippers make real contact
+and can grasp/lift the box. This mirrors the reference ROS setup exactly, where
+MuJoCo's native `simulate` stepped the model and the
+`MujocoRosUtils::ActuatorCommand` plugin drove these same actuators from ROS topics.
+(A headless probe confirmed full collisions are stable under mj_step in mujoco
+3.10 — even the arm meshes colliding with the table produce no BVH errors.)
+
+The scene XML is parsed and adapted for headless/pure-Python MuJoCo:
+  * `<include>` files are inlined (so relative includes resolve without a
+    working-directory dependency);
+  * `MujocoRosUtils` plugins and the `<extension>`/`<sensor>`/keyframe `ctrl` that
+    reference them are stripped (the plugin .so is not loadable here and would
+    abort model compilation) — but the plain `<position>` actuators are KEPT: they
+    carry no plugin dependency and are what the simulation drives;
+  * mesh/texture files are collected and passed as in-memory assets.
+Nothing is written back to the scene directory.
+
+Usage:
+    python mujoco_viewer.py <scene.xml> [--rate HZ]
+        [--left-prefix vx300s_left] [--right-prefix vx300s_right]
+
+The ctypes struct MUST match Transport.h::JointStateMsg exactly:
+    { double time; int32_t dof; double positions[32]; double velocities[32]; }
+Under ctypes' default alignment the int32 is followed by 4 padding bytes, so
+sizeof == 528 (8 + 4 + 4pad + 256 + 256). Do NOT set `_pack_` — that would drop
+the padding and misalign every field after `dof`.
+"""
+
+import argparse
+import ctypes
+import os
+import sys
+import time
+from defusedxml import ElementTree as ET
+
+import mujoco
+from mujoco import viewer as mj_viewer
+
+# --- Load the C++ shared-memory library (libshmringbuf.so must be on LD_LIBRARY_PATH) ---
+shm = ctypes.CDLL("libshmringbuf.so")
+
+
+# --- POD layout mirroring Transport.h::JointStateMsg (NEW layout; not the old [50] one) ---
+class JointStateMsg(ctypes.Structure):
+    _fields_ = [
+        ("time", ctypes.c_double),
+        ("dof", ctypes.c_int32),
+        ("positions", ctypes.c_double * 32),
+        ("velocities", ctypes.c_double * 32),
+    ]
+
+
+# Hard assertion: catches any accidental drift from the C++ struct.
+assert ctypes.sizeof(JointStateMsg) == 528, (
+    f"JointStateMsg size mismatch: {ctypes.sizeof(JointStateMsg)} != 528. "
+    "Check field order / alignment; do not set _pack_."
+)
+
+MSG_LEN = 1024
+JOINT_STATE_SIZE = ctypes.sizeof(JointStateMsg)
+
+# --- Bind the C shmringbuf interfaces (subset used by a read-only consumer) ---
+shm_blkbuf_open = shm.shm_blkbuf_open
+shm_blkbuf_open.restype = ctypes.c_void_p
+shm_blkbuf_open.argtypes = [ctypes.c_char_p]
+
+shm_blkbuf_read = shm.shm_blkbuf_read
+shm_blkbuf_read.restype = ctypes.c_int
+shm_blkbuf_read.argtypes = [ctypes.c_void_p, ctypes.c_void_p, ctypes.c_size_t]
+
+shm_blkbuf_empty = shm.shm_blkbuf_empty
+shm_blkbuf_empty.restype = ctypes.c_int
+shm_blkbuf_empty.argtypes = [ctypes.c_void_p]
+
+# While a block's publisher isn't running yet, shm_blkbuf_open's shm_open() fails with
+# ENOENT and libshmringbuf.so prints "shm_open error!" straight to stdout/stderr. The
+# viewer opens blocks lazily, so retrying every refresh frame (~50 Hz) floods the
+# console until the publishers start. Back off to one retry per interval instead.
+_REOPEN_INTERVAL = 1.0  # seconds between lazy shm_blkbuf_open retries for a missing block
+
+
+def _try_open(block_name, next_open_ts):
+    """Attempt shm_blkbuf_open at most once per _REOPEN_INTERVAL.
+
+    Returns (handle, next_open_ts): a truthy handle once the block exists, else 0 with
+    the timestamp of the next allowed attempt. This throttles only the retry rate; it
+    never delays a successful connection beyond one interval."""
+    now = time.monotonic()
+    if now < next_open_ts:
+        return 0, next_open_ts
+    return shm_blkbuf_open(block_name.encode("utf-8")), now + _REOPEN_INTERVAL
+
+# Per-arm 6-DOF joint names in shared-memory order. In the scene these carry an
+# arm prefix, e.g. `vx300s_left/waist` (see --left-prefix / --right-prefix).
+ARM_JOINTS = [
+    "waist",
+    "shoulder",
+    "elbow",
+    "forearm_roll",
+    "wrist_angle",
+    "wrist_rotate",
+]
+
+# Two symmetric slide joints per gripper. A single normalized opening (0=closed,
+# 1=open) drives both: each finger interpolates over its own model range, with
+# "closed" = the range bound nearest zero and "open" = the far bound (see
+# _finger_bounds). The two fingers slide in opposite directions, so the model's
+# signed ranges make them mirror automatically.
+GRIPPER_JOINTS = ["left_finger", "right_finger"]
+
+# Whole sections that only ever hold MujocoRosUtils plugins and must be dropped
+# before pure-Python MuJoCo compiles the model. NOTE: `actuator` is deliberately
+# NOT here — the scene's plain <position> actuators must survive (the simulation
+# drives them). Only the <plugin> actuators nested inside <actuator> are removed,
+# via the generic `name == "plugin"` rule in _strip_plugins.
+_STRIP_SECTIONS = ("extension", "sensor")
+
+
+def parse_args():
+    parser = argparse.ArgumentParser(
+        description="MuJoCo viewer for the non-ROS ALOHA dual-arm demo: loads a "
+        "scene XML (both arms + box) and drives each arm from its shm block."
+    )
+    parser.add_argument(
+        "scene_xml",
+        help="path to the MuJoCo scene XML (e.g. bimanual_viperx_transfer_cube_dual_arm.xml)",
+    )
+    parser.add_argument(
+        "--left-prefix",
+        default="vx300s_left",
+        help="joint-name prefix of the left arm in the scene (default vx300s_left)",
+    )
+    parser.add_argument(
+        "--right-prefix",
+        default="vx300s_right",
+        help="joint-name prefix of the right arm in the scene (default vx300s_right)",
+    )
+    parser.add_argument(
+        "--rate", type=float, default=50.0, help="viewer refresh rate in Hz (default 50)"
+    )
+    return parser.parse_args()
+
+
+# --- Scene XML loading: inline includes, strip plugins, collect mesh assets ---
+def _localname(tag):
+    return tag.rsplit("}", 1)[-1]
+
+
+def _inline_includes(elem, base_dir):
+    """Recursively replace <include file="X"/> children with the children of the
+    included file's root element (mirroring MuJoCo's include semantics)."""
+    rebuilt = []
+    for child in list(elem):
+        if _localname(child.tag) == "include":
+            inc = child.get("file")
+            inc_path = os.path.join(base_dir, inc)
+            sub_root = ET.parse(inc_path).getroot()
+            _inline_includes(sub_root, os.path.dirname(inc_path))
+            rebuilt.extend(list(sub_root))
+        else:
+            _inline_includes(child, base_dir)
+            rebuilt.append(child)
+    for c in list(elem):
+        elem.remove(c)
+    for c in rebuilt:
+        elem.append(c)
+
+
+def _strip_plugins(root):
+    """Remove plugin-dependent sections and any <plugin> elements, and drop the
+    keyframe `ctrl`/`act`. The <position> actuators are kept, but removing the
+    nested <plugin> actuators shrinks `nu`, so a keyframe `ctrl` sized for the
+    original actuator count would no longer match — hence it must be dropped."""
+    parent_of = {c: p for p in root.iter() for c in p}
+    to_remove = []
+    for elem in root.iter():
+        name = _localname(elem.tag)
+        if name in _STRIP_SECTIONS or name == "plugin":
+            to_remove.append(elem)
+        elif name == "key":
+            # keep qpos as an initial pose, but ctrl no longer has actuators
+            elem.attrib.pop("ctrl", None)
+            elem.attrib.pop("act", None)
+    for elem in to_remove:
+        parent = parent_of.get(elem)
+        if parent is not None:
+            parent.remove(elem)
+
+
+def _collect_assets(root, base_dir):
+    assets = {}
+    for tag in ("mesh", "texture", "hfield"):
+        for e in root.iter(tag):
+            fname = e.get("file")
+            if not fname:
+                continue
+            cand = os.path.join(base_dir, fname)
+            if os.path.exists(cand) and fname not in assets:
+                with open(cand, "rb") as f:
+                    assets[fname] = f.read()
+    return assets
+
+
+def load_scene_model(scene_xml):
+    """Load a scene XML into an MjModel, adapting it for pure-Python MuJoCo.
+
+    The scene's authored collisions are left untouched, so the grippers/box/table
+    contact each other exactly as in the reference `simulate` setup."""
+    scene_xml = os.path.abspath(scene_xml)
+    base_dir = os.path.dirname(scene_xml)
+
+    root = ET.parse(scene_xml).getroot()
+    _inline_includes(root, base_dir)
+    _strip_plugins(root)
+    assets = _collect_assets(root, base_dir)
+
+    xml_str = ET.tostring(root, encoding="unicode")
+    return mujoco.MjModel.from_xml_string(xml_str, assets=assets)
+
+
+def _finger_bounds(lo, hi):
+    """Map a finger slide joint's (lo, hi) range to (closed, open) endpoints.
+
+    The bound nearest zero is the closed position, the far bound is fully open, so a
+    normalized opening g in [0, 1] becomes `closed + g * (open - closed)`. Handles
+    both the positive-range left_finger and the negative-range right_finger."""
+    return (lo, hi) if abs(lo) <= abs(hi) else (hi, lo)
+
+
+class ArmConsumer:
+    """Reads one arm's shared-memory blocks and applies them to the scene:
+      * `{block_prefix}_state_joint`   -> the 6 arm joints (from the MPC node)
+      * `{block_prefix}_state_gripper` -> the two finger joints (from the publisher)
+
+    The values become POSITION-ACTUATOR targets: each arm joint's
+    `{joint_prefix}/{joint}` actuator and each finger's actuator are driven via
+    `data.ctrl`, then `mj_step` tracks them under the model's own dynamics and
+    contacts (grasp)."""
+
+    def __init__(self, model, block_prefix, joint_prefix):
+        self.block_name = f"{block_prefix}_state_joint"
+        self.handle = shm_blkbuf_open(self.block_name.encode("utf-8"))
+        self.buf = ctypes.create_string_buffer(MSG_LEN)
+        self._joint_next_open = 0.0  # throttles lazy reopen while the block is missing
+
+        # Arm joints: resolve position-actuator ids (actuator names equal the joint
+        # names in the reference scene) to drive via data.ctrl.
+        self.arm_act_ids = []
+        missing = []
+        for name in ARM_JOINTS:
+            full = f"{joint_prefix}/{name}"
+            aid = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_ACTUATOR, full)
+            self.arm_act_ids.append(aid if aid >= 0 else None)
+            if aid < 0:
+                missing.append(full)
+        if missing:
+            print(f"[WARN] {self.block_name}: actuators not found in scene: {missing}")
+
+        # --- Gripper block + finger joints. One normalized opening drives both
+        #     fingers, each interpolated over its (closed, open) endpoints, taken
+        #     from the finger ACTUATOR's ctrlrange (what data.ctrl is clamped to). ---
+        self.grip_block_name = f"{block_prefix}_state_gripper"
+        self.grip_handle = shm_blkbuf_open(self.grip_block_name.encode("utf-8"))
+        self.grip_buf = ctypes.create_string_buffer(MSG_LEN)
+        self._grip_next_open = 0.0  # throttles lazy reopen while the block is missing
+
+        self.finger_act_ids = []
+        self.finger_bounds = []  # (closed, open) per finger
+        grip_missing = []
+        for name in GRIPPER_JOINTS:
+            full = f"{joint_prefix}/{name}"
+            aid = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_ACTUATOR, full)
+            if aid < 0:
+                grip_missing.append(full)
+                continue
+            lo, hi = float(model.actuator_ctrlrange[aid][0]), float(model.actuator_ctrlrange[aid][1])
+            self.finger_act_ids.append(aid)
+            self.finger_bounds.append(_finger_bounds(lo, hi))
+        if grip_missing:
+            print(f"[WARN] {self.grip_block_name}: finger actuators not found in scene: {grip_missing}")
+
+    def update(self, data):
+        self._update_arm(data)
+        self._update_gripper(data)
+
+    def _update_arm(self, data):
+        # Lazily (re)open the block until the publisher exists (rate-limited).
+        if not self.handle:
+            self.handle, self._joint_next_open = _try_open(self.block_name, self._joint_next_open)
+        if not self.handle or shm_blkbuf_empty(self.handle) != 0:
+            return
+
+        ret = shm_blkbuf_read(self.handle, self.buf, MSG_LEN)
+        if ret <= 0:
+            return
+        if ret < JOINT_STATE_SIZE:
+            print(f"[WARN] {self.block_name}: short read {ret} < {JOINT_STATE_SIZE}")
+            return
+
+        js = JointStateMsg.from_buffer_copy(self.buf[:JOINT_STATE_SIZE])
+        # Set position-actuator targets; mj_step clamps to ctrlrange and tracks
+        # them under the model dynamics (velocities are unused by position actuators).
+        n = min(js.dof, len(self.arm_act_ids))
+        for i in range(n):
+            aid = self.arm_act_ids[i]
+            if aid is not None:
+                data.ctrl[aid] = js.positions[i]
+
+    def _update_gripper(self, data):
+        if not self.grip_handle:
+            self.grip_handle, self._grip_next_open = _try_open(self.grip_block_name, self._grip_next_open)
+        if not self.grip_handle or shm_blkbuf_empty(self.grip_handle) != 0:
+            return
+
+        ret = shm_blkbuf_read(self.grip_handle, self.grip_buf, MSG_LEN)
+        if ret <= 0:
+            return
+        if ret < JOINT_STATE_SIZE:
+            print(f"[WARN] {self.grip_block_name}: short read {ret} < {JOINT_STATE_SIZE}")
+            return
+
+        js = JointStateMsg.from_buffer_copy(self.grip_buf[:JOINT_STATE_SIZE])
+        # dof=1: a single normalized opening; clamp to [0,1] before mapping.
+        g = min(1.0, max(0.0, js.positions[0]))
+        for aid, (closed, open_) in zip(self.finger_act_ids, self.finger_bounds):
+            data.ctrl[aid] = closed + g * (open_ - closed)
+
+
+class BoxResetConsumer:
+    """Resets the free-joint tabletop box to its keyframe pose when the looping
+    publisher bumps the loop index on the `world_reset` block.
+
+    Edge-triggered on the integer loop index (JointStateMsg.dof); positions are
+    unused. The box otherwise moves only under physics (grippers push/grasp it), so
+    without this a `--loop` run would accumulate the box's drift across passes. The
+    first index seen only syncs the baseline (no reset — the box is already at its
+    keyframe pose); each later change snaps the box's 7 qpos back to the captured
+    keyframe pose, zeros its 6 qvel, and re-runs forward kinematics."""
+
+    def __init__(self, model, data, joint_name="red_box_joint"):
+        self.block_name = "world_reset"
+        self.handle = shm_blkbuf_open(self.block_name.encode("utf-8"))
+        self.buf = ctypes.create_string_buffer(MSG_LEN)
+        self.last_index = None
+        self._next_open = 0.0  # throttles lazy reopen while the block is missing
+
+        jid = mujoco.mj_name2id(model, mujoco.mjtObj.mjOBJ_JOINT, joint_name)
+        if jid < 0:
+            print(f"[WARN] {self.block_name}: box joint '{joint_name}' not found; box reset disabled")
+            self.qadr = self.vadr = None
+            return
+        self.qadr = int(model.jnt_qposadr[jid])  # free joint: 7 qpos (pos3 + quat4)
+        self.vadr = int(model.jnt_dofadr[jid])  # free joint: 6 qvel
+        # Snapshot the keyframe box pose (data is already reset to keyframe 0 here).
+        self.init_qpos = [float(data.qpos[self.qadr + i]) for i in range(7)]
+
+    def update(self, model, data):
+        if self.qadr is None:
+            return
+        if not self.handle:
+            self.handle, self._next_open = _try_open(self.block_name, self._next_open)
+        if not self.handle or shm_blkbuf_empty(self.handle) != 0:
+            return
+
+        ret = shm_blkbuf_read(self.handle, self.buf, MSG_LEN)
+        if ret < JOINT_STATE_SIZE:
+            return
+        index = JointStateMsg.from_buffer_copy(self.buf[:JOINT_STATE_SIZE]).dof
+
+        if self.last_index is None:
+            self.last_index = index  # sync baseline; no reset on first signal
+            return
+        if index != self.last_index:
+            self.last_index = index
+            for i in range(7):
+                data.qpos[self.qadr + i] = self.init_qpos[i]
+            for i in range(6):
+                data.qvel[self.vadr + i] = 0.0
+            mujoco.mj_forward(model, data)
+            print(f"[mujoco_viewer] box reset to keyframe pose (loop {index})")
+
+
+def main():
+    args = parse_args()
+
+    if not os.path.exists(args.scene_xml):
+        print(f"Error: scene XML not found: {args.scene_xml}")
+        sys.exit(1)
+
+    model = load_scene_model(args.scene_xml)
+    data = mujoco.MjData(model)
+
+    # Start from a stored keyframe if the scene provides one (nice initial pose
+    # for arms/box); otherwise the model default.
+    if model.nkey > 0:
+        mujoco.mj_resetDataKeyframe(model, data, 0)
+
+    # Seed each position actuator's target from the current joint pose, so the arms
+    # hold the keyframe pose instead of driving toward ctrl=0 before the first shm
+    # command arrives.
+    for aid in range(model.nu):
+        jid = int(model.actuator_trnid[aid, 0])
+        data.ctrl[aid] = data.qpos[int(model.jnt_qposadr[jid])]
+
+    consumers = [
+        ArmConsumer(model, "left_arm", args.left_prefix),
+        ArmConsumer(model, "right_arm", args.right_prefix),
+    ]
+    # Reset the box to its keyframe pose on each playback pass of a looping publisher.
+    # Created after the keyframe reset above so it captures the keyframe box pose.
+    box_reset = BoxResetConsumer(model, data)
+
+    period = 1.0 / args.rate if args.rate > 0 else 0.02
+    # Advance ~one refresh period of sim time per synced frame (roughly real time),
+    # split into model-timestep substeps for a stable integration.
+    n_substeps = max(1, round(period / model.opt.timestep))
+    block_names = (
+        [c.block_name for c in consumers]
+        + [c.grip_block_name for c in consumers]
+        + [box_reset.block_name]
+    )
+    print(
+        f"[mujoco_viewer] scene={os.path.basename(args.scene_xml)} "
+        f"blocks={', '.join(block_names)}"
+    )
+
+    viewer = mj_viewer.launch_passive(model, data)
+    try:
+        while viewer.is_running():
+            for consumer in consumers:
+                consumer.update(data)
+            box_reset.update(model, data)
+            for _ in range(n_substeps):
+                mujoco.mj_step(model, data)
+            viewer.sync()
+            time.sleep(period)
+    except KeyboardInterrupt:
+        pass
+    finally:
+        viewer.close()
+
+
+if __name__ == "__main__":
+    main()
