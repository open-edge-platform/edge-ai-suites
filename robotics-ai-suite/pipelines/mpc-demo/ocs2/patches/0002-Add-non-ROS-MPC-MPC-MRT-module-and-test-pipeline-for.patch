--- /dev/null
+++ b/ocs2_robotic_examples/ocs2_mobile_manipulator_nonros/include/ocs2_mobile_manipulator_nonros/ShmTransport.h
@@ -0,0 +1,221 @@
+/******************************************************************************
+Copyright (c) 2026, Intel Corporation. All rights reserved.
+******************************************************************************/
+
+#pragma once
+
+#include <atomic>
+#include <cstring>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <shmringbuf.h>
+
+#include "ocs2_mobile_manipulator_nonros/Transport.h"
+
+// Shared-memory transport over shmringbuf.
+//
+// Lifecycle: publisher side shm_blkbuf_init (creates the block),
+// subscriber side shm_blkbuf_open (opens it, retried until the publisher has
+// created it — removes startup ordering races).
+//
+// Ownership: shm_blkbuf_close() is munmap + UNCONDITIONAL shm_unlink() — it cannot
+// distinguish a creator handle from an opener handle, so any close deletes the block
+// from /dev/shm globally. Therefore only the creator (publisher) closes its handles in
+// the destructor; subscriber (opener) handles are deliberately NOT closed, or a
+// node/viewer exit would unlink a block its peers still use and no new process could
+// reconnect. libshmringbuf exposes no detach-only (munmap without unlink) call, so the
+// subscriber mapping is left for the kernel to reclaim on process exit.
+//
+// shmringbuf has no event notification, so a SINGLE receiver thread polls every
+// ~kPollIntervalUs and runs all subscriber callbacks serially.
+// Callbacks must stay light — heavy work (e.g. FK) runs on this thread.
+//
+// Broadcast fan-out (shm-only shim). shmringbuf is a competing-consumer queue,
+// NOT pub/sub: its read cursor lives in the shared segment, so a single write is
+// consumed by whichever reader polls first — two node processes subscribing to the
+// same block would each steal ~half the frames. To emulate broadcast for topics
+// that fan out to multiple arm processes (act/target_qpos), the publisher writes
+// the SAME message to one per-consumer block ('<topic>__<prefix>') and each
+// subscriber reads only its own arm's block. The logical topic stays global and
+// consumer-side slicing is unchanged, so the business layer and the msgchan path
+// (real pub/sub, no shim needed) require zero changes.
+namespace ocs2 {
+namespace mobile_manipulator {
+namespace nonros {
+
+// -------- POD publisher: memcpy + shm_blkbuf_write, fanned out to N blocks --------
+template <class T>
+class ShmPublisher : public Publisher<T> {
+ public:
+  explicit ShmPublisher(std::vector<shm_handle_t> handles) : handles_(std::move(handles)) {}
+  void publish(const T& msg) override {
+    for (shm_handle_t handle : handles_) {
+      if (handle == nullptr) {
+        continue;
+      }
+      // Mirror the reference impl: skip when the ring is full (slow/absent consumer).
+      if (shm_blkbuf_full(handle)) {
+        continue;
+      }
+      shm_blkbuf_write(handle, const_cast<void*>(static_cast<const void*>(&msg)), sizeof(T));
+    }
+  }
+
+ private:
+  std::vector<shm_handle_t> handles_;  // non-owning; ShmTransport closes them
+};
+
+// -------- Subscriber token: deactivates its poll entry on destruction --------
+template <class T>
+class ShmSubscriber : public Subscriber<T> {
+ public:
+  explicit ShmSubscriber(std::atomic<bool>* active) : active_(active) {}
+  ~ShmSubscriber() override {
+    if (active_ != nullptr) {
+      active_->store(false, std::memory_order_release);
+    }
+  }
+
+ private:
+  std::atomic<bool>* active_;  // points into the owning ShmTransport's PollEntry
+};
+
+class ShmTransport : public ITransport {
+ public:
+  // ownPrefix          : this process's arm prefix (e.g. "left_arm"); used to pick
+  //                      the per-arm block when SUBSCRIBING to a broadcast topic.
+  // broadcastPrefixes  : consumer prefixes to fan out to when PUBLISHING a broadcast
+  //                      topic (e.g. {"left_arm","right_arm"}).
+  // Both default empty: a transport that neither subscribes nor publishes a broadcast
+  // topic (e.g. the round-trip unit test) needs no configuration. broadcastPrefixes is
+  // validated (no empty entry, no duplicates) so a bad --left/--right can't silently
+  // desync block names between publisher and node, or double-init the same block.
+  //
+  // persistPublisherBlocks: when true, the destructor does NOT close (== munmap +
+  // shm_unlink) the blocks this transport created; they stay in /dev/shm so peers keep
+  // their mappings and a *restarted* publisher reattaches to the SAME segment (shm_open
+  // is O_CREAT without O_EXCL). Use for a short-lived publisher that outlives-in-name its
+  // long-running consumers (the ALOHA act publisher): without it, the publisher's exit
+  // unlinks the ACT/gripper blocks and a second run creates fresh segments the already-
+  // running MPC nodes / viewer never reattach to (see ShmTransport.h ownership note).
+  // Default false keeps the self-cleaning behavior the round-trip tests rely on.
+  explicit ShmTransport(std::string ownPrefix = "", std::vector<std::string> broadcastPrefixes = {},
+                        bool persistPublisherBlocks = false);
+  ~ShmTransport() override;
+
+  ShmTransport(const ShmTransport&) = delete;
+  ShmTransport& operator=(const ShmTransport&) = delete;
+
+  void init() override {}  // blocks are created lazily by the creators below
+
+  // Logical topic -> legal shm block name ('/' -> '_').
+  static std::string toBlockName(const std::string& topic);
+
+  // A broadcast topic has NO per-consumer prefix baked into its logical name and
+  // must reach every arm process; ShmTransport fans it out to per-prefix blocks.
+  // Must be a pure function of the topic string so publisher and subscriber
+  // processes agree independently. Currently: act/target_qpos only.
+  static bool isBroadcastTopic(const std::string& topic);
+
+ protected:
+#define OCS2_NONROS_IMPL_CREATORS(T)                                                            \
+  std::unique_ptr<Publisher<T>> doCreatePublisher(const std::string& topic, MsgTag<T>) override { \
+    return makePublisherImpl<T>(topic);                                                         \
+  }                                                                                             \
+  std::unique_ptr<Subscriber<T>> doCreateSubscriber(                                            \
+      const std::string& topic, std::function<void(const T&)> callback, MsgTag<T>) override {   \
+    return makeSubscriberImpl<T>(topic, std::move(callback));                                   \
+  }
+  OCS2_NONROS_MSG_TYPES(OCS2_NONROS_IMPL_CREATORS)
+#undef OCS2_NONROS_IMPL_CREATORS
+
+ private:
+  static constexpr uint32_t kBlocks = 16;          // ring depth per block
+  static constexpr int kPollIntervalUs = 100;      // receiver poll period
+  // Retry shm_blkbuf_open() at most once per this many ticks (~1s at 100us). shmringbuf
+  // prints "shm_open error!" on every failed open, so retrying every tick floods stderr
+  // while the publisher process is not up yet.
+  static constexpr uint64_t kOpenRetryTicks = 10000;
+
+  // One entry per subscription, polled by the single receiver thread.
+  struct PollEntry {
+    shm_handle_t handle{nullptr};                  // opened lazily (retried) in the loop
+    std::string blockName;
+    std::function<bool(shm_handle_t)> pollOnce;    // read + decode + invoke callback
+    std::atomic<bool> active{true};
+    uint64_t tick{0};                              // poll counter, gates open retries
+  };
+
+  template <class T>
+  std::unique_ptr<Publisher<T>> makePublisherImpl(const std::string& topic) {
+    // Broadcast topics fan out to one block per consumer prefix; others map to a
+    // single block. publish() writes the same message to every returned handle.
+    std::vector<shm_handle_t> handles;
+    for (const std::string& block : publisherBlockNames(topic)) {
+      shm_handle_t handle = shm_blkbuf_init(const_cast<char*>(block.c_str()), kBlocks, sizeof(T));
+      if (handle == nullptr) {
+        throw std::runtime_error("ShmTransport: failed to init shm block '" + block + "'");
+      }
+      pubHandles_.push_back(handle);
+      handles.push_back(handle);
+    }
+    return std::make_unique<ShmPublisher<T>>(std::move(handles));
+  }
+
+  template <class T>
+  std::unique_ptr<Subscriber<T>> makeSubscriberImpl(const std::string& topic,
+                                                    std::function<void(const T&)> callback) {
+    auto entry = std::make_unique<PollEntry>();
+    entry->blockName = subscriberBlockName(topic);
+    entry->pollOnce = [cb = std::move(callback)](shm_handle_t handle) -> bool {
+      if (shm_blkbuf_empty(handle)) {
+        return false;
+      }
+      T msg;
+      const uint32_t ret = shm_blkbuf_read(handle, &msg, sizeof(T));
+      if (ret == 0) {
+        return false;
+      }
+      cb(msg);
+      return true;
+    };
+    std::atomic<bool>* activePtr = &entry->active;
+    {
+      std::lock_guard<std::mutex> lock(pollersMutex_);
+      pollers_.push_back(std::move(entry));
+    }
+    startReceiverIfNeeded();
+    return std::make_unique<ShmSubscriber<T>>(activePtr);
+  }
+
+  void startReceiverIfNeeded();
+  void receiverLoop();
+
+  // Per-consumer block name for a broadcast topic: '<toBlockName(topic)>__<prefix>'.
+  static std::string blockForPrefix(const std::string& topic, const std::string& prefix);
+  // Blocks a publisher must write: fan-out (one per broadcastPrefixes_) for a
+  // broadcast topic, else a single block. Throws if a broadcast topic is published
+  // without any broadcastPrefixes_ configured.
+  std::vector<std::string> publisherBlockNames(const std::string& topic) const;
+  // Block a subscriber reads: the per-ownPrefix_ block for a broadcast topic, else a
+  // single block. Throws if a broadcast topic is subscribed without ownPrefix_ set.
+  std::string subscriberBlockName(const std::string& topic) const;
+
+  const std::string ownPrefix_;                      // this process's arm prefix (subscriber side)
+  const std::vector<std::string> broadcastPrefixes_; // fan-out destinations (publisher side)
+  const bool persistPublisherBlocks_;                // if true, dtor leaves created blocks linked
+  std::vector<shm_handle_t> pubHandles_;             // owned; closed in dtor
+  std::vector<std::unique_ptr<PollEntry>> pollers_;  // owned; handles closed in dtor
+  std::mutex pollersMutex_;
+  std::thread receiver_;
+  std::atomic<bool> receiverRunning_{false};
+};
+
+}  // namespace nonros
+}  // namespace mobile_manipulator
+}  // namespace ocs2
