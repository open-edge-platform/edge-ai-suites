+/******************************************************************************
+Copyright (c) 2026, Intel Corporation. All rights reserved.
+******************************************************************************/
+
+#include "ocs2_mobile_manipulator_nonros/AlohaReferenceConverter.h"
+
+#include <chrono>
+#include <stdexcept>
+
+#include <pinocchio/algorithm/frames.hpp>
+#include <pinocchio/algorithm/kinematics.hpp>
+
+namespace ocs2 {
+namespace mobile_manipulator {
+namespace nonros {
+
+ArmSide armSideFromString(const std::string& side) {
+  if (side == "LEFT") {
+    return ArmSide::LEFT;
+  }
+  if (side == "RIGHT") {
+    return ArmSide::RIGHT;
+  }
+  throw std::invalid_argument("AlohaReferenceConverter: invalid armSide '" + side + "' (use LEFT or RIGHT)");
+}
+
+AlohaReferenceConverter::AlohaReferenceConverter(PinocchioInterface pinocchioInterface, size_t eeFrameId,
+                                                 ArmSide armSide)
+    : pinocchioInterface_(std::move(pinocchioInterface)), eeFrameId_(eeFrameId), armSide_(armSide) {}
+
+TargetTrajectories AlohaReferenceConverter::fromActQpos(const double* qpos, int n) const {
+  // qpos = [ left_arm(6), left_gripper(1), right_arm(6), right_gripper(1), (stamp) ].
+  // Split into this arm's 6 DOF (aligned with RosReferenceManager L121-124).
+  constexpr int kArmDof = 6;
+  vector_t armTargetQpos(kArmDof);
+  if (armSide_ == ArmSide::LEFT) {
+    if (n < kArmDof) {
+      throw std::invalid_argument("fromActQpos: LEFT needs >= 6 values, got " + std::to_string(n));
+    }
+    for (int i = 0; i < kArmDof; ++i) {
+      armTargetQpos(i) = qpos[i];  // head(6)
+    }
+  } else {  // RIGHT
+    if (n < 13) {
+      throw std::invalid_argument("fromActQpos: RIGHT needs >= 13 values, got " + std::to_string(n));
+    }
+    for (int i = 0; i < kArmDof; ++i) {
+      armTargetQpos(i) = qpos[7 + i];  // segment(7, 6)
+    }
+  }
+
+  const auto& model = pinocchioInterface_.getModel();
+  pinocchio::Data data(model);
+  pinocchio::forwardKinematics(model, data, armTargetQpos);
+  pinocchio::updateFramePlacements(model, data);
+
+  // Extended stateTrajectory format: [joints(6), ee_pos(3), ee_quat(4, xyzw)].
+  // EndEffectorConstraint reads the EE pose from tail(7); head(6) is the joint
+  // reference for QuadraticJointStateCost (aligned with RosReferenceManager L140-141).
+  const Eigen::Quaterniond quaternion(data.oMf[eeFrameId_].rotation());
+  const vector_t target = (vector_t(armTargetQpos.size() + 7) << armTargetQpos,
+                           data.oMf[eeFrameId_].translation(), quaternion.coeffs())
+                              .finished();
+
+  // Scheme A: stamp with reception wall-clock, NOT the publisher stamp in qpos[14].
+  // A publisher stamp can arrive slightly in the past and be treated as expired by
+  // MPC; reception time is always >= MPC's currentObservation.time (RosReferenceManager L143-147).
+  const double receiveTime =
+      std::chrono::duration<double>(std::chrono::system_clock::now().time_since_epoch()).count();
+
+  const scalar_array_t desiredTimeTrajectory{receiveTime};
+  const vector_array_t desiredStateTrajectory{target};
+  const vector_array_t desiredInputTrajectory{vector_t::Zero(model.nv)};
+  return TargetTrajectories(desiredTimeTrajectory, desiredStateTrajectory, desiredInputTrajectory);
+}
+
+}  // namespace nonros
+}  // namespace mobile_manipulator
+}  // namespace ocs2
