+struct CsvRow {
+    double timestamp, recv_wall, recv_mono, t0, t1, t3, t5, end_wall;
+    double propag_time, kf_solve_time, coord_xform_time;
+    int    feats_down_size;
+    int    feats_undistort_size;
+    int    raw_pts_size;
+    double queue_wait, s_plot11;
+};
+
+static constexpr int CSV_RING_SIZE = 1024;  // must be power-of-2
+struct CsvRing {
+    CsvRow  buf[CSV_RING_SIZE];
+    // Each counter on its own cache line to prevent false sharing between
+    // the producer (algo thread, P-core) and consumer (CSV thread, E-core).
+    alignas(64) std::atomic<uint32_t> head{0};  // written by producer
+    alignas(64) std::atomic<uint32_t> tail{0};  // written by consumer
+} g_csv_ring;
+
+FILE                   *g_csv_fp        = nullptr;
+std::thread             g_csv_thread;
+std::atomic<bool>       g_csv_stop{false};
+std::atomic<uint32_t>   g_csv_drop_count{0};
+
+static bool pin_csv_thread(pthread_t tid) {
+#if !defined(PROFILING_CSV_CPU)
+    return false;
+#else
+    int target = PROFILING_CSV_CPU;
+    if (target >= 0) {
+        cpu_set_t s; CPU_ZERO(&s); CPU_SET(target, &s);
+        return pthread_setaffinity_np(tid, sizeof(s), &s) == 0;
+    }
+    cpu_set_t proc_set;
+    if (pthread_getaffinity_np(pthread_self(), sizeof(proc_set), &proc_set) != 0)
+        return false;
+    int ncpus = (int)sysconf(_SC_NPROCESSORS_ONLN);
+    for (int c = 0; c < ncpus; ++c) {
+        if (!CPU_ISSET(c, &proc_set)) {
+            cpu_set_t s; CPU_ZERO(&s); CPU_SET(c, &s);
+            return pthread_setaffinity_np(tid, sizeof(s), &s) == 0;
+        }
+    }
+    return false;
+#endif
+}
+
+static constexpr int CSV_BATCH = 64;  // rows to drain per wakeup
+
+static void csv_writer_thread() {
+    uint32_t last_seen_drops = 0;
+    char line_buf[CSV_BATCH][256];
+    while (true) {
+        uint32_t t = g_csv_ring.tail.load(std::memory_order_acquire);
+        uint32_t h = g_csv_ring.head.load(std::memory_order_acquire);
+        if (t == h) {
+            uint32_t drops = g_csv_drop_count.load(std::memory_order_relaxed);
+            if (drops != last_seen_drops) {
+                fprintf(stderr, "[PROFILING] WARNING: CSV ring buffer overflow, dropped %u row(s) so far\n",
+                        drops);
+                last_seen_drops = drops;
+            }
+            if (g_csv_stop.load(std::memory_order_acquire)) break;
+            struct timespec ts{1, 0};  // 1 s — reduces IO wakeups; ring holds 1024 rows
+            nanosleep(&ts, nullptr);
+            continue;
+        }
+        // Drain up to CSV_BATCH rows into line_buf, then fputs once each.
+        int n = 0;
+        while (n < CSV_BATCH) {
+            t = g_csv_ring.tail.load(std::memory_order_acquire);
+            h = g_csv_ring.head.load(std::memory_order_acquire);
+            if (t == h) break;
+            const CsvRow &r = g_csv_ring.buf[t & (CSV_RING_SIZE - 1)];
+            n += snprintf(line_buf[n], sizeof(line_buf[n]),
+                "%0.9f,%0.9f,%0.9f,%0.9f,%0.9f,%0.9f,%0.9f,%0.9f,%0.9f,%0.9f,%0.9f,%d,%d,%d,%0.9f,%0.9f\n",
+                r.timestamp, r.recv_wall, r.recv_mono, r.t0, r.t1, r.t3, r.t5, r.end_wall,
+                r.propag_time, r.kf_solve_time, r.coord_xform_time,
+                r.feats_down_size, r.feats_undistort_size, r.raw_pts_size, r.queue_wait, r.s_plot11) > 0 ? 1 : 0;
+            g_csv_ring.tail.store(t + 1, std::memory_order_release);
+        }
+        for (int i = 0; i < n; ++i) fputs(line_buf[i], g_csv_fp);
+    }
+    fflush(g_csv_fp);
+    uint32_t total_drops = g_csv_drop_count.load(std::memory_order_relaxed);
+    if (total_drops > 0) {
+        fprintf(g_csv_fp, "# WARNING: %u row(s) dropped due to ring buffer overflow\n", total_drops);
+        fprintf(stderr, "[PROFILING] WARNING: total CSV rows dropped = %u\n", total_drops);
+        fflush(g_csv_fp);
+    }
+}
+
+static inline void csv_push(const CsvRow &row) {
+    uint32_t h = g_csv_ring.head.load(std::memory_order_relaxed);
+    uint32_t t = g_csv_ring.tail.load(std::memory_order_acquire);
+    if (h - t >= CSV_RING_SIZE) {
+        g_csv_drop_count.fetch_add(1, std::memory_order_relaxed);
+        return;
+    }
+    g_csv_ring.buf[h & (CSV_RING_SIZE - 1)] = row;
+    g_csv_ring.head.store(h + 1, std::memory_order_release);
+}
