+static inline void csv_push(const CsvRow & row)
+{
+  uint32_t h = g_csv_ring.head.load(std::memory_order_relaxed);
+  uint32_t t = g_csv_ring.tail.load(std::memory_order_acquire);
+  if (h - t >= CSV_RING_SIZE) {
+    g_csv_drop_count.fetch_add(1, std::memory_order_relaxed);
+    return;
+  }
+  g_csv_ring.buf[h & (CSV_RING_SIZE - 1)] = row;
+  g_csv_ring.head.store(h + 1, std::memory_order_release);
 }
