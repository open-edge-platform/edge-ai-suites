+class _VLSelfAttentionMaskedWrapper(nn.Module):
+    """Wraps SelfAttentionTransformer to accept a key-padding mask.
+
+    The native SelfAttentionTransformer does not expose an attention_mask
+    argument; for static-shape inference with padded sequences we need to
+    prevent padding tokens from polluting valid-token outputs. This wrapper
+    converts a (B, L) bool/int padding mask into an additive (B, 1, 1, L)
+    mask of 0 / -inf and feeds it into each transformer block's attn1.
+    """
+
+    def __init__(self, vl_sa: nn.Module):
+        super().__init__()
+        self.vl_sa = vl_sa
+
+    def forward(self, hidden_states: torch.Tensor, attention_mask: torch.Tensor) -> torch.Tensor:
+        # attention_mask: (B, L) where 1 = valid, 0 = padding
+        mask_bool = attention_mask.to(torch.bool)
+        # Build additive mask: 0 for valid keys, -inf for padded keys
+        additive = torch.zeros_like(mask_bool, dtype=hidden_states.dtype)
+        neg_inf = torch.finfo(hidden_states.dtype).min
+        additive = torch.where(mask_bool, additive, torch.full_like(additive, neg_inf))
+        # Shape required by SDPA: (B, 1, 1, L)
+        additive = additive[:, None, None, :]
+
+        hidden_states = hidden_states.contiguous()
+        for block in self.vl_sa.transformer_blocks:
+            hidden_states = block(hidden_states, attention_mask=additive)
+        return hidden_states
+
