+def _resolve_single_ov_xml(ov_model_path: Path) -> Path:
+    xml_files = sorted(ov_model_path.glob("*.xml"))
+    if not xml_files:
+        raise FileNotFoundError(f"No XML model found under OpenVINO directory: {ov_model_path}")
+    if len(xml_files) > 1:
+        names = [path.name for path in xml_files]
+        raise ValueError(
+            f"Multiple XML models found under OpenVINO directory {ov_model_path}: {names}. "
+            "Single-OV mode expects exactly one XML."
+        )
+    return xml_files[0]
+
+
+def _gr00t_get_action_single_ov(policy_model, inputs, options=None):
+    if not hasattr(policy_model, "_single_ov_timing_stats"):
+        policy_model._single_ov_timing_stats = {}
+    timing = policy_model._single_ov_timing_stats
+
+    backbone_inputs, action_inputs = policy_model.prepare_input(inputs)
+
+    input_ids = backbone_inputs["input_ids"]
+    attention_mask = backbone_inputs["attention_mask"]
+    pixel_values = backbone_inputs["pixel_values"]
+    image_grid_thw = backbone_inputs.get("image_grid_thw")
+
+    state = action_inputs["state"]
+    embodiment_id = action_inputs["embodiment_id"]
+    if embodiment_id.dtype != torch.int64:
+        embodiment_id = embodiment_id.to(torch.int64)
+
+    if input_ids.shape[0] != 1:
+        raise ValueError("single-OV inference currently supports batch size 1 observations only")
+
+    inner_model = policy_model.backbone.model.model
+    t0 = time.perf_counter()
+    position_ids, rope_deltas = inner_model.get_rope_index(
+        input_ids,
+        image_grid_thw,
+        video_grid_thw=None,
+        attention_mask=attention_mask,
+    )
+    inner_model.rope_deltas = rope_deltas
+    timing["rope_prep"] = time.perf_counter() - t0
+
+    valid_mask = attention_mask[0] == 1
+    if not valid_mask.all():
+        input_ids = input_ids[:, valid_mask]
+        attention_mask = attention_mask[:, valid_mask]
+        position_ids = position_ids[:, :, valid_mask]
+
+    action_head_config = policy_model.action_head.config
+    actions = torch.randn(
+        input_ids.shape[0],
+        action_head_config.action_horizon,
+        action_head_config.max_action_dim,
+        dtype=torch.float32,
+        device=input_ids.device,
+    )
+
+    if isinstance(pixel_values, (list, tuple)):
+        pixel_values = torch.cat(pixel_values, dim=0)
+
+    ov_inputs = {
+        "input_ids": input_ids.detach().cpu().to(torch.int64).numpy(),
+        "attention_mask": attention_mask.detach().cpu().to(torch.int64).numpy(),
+        "pixel_values": pixel_values.detach().cpu().to(torch.float32).numpy(),
+        "position_ids": position_ids.detach().cpu().to(torch.int64).numpy(),
+        "state": state.detach().cpu().to(torch.float32).numpy(),
+        "embodiment_id": embodiment_id.detach().cpu().numpy(),
+        "actions": actions.detach().cpu().numpy(),
+    }
+
+    t0 = time.perf_counter()
+    compiled_model = policy_model._single_ov_compiled
+    outputs = compiled_model(ov_inputs)
+    output_port = compiled_model.outputs[0]
+    action_pred_np = outputs[output_port]
+    timing["single_ov_inference"] = time.perf_counter() - t0
+
+    action_pred = torch.from_numpy(action_pred_np) if isinstance(action_pred_np, np.ndarray) else action_pred_np
+    return BatchFeature(data={"action_pred": action_pred})
+
+
+def setup_openvino_models_n1d7_single(policy, ov_model_path, device="GPU", static_shape=False):
+    """Compile a single fused OpenVINO IR and route ``policy.model.get_action`` through it.
+
+    The IR is the one produced by ``export_ov_n1d7_single_ov.py``; it bundles ViT,
+    LLM, VL self-attention, state encoder, and DiT into one graph. Heavy PyTorch
+    submodules are deleted to free memory; only the bits needed for input prep
+    (rope index, embed lookups via ``inner_model.get_rope_index``) remain.
+    """
+    ov_model_path = Path(ov_model_path)
+    print("[OpenVINO Single Setup] Deleting PyTorch heavy submodules to save memory...")
+    if hasattr(policy.model.backbone.model.model, "visual"):
+        del policy.model.backbone.model.model.visual
+    language_model = getattr(policy.model.backbone.model.model, "language_model", None)
+    if language_model is not None and hasattr(language_model, "layers"):
+        del language_model.layers
+    if hasattr(policy.model.action_head, "state_encoder"):
+        del policy.model.action_head.state_encoder
+    if hasattr(policy.model.action_head, "action_encoder"):
+        del policy.model.action_head.action_encoder
+    if hasattr(policy.model.action_head, "model"):
+        del policy.model.action_head.model
+    if hasattr(policy.model.action_head, "action_decoder"):
+        del policy.model.action_head.action_decoder
+    if hasattr(policy.model.action_head, "vlln"):
+        del policy.model.action_head.vlln
+    print("✓ Deleted PyTorch submodules")
