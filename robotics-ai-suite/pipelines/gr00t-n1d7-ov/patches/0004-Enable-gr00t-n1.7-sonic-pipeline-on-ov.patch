+#!/usr/bin/env python3
+"""Copy necessary config files from checkpoint to OpenVINO IR directory.
+
+This allows running inference without specifying --model-path.
+
+Usage:
+    python scripts/deployment/copy_configs_to_ov.py \
+        --checkpoint-dir checkpoints/GR00T-N1.7-G1 \
+        --ov-dir checkpoints/ov_export_g1
+"""
+
+import argparse
+from pathlib import Path
+import shutil
+
+
+def copy_configs(checkpoint_dir: str, ov_dir: str, overwrite: bool = False) -> None:
+    """Copy config files from checkpoint to OV directory/config subdirectory."""
+    checkpoint_path = Path(checkpoint_dir)
+    ov_path = Path(ov_dir)
+
+    if not checkpoint_path.is_dir():
+        raise FileNotFoundError(f"Checkpoint directory not found: {checkpoint_dir}")
+
+    if not ov_path.is_dir():
+        raise FileNotFoundError(f"OpenVINO directory not found: {ov_dir}")
+
+    config_dir = ov_path / "config"
+    config_dir.mkdir(parents=True, exist_ok=True)
+    print(f"Created config directory: {config_dir}\n")
+
+    config_files = [
+        "processor_config.json",
+        "statistics.json",
+        "embodiment_id.json",
+        "config.json",
+        "model.safetensors.index.json",
+    ]
+
+    copied = []
+    skipped = []
+
+    for filename in config_files:
+        src = checkpoint_path / filename
+        dst = config_dir / filename
+
+        if not src.exists():
+            print(f"{filename}: not found in checkpoint (skipping)")
+            continue
+
+        if dst.exists() and not overwrite:
+            print(f"{filename}: already exists in config/ (use --overwrite to replace)")
+            skipped.append(filename)
+            continue
+
+        shutil.copy2(src, dst)
+        print(f"Copied {filename} to config/")
+        copied.append(filename)
+
+    print("\n" + "=" * 60)
+    print("Summary:")
+    print(f"  Copied: {len(copied)} files to {config_dir}")
+    if copied:
+        print(f"    {', '.join(copied)}")
+    if skipped:
+        print(f"  Skipped: {len(skipped)} files (already exist)")
+        print(f"    {', '.join(skipped)}")
+    print(f"  Target: {ov_path}")
+    print("=" * 60)
+
+    if "processor_config.json" in copied or (
+        "processor_config.json" in skipped and (config_dir / "processor_config.json").exists()
+    ):
+        print("\nYou can now run inference without --model-path:")
+        print("  python scripts/deployment/run_base_single_ov_inference.py \\")
+        print(f"    --ov-model-dir {ov_dir} \\")
+        print("    --embodiment-tag YOUR_TAG \\")
+        print("    --device GPU")
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(
+        description="Copy config files from checkpoint to OpenVINO IR directory",
+        formatter_class=argparse.RawTextHelpFormatter,
+    )
+    parser.add_argument(
+        "--checkpoint-dir",
+        type=str,
+        required=True,
+        help="Source checkpoint directory containing config files",
+    )
+    parser.add_argument(
+        "--ov-dir",
+        type=str,
+        required=True,
+        help="Target OpenVINO IR directory",
+    )
+    parser.add_argument(
+        "--overwrite",
+        action="store_true",
+        help="Overwrite existing config files in OV directory",
+    )
+
+    args = parser.parse_args()
+    copy_configs(args.checkpoint_dir, args.ov_dir, args.overwrite)
+
+
+if __name__ == "__main__":
+    main()
\ No newline at end of file
