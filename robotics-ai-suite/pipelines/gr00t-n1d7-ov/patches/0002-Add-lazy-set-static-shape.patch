+class _LazyStaticReshapeModel:
+    """Wrapper around an ov.Model that defers compile until first call.
+
+    On first inference, it reshapes the model to the actual input shapes
+    captured from the call, then compiles. Subsequent calls use the
+    static-shape compiled model directly.
+    """
+
+    def __init__(self, core, ov_model, component_name: str, device: str):
+        self._core = core
+        self._ov_model = ov_model
+        self._component_name = component_name
+        self._device = device
+        self._compiled = None
+
+    def _ensure_compiled(self, shapes: dict[str, list[int]]) -> None:
+        if self._compiled is not None:
+            return
+        logger.info(
+            "  [static] reshaping %s to %s and compiling on %s",
+            self._component_name,
+            shapes,
+            self._device,
+        )
+        self._ov_model.reshape(shapes)
+        self._compiled = self._core.compile_model(self._ov_model, device_name=self._device)
+
+    def _shapes_from_inputs(self, inputs) -> dict[str, list[int]]:
+        result: dict[str, list[int]] = {}
+        if isinstance(inputs, dict):
+            iterator = inputs.items()
+        else:
+            ports = list(self._ov_model.inputs)
+            if len(ports) != len(inputs):
+                raise ValueError(
+                    f"Expected {len(ports)} inputs for {self._component_name}, got {len(inputs)}"
+                )
+            iterator = []
+            for port, value in zip(ports, inputs):
+                try:
+                    name = port.get_node().get_friendly_name()
+                except RuntimeError:
+                    name = ""
+                if not name or name.isdigit():
+                    try:
+                        name = port.get_any_name()
+                    except RuntimeError:
+                        name = ""
+                iterator.append((name, value))
+        for name, value in iterator:
+            result[name] = list(np.asarray(value).shape)
+        return result
+
+    def __call__(self, inputs):
+        self._ensure_compiled(self._shapes_from_inputs(inputs))
+        return self._compiled(inputs)
+
+    def get_property(self, name):
+        if self._compiled is None:
+            return f"<uncompiled {self._component_name}>"
+        return self._compiled.get_property(name)
+
+    @property
+    def inputs(self):
+        if self._compiled is not None:
+            return self._compiled.inputs
+        return self._ov_model.inputs
+
+    @property
+    def outputs(self):
+        if self._compiled is not None:
+            return self._compiled.outputs
+        return self._ov_model.outputs
+
+
+def _load_compiled_model(
+    core, ov_model_path: Path, component_name: str, precision_suffix: str, device: str,
+    static_shape: bool = False,
+):
     model_path = ov_model_path / f"{component_name}_{precision_suffix}.xml"
     if not model_path.exists():
         raise FileNotFoundError(f"Expected model file not found: {model_path}")
     model = core.read_model(str(model_path))
-    return core.compile_model(model, device_name=device)
+    return _compile_or_lazy(core, model, component_name, device, static_shape=static_shape)
+
+
+def _compile_or_lazy(core, ov_model, component_name: str, device: str, static_shape: bool = False):
+    if static_shape:
+        return _LazyStaticReshapeModel(core, ov_model, component_name, device)
+    return core.compile_model(ov_model, device_name=device)
 
 
