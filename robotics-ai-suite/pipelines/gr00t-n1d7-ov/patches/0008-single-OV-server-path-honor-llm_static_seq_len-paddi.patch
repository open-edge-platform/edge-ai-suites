From 65882f292d1d3937d2de487f7ea74da99b77835c Mon Sep 17 00:00:00 2001
From: yichongt <yichong.tang@intel.com>
Date: Tue, 25 Aug 2026 18:18:35 +0800
Subject: [PATCH] single-OV server path: honor llm_static_seq_len padding

setup_openvino_models_n1d7_single reads llm_static_seq_len from the
single-OV export metadata and assigns it to the policy model, and
_gr00t_get_action_single_ov pads input_ids/attention_mask/position_ids
to that static length. Add _load_single_ov_metadata() to find the
{output_name}_metadata.json written by export_ov_n1d7_single_ov.py.
---
 scripts/deployment/ov_n1d7_forward.py | 58 +++++++++++++++++++++++++++
 1 file changed, 58 insertions(+)

diff --git a/scripts/deployment/ov_n1d7_forward.py b/scripts/deployment/ov_n1d7_forward.py
index b30c6d8330c8..51615433ae93 100644
--- a/scripts/deployment/ov_n1d7_forward.py
+++ b/scripts/deployment/ov_n1d7_forward.py
@@ -230,6 +230,27 @@ def _load_llm_static_seq_len(ov_model_path: Path) -> int | None:
     return meta.get("llm_static_seq_len")
 
 
+def _load_single_ov_metadata(ov_model_path: Path, xml_path: Path) -> dict:
+    """Read single-OV export metadata next to the merged XML model.
+
+    ``export_ov_n1d7_single_ov.py`` writes ``{output_name}_metadata.json``, e.g.
+    ``gr00t_n1d7_single_from_ov_metadata.json`` next to
+    ``gr00t_n1d7_single_from_ov_fp16.xml``.  ONNX-first exports write
+    ``gr00t_n1d7_single_metadata.json`` instead.  Falls back to
+    ``export_metadata.json`` for directories that only carry that file.
+    """
+    candidates = [
+        ov_model_path / f"{xml_path.stem}_metadata.json",
+        ov_model_path / f"{xml_path.stem.rsplit('_', 1)[0]}_metadata.json",
+        ov_model_path / "export_metadata.json",
+    ]
+    for candidate in candidates:
+        if candidate.exists():
+            with open(candidate) as f:
+                return json.load(f)
+    return {}
+
+
 def _should_use_fused_dit(ov_model_path: Path, precision_suffix: str, requested: bool) -> bool:
     if not requested:
         return False
@@ -1250,6 +1271,33 @@ def _gr00t_get_action_single_ov(policy_model, inputs, options=None):
         attention_mask = attention_mask[:, valid_mask]
         position_ids = position_ids[:, :, valid_mask]
 
+    # Pad to the static LLM seq_len baked in at export time (--llm-lang-tokens)
+    # so a --static-shape compiled model always sees the same fixed sequence
+    # length regardless of the prompt's language-token count.  Zeros mark the
+    # padding in attention_mask, exactly like the exporter's example inputs.
+    llm_static_seq_len = getattr(policy_model.backbone, "llm_static_seq_len", None)
+    if llm_static_seq_len is not None:
+        cur_len = input_ids.shape[1]
+        if cur_len > llm_static_seq_len:
+            raise ValueError(
+                f"Input seq_len ({cur_len}) exceeds the static LLM seq_len ({llm_static_seq_len}) "
+                "baked into the exported model. Re-export with a larger --llm-lang-tokens."
+            )
+        if cur_len < llm_static_seq_len:
+            pad = llm_static_seq_len - cur_len
+            input_ids = torch.cat(
+                [input_ids, torch.zeros(input_ids.shape[0], pad, dtype=input_ids.dtype, device=input_ids.device)],
+                dim=1,
+            )
+            attention_mask = torch.cat(
+                [attention_mask, torch.zeros(attention_mask.shape[0], pad, dtype=attention_mask.dtype, device=attention_mask.device)],
+                dim=1,
+            )
+            position_ids = torch.cat(
+                [position_ids, torch.zeros(position_ids.shape[0], position_ids.shape[1], pad, dtype=position_ids.dtype, device=position_ids.device)],
+                dim=2,
+            )
+
     action_head_config = policy_model.action_head.config
     actions = torch.randn(
         input_ids.shape[0],
@@ -1312,6 +1360,16 @@ def setup_openvino_models_n1d7_single(policy, ov_model_path, device="GPU", stati
 
     xml_path = _resolve_single_ov_xml(ov_model_path)
     print(f"[OpenVINO Single Setup] Loading single OV model: {xml_path}")
+
+    metadata = _load_single_ov_metadata(ov_model_path, xml_path)
+    llm_static_seq_len = metadata.get("llm_static_seq_len")
+    policy.model.backbone.llm_static_seq_len = llm_static_seq_len
+    if llm_static_seq_len is not None:
+        print(
+            f"  Static LLM seq_len: {llm_static_seq_len} "
+            "(server inputs will be padded to this length)"
+        )
+
     core = ov.Core()
     cache_dir = ov_model_path.parent / ".ov_cache"
     cache_dir.mkdir(parents=True, exist_ok=True)
-- 
