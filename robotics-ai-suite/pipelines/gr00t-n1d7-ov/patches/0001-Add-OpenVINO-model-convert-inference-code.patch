+def _flatten_tensor_outputs(outputs: Any) -> list[torch.Tensor]:
+    if isinstance(outputs, torch.Tensor):
+        return [outputs.detach().float().flatten().cpu()]
+    if isinstance(outputs, (tuple, list)):
+        flattened = []
+        for output in outputs:
+            flattened.extend(_flatten_tensor_outputs(output))
+        return flattened
+    raise TypeError(f"Unsupported output type for verification: {type(outputs)!r}")
+
+
+def _log_ov_vs_pytorch(label: str, ov_model: ov.Model, input_names: list[str], example_inputs, pytorch_outputs):
+    core = ov.Core()
+    compiled = core.compile_model(ov_model, "CPU")
+    ov_arrays = [tensor.detach().cpu().numpy() for tensor in example_inputs]
+
+    ov_inputs = {}
+    for requested_name, port, array in zip(input_names, compiled.inputs, ov_arrays):
+        port_names = list(port.get_names())
+        if requested_name in port_names:
+            ov_inputs[requested_name] = array
+        elif port_names:
+            ov_inputs[next(iter(port_names))] = array
+        else:
+            ov_inputs = {}
+            break
+
+    if ov_inputs and len(ov_inputs) == len(ov_arrays):
+        ov_result = compiled(ov_inputs)
+    else:
+        ov_result = compiled(ov_arrays)
+
+    pt_parts = _flatten_tensor_outputs(pytorch_outputs)
+    ov_parts = [torch.tensor(ov_result[output]).float().flatten() for output in compiled.outputs]
+
+    pt_flat = torch.cat(pt_parts) if len(pt_parts) > 1 else pt_parts[0]
+    ov_flat = torch.cat(ov_parts) if len(ov_parts) > 1 else ov_parts[0]
+
+    cosine = torch.nn.functional.cosine_similarity(pt_flat.unsqueeze(0), ov_flat.unsqueeze(0)).item()
+    mae = torch.mean(torch.abs(pt_flat - ov_flat)).item()
+    logger.info("  %s vs PyTorch: cosine=%.8f mae=%.8e", label, cosine, mae)
+    return cosine, mae
+
+
+def build_dense_token_delta(
+    visual_pos_masks: torch.Tensor,
+    visual_embeds: torch.Tensor,
+    batch_size: int,
+    device: torch.device | str,
+    dtype: torch.dtype,
+) -> torch.Tensor:
+    mask = visual_pos_masks.to(device=device, dtype=torch.bool)
+    if mask.shape[0] == 1 and batch_size > 1:
+        mask = mask.expand(batch_size, -1)
+
+    visual_embeds = visual_embeds.to(device=device, dtype=dtype)
+    if visual_embeds.ndim == 2:
+        visual_embeds = visual_embeds.unsqueeze(0).expand(batch_size, -1, -1)
+    elif visual_embeds.shape[0] == 1 and batch_size > 1:
+        visual_embeds = visual_embeds.expand(batch_size, -1, -1)
+
+    token_indices = torch.cumsum(mask.to(torch.int64), dim=1) - 1
+    token_indices = torch.clamp(token_indices, min=0)
+    gather_index = token_indices.unsqueeze(-1).expand(-1, -1, visual_embeds.shape[-1])
+    gathered = torch.gather(visual_embeds, 1, gather_index)
+    return gathered * mask.unsqueeze(-1).to(dtype)
+
