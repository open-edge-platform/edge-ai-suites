+# ============================================================
+# Export Functions: Action Head Components to OpenVINO IR
+# ============================================================
+
+def export_vl_self_attention_to_ov(
+    policy,
+    output_dir,
+    vl_seq_len,
+    use_fp32=True,
+    batch_size=1,
+    captured_hidden_states=None,
+):
+    """Export the vl_self_attention to OpenVINO IR."""
+    vl_sa = policy.model.action_head.vl_self_attention
+    if isinstance(vl_sa, nn.Identity):
+        logger.info("  vl_self_attention is Identity — skipping export")
+        return None
+
+    logger.info("\n" + "=" * 80)
+    logger.info("Exporting VL Self-Attention to OpenVINO IR")
+    logger.info("=" * 80)
+
+    config = policy.model.action_head.config
+    dtype = torch.float32 if use_fp32 else torch.bfloat16
+    device = _get_device()
+    model = vl_sa.to(dtype).eval().to(device)
+
+    if captured_hidden_states is not None:
+        hidden_states = captured_hidden_states.to(device=device, dtype=dtype)
+        if batch_size > 1 and hidden_states.shape[0] == 1:
+            hidden_states = hidden_states.expand(batch_size, -1, -1)
+    else:
+        hidden_states = torch.randn(
+            batch_size, vl_seq_len, config.backbone_embedding_dim, dtype=dtype, device=device
+        )
+
+    with torch.inference_mode():
+        baseline_output = model(hidden_states)
+
+    baseline_flat = baseline_output.detach().float().flatten().cpu()
+
+    precision_tag = "fp32" if not _COMPRESS_TO_FP16 else "fp16"
+    output_path = os.path.join(output_dir, f"vl_self_attention_{precision_tag}.xml")
+    os.makedirs(os.path.dirname(output_path), exist_ok=True)
+
+    logger.info(f"  Converting to OpenVINO IR: {output_path}...")
+    with torch.inference_mode():
+        ov_model = ov.convert_model(model, example_input=[hidden_states])
+
+    core = ov.Core()
+    compiled = core.compile_model(ov_model, "CPU")
+    ov_result = compiled([hidden_states.detach().cpu().numpy()])
+    ov_output = torch.tensor(ov_result[compiled.output(0)]).float().flatten()
+
+    direct_cosine = torch.nn.functional.cosine_similarity(
+        baseline_flat.unsqueeze(0), ov_output.unsqueeze(0)
+    ).item()
+    direct_mae = torch.mean(torch.abs(baseline_flat - ov_output)).item()
+    logger.info(
+        "  Direct OV vs PyTorch: cosine=%.8f mae=%.8e",
+        direct_cosine,
+        direct_mae,
+    )
+
+    ov.save_model(ov_model, output_path, compress_to_fp16=_COMPRESS_TO_FP16)
