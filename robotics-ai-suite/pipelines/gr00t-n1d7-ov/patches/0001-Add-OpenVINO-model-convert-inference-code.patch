+#!/usr/bin/env python3
+"""Run base-model inference against a single OpenVINO GR00T N1.7 IR.
+
+This script mirrors `run_base_ov_inference.py`, but targets the single-model
+IR exported by `export_ov_n1d7_single_ov.py` instead of the split-component OV
+backend.
+
+Usage:
+    python scripts/deployment/run_base_single_ov_inference.py \
+        --model-path checkpoints/GR00T-N1.7-3B \
+        --ov-model-dir checkpoints/gr00t_n1d7_ov_g1 \
+        --embodiment-tag REAL_G1 \
+        --num-samples 5 \
+        --device CPU
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import logging
+import sys
+import time
+from pathlib import Path
+from typing import Any
+
+import numpy as np
+import openvino as ov
+import torch
+
+script_dir = Path(__file__).parent
+if str(script_dir) not in sys.path:
+    sys.path.insert(0, str(script_dir))
+
+from gr00t.data.embodiment_tags import EmbodimentTag
+from gr00t.data.types import MessageType, ModalityConfig
+from gr00t.policy.gr00t_policy import Gr00tPolicy, _rec_to_dtype
+
+
+logging.basicConfig(level=logging.INFO, format="%(asctime)s - %(levelname)s - %(message)s")
+logger = logging.getLogger(__name__)
+
+
+class _RuntimeLLMInputCapture:
+    def __init__(self):
+        self.position_ids: torch.Tensor | None = None
+        self.attention_mask: torch.Tensor | None = None
+
+    def hook_fn(self, module, args, kwargs):
+        if self.position_ids is None:
+            position_ids = kwargs.get("position_ids")
+            if position_ids is not None:
+                self.position_ids = position_ids.detach().cpu().clone()
+        if self.attention_mask is None:
+            attention_mask = kwargs.get("attention_mask")
+            if attention_mask is not None:
+                self.attention_mask = attention_mask.detach().cpu().clone()
+
+
+def _load_policy_cpu_fp32(model_path: str, embodiment_tag: EmbodimentTag) -> Gr00tPolicy:
+    try:
+        return Gr00tPolicy(
+            model_path=model_path,
+            embodiment_tag=embodiment_tag,
+            device="cpu",
+            enable_ov=True,
+        )
+    except TypeError as exc:
+        if "enable_ov" not in str(exc):
+            raise
+
+        logger.warning(
+            "Gr00tPolicy in this environment does not support enable_ov; falling back to legacy CPU load and forcing FP32"
+        )
+        policy = Gr00tPolicy(model_path=model_path, embodiment_tag=embodiment_tag, device="cpu")
+        policy.model.to(device="cpu", dtype=torch.float32)
+        if hasattr(policy, "model_dtype"):
+            policy.model_dtype = torch.float32
+        return policy
+
+
+def resolve_ov_model_xml(ov_model_dir: str) -> str:
+    """Resolve the single OpenVINO XML model file from a directory."""
+    model_dir = Path(ov_model_dir)
+    if not model_dir.is_dir():
+        raise FileNotFoundError(f"OpenVINO model directory not found: {ov_model_dir}")
+
+    xml_files = sorted(model_dir.glob("*.xml"))
+    if not xml_files:
+        raise FileNotFoundError(f"No XML model found under OpenVINO directory: {ov_model_dir}")
+    if len(xml_files) > 1:
+        available = [path.name for path in xml_files]
+        raise ValueError(
+            f"Multiple XML models found under OpenVINO directory {ov_model_dir}: {available}. "
+            "Please keep only one XML in the directory."
+        )
+    return str(xml_files[0])
+
+
+def load_modality_configs_from_checkpoint(model_path: str, embodiment_tag: str):
+    """Load modality configs directly from the checkpoint's processor_config.json."""
+    processor_config_path = Path(model_path) / "processor_config.json"
+    if not processor_config_path.exists():
+        raise FileNotFoundError(f"processor_config.json not found in {model_path}")
+
+    with open(processor_config_path) as file_obj:
+        config = json.load(file_obj)
+
+    tag_enum = EmbodimentTag.resolve(embodiment_tag)
+    tag_value = tag_enum.value
+
+    all_configs = config["processor_kwargs"]["modality_configs"]
+    if tag_value not in all_configs:
+        available = list(all_configs.keys())
+        raise ValueError(
+            f"Embodiment '{embodiment_tag}' (value='{tag_value}') not found in checkpoint. "
+            f"Available: {available}"
+        )
+
+    raw = all_configs[tag_value]
+    return {
+        "video": ModalityConfig(
+            delta_indices=raw["video"]["delta_indices"],
+            modality_keys=raw["video"]["modality_keys"],
+        ),
+        "state": ModalityConfig(
+            delta_indices=raw["state"]["delta_indices"],
+            modality_keys=raw["state"]["modality_keys"],
+        ),
+        "action": ModalityConfig(
+            delta_indices=raw["action"]["delta_indices"],
+            modality_keys=raw["action"]["modality_keys"],
+        ),
+        "language": ModalityConfig(
+            delta_indices=raw["language"]["delta_indices"],
+            modality_keys=raw["language"]["modality_keys"],
+        ),
+    }
+
+
+def load_state_dimensions(model_path: str, embodiment_tag: str) -> dict[str, int]:
+    """Load per-key state dimensions from statistics.json."""
+    stats_path = Path(model_path) / "statistics.json"
+    if not stats_path.exists():
+        return {}
+
+    with open(stats_path) as file_obj:
+        stats = json.load(file_obj)
+
+    tag_enum = EmbodimentTag.resolve(embodiment_tag)
+    tag_value = tag_enum.value
+    if tag_value not in stats:
+        return {}
+
+    dims: dict[str, int] = {}
+    tag_stats = stats[tag_value]
+    if "state" in tag_stats:
+        for key, value in tag_stats["state"].items():
+            if isinstance(value, dict) and "mean" in value:
+                dims[key] = len(value["mean"])
+    return dims
+
+
+def _infer_feature_dim_from_stats(norm_stats: Any, fallback: int) -> int:
+    if norm_stats is None:
+        return fallback
+    for attr_name in ("mean", "std", "min", "max"):
+        attr = getattr(norm_stats, attr_name, None)
+        if attr is None and isinstance(norm_stats, dict):
+            attr = norm_stats.get(attr_name)
+        if attr is not None:
+            try:
+                return int(np.asarray(attr).shape[-1])
+            except Exception:
+                continue
+    return fallback
+
+
+def _build_dummy_observation(policy: Gr00tPolicy) -> dict[str, Any]:
+    modality_configs = policy.get_modality_config()
+    observation: dict[str, Any] = {"video": {}, "state": {}, "language": {}}
+    state_norm_params = getattr(policy.processor.state_action_processor, "norm_params", {})
+    embodiment_key = policy.embodiment_tag.value
+    embodiment_state_params = state_norm_params.get(embodiment_key, {}).get("state", {})
+    state_horizon = len(modality_configs["state"].delta_indices)
+    video_horizon = len(modality_configs["video"].delta_indices)
+    language_horizon = len(modality_configs["language"].delta_indices)
+
+    for key in modality_configs["state"].modality_keys:
+        dims = 1
+        if key in embodiment_state_params:
+            dim_value = embodiment_state_params[key].get("dim")
+            if dim_value is not None:
+                dims = int(np.asarray(dim_value).item())
+            else:
+                dims = _infer_feature_dim_from_stats(embodiment_state_params[key], fallback=1)
+        state_value = np.zeros((1, state_horizon, dims), dtype=np.float32)
+        if dims >= 9 and "eef" in key:
+            state_value[..., 3] = 1.0
+            state_value[..., 7] = 1.0
+        observation["state"][key] = state_value
+
+    for key in modality_configs["video"].modality_keys:
+        observation["video"][key] = np.zeros((1, video_horizon, 224, 224, 3), dtype=np.uint8)
+
+    default_text = "Pick and place the object."
+    for key in modality_configs["language"].modality_keys:
+        observation["language"][key] = [[default_text for _ in range(language_horizon)]]
+    return observation
+
+
+def create_dummy_observation(
+    policy: Gr00tPolicy,
+    language_instruction: str = "Pick up the object.",
+    image_size: tuple[int, int] = (224, 224),
+) -> dict:
+    """Create the same synthesized observation shape used by export verification."""
+    observation = _build_dummy_observation(policy)
+
+    video_horizon = len(policy.modality_configs["video"].delta_indices)
+    for cam_key in policy.modality_configs["video"].modality_keys:
+        observation["video"][cam_key] = np.zeros(
+            (1, video_horizon, image_size[0], image_size[1], 3),
+            dtype=np.uint8,
+        )
+
+    language_horizon = len(policy.modality_configs["language"].delta_indices)
+    for lang_key in policy.modality_configs["language"].modality_keys:
+        observation["language"][lang_key] = [[language_instruction for _ in range(language_horizon)]]
+
+    return observation
+
+
+def _collect_batched_states(unbatched_observations: list[dict], state_keys: list[str]) -> dict[str, np.ndarray]:
+    batched_states = {}
+    for key in state_keys:
+        batched_states[key] = np.stack([obs["state"][key] for obs in unbatched_observations], axis=0)
+    return batched_states
+
+
+def _prepare_collated_inputs(policy: Gr00tPolicy, observation: dict) -> tuple[dict, list[dict], dict[str, np.ndarray]]:
+    unbatched_observations = policy._unbatch_observation(observation)
+    processed_inputs = []
+    for obs in unbatched_observations:
+        vla_step_data = policy._to_vla_step_data(obs)
+        messages = [{"type": MessageType.EPISODE_STEP.value, "content": vla_step_data}]
+        processed_inputs.append(policy.processor(messages))
+
+    collated_inputs = policy.collate_fn(processed_inputs)
+    collated_inputs = _rec_to_dtype(collated_inputs, dtype=torch.bfloat16)
+    batched_states = _collect_batched_states(
+        unbatched_observations,
+        policy.modality_configs["state"].modality_keys,
+    )
+    return collated_inputs, unbatched_observations, batched_states
+
+
+def _to_numpy_input(value: torch.Tensor, dtype: torch.dtype | None = None) -> np.ndarray:
+    if dtype is not None and value.dtype != dtype:
+        value = value.to(dtype)
+    return value.detach().cpu().numpy()
+
+
+def _capture_runtime_llm_inputs(
+    policy: Gr00tPolicy,
+    collated_inputs: dict,
+    diffusion_seed: int | None = None,
+) -> tuple[np.ndarray, _RuntimeLLMInputCapture]:
+    capture = _RuntimeLLMInputCapture()
+    language_model = policy.model.backbone.model.model.language_model
+    hook = language_model.register_forward_pre_hook(capture.hook_fn, with_kwargs=True)
+    try:
+        with torch.random.fork_rng(devices=[]):
+            if diffusion_seed is not None:
+                torch.manual_seed(diffusion_seed)
+            with torch.inference_mode():
+                model_output = policy.model.get_action(collated_inputs["inputs"])
+    finally:
+        hook.remove()
+
+    if capture.position_ids is None:
+        raise RuntimeError("Failed to capture runtime LLM position_ids from PyTorch forward pass")
+
+    return model_output["action_pred"].detach().float().cpu().numpy(), capture
+
+
+def _sample_initial_actions(policy: Gr00tPolicy, batch_size: int, device: torch.device, seed: int) -> torch.Tensor:
+    action_head_config = policy.model.action_head.config
+    with torch.random.fork_rng(devices=[]):
+        torch.manual_seed(seed)
+        return torch.randn(
+            batch_size,
+            action_head_config.action_horizon,
+            action_head_config.max_action_dim,
+            dtype=torch.float32,
+            device=device,
+        )
+
+
+def _prepare_single_ov_inputs(
+    policy: Gr00tPolicy,
+    collated_inputs: dict,
+    initial_actions: torch.Tensor,
+    runtime_llm_capture: _RuntimeLLMInputCapture | None = None,
+) -> dict[str, np.ndarray]:
+    raw_inputs = collated_inputs["inputs"]
+    input_ids = raw_inputs["input_ids"]
+    attention_mask = raw_inputs["attention_mask"]
+    pixel_values = raw_inputs["pixel_values"]
+    image_grid_thw = raw_inputs["image_grid_thw"]
+    state = raw_inputs["state"]
+    embodiment_id = raw_inputs["embodiment_id"].to(torch.int64)
+
+    qwen_model = policy.model.backbone.model
+    inner_model = qwen_model.model
+    position_ids, rope_deltas = inner_model.get_rope_index(
+        input_ids,
+        image_grid_thw,
+        video_grid_thw=None,
+        attention_mask=attention_mask,
+    )
+    inner_model.rope_deltas = rope_deltas
+
+    if runtime_llm_capture is not None:
+        captured_position_ids = runtime_llm_capture.position_ids
+        if captured_position_ids is not None:
+            if captured_position_ids.shape != position_ids.shape:
+                logger.warning(
+                    "Captured PyTorch position_ids shape %s differs from manual shape %s; using captured values for OV input",
+                    tuple(captured_position_ids.shape),
+                    tuple(position_ids.shape),
+                )
+            elif not torch.equal(captured_position_ids, position_ids.cpu()):
+                position_diff = torch.max(torch.abs(captured_position_ids.to(torch.int64) - position_ids.cpu().to(torch.int64)))
+                logger.warning(
+                    "Manual position_ids differ from PyTorch runtime capture (max_abs=%d); using captured values for OV input",
+                    int(position_diff.item()),
+                )
+            else:
+                logger.info("  Runtime-captured position_ids match manual reconstruction")
+            position_ids = captured_position_ids.to(device=input_ids.device)
+
+        captured_attention_mask = runtime_llm_capture.attention_mask
+        if captured_attention_mask is not None:
+            if captured_attention_mask.shape != attention_mask.shape:
+                logger.warning(
+                    "Captured PyTorch attention_mask shape %s differs from raw shape %s; using captured values for OV input",
+                    tuple(captured_attention_mask.shape),
+                    tuple(attention_mask.shape),
+                )
+            elif not torch.equal(captured_attention_mask, attention_mask.cpu()):
+                mask_diff = torch.max(torch.abs(captured_attention_mask.to(torch.int64) - attention_mask.cpu().to(torch.int64)))
+                logger.warning(
+                    "Manual attention_mask differs from PyTorch runtime capture (max_abs=%d); using captured values for OV input",
+                    int(mask_diff.item()),
+                )
+            attention_mask = captured_attention_mask.to(device=input_ids.device)
+
+    if input_ids.shape[0] != 1:
+        raise ValueError("single-OV base inference currently supports batch size 1 observations only")
+
+    valid_mask = attention_mask[0] == 1
+    if not valid_mask.all():
+        input_ids = input_ids[:, valid_mask]
+        attention_mask = attention_mask[:, valid_mask]
+        position_ids = position_ids[:, :, valid_mask]
+
+    if initial_actions.shape[0] != input_ids.shape[0]:
+        raise ValueError(
+            f"Initial actions batch {initial_actions.shape[0]} does not match input batch {input_ids.shape[0]}"
+        )
+    actions = initial_actions.to(device=input_ids.device, dtype=torch.float32)
+
+    if isinstance(pixel_values, (list, tuple)):
+        pixel_values = torch.cat(pixel_values, dim=0)
+
+    return {
+        "input_ids": _to_numpy_input(input_ids, torch.int64),
+        "attention_mask": _to_numpy_input(attention_mask, torch.int64),
+        "pixel_values": _to_numpy_input(pixel_values, torch.float32),
+        "position_ids": _to_numpy_input(position_ids, torch.int64),
+        "state": _to_numpy_input(state, torch.float32),
+        "embodiment_id": _to_numpy_input(embodiment_id, torch.int64),
+        "actions": _to_numpy_input(actions, torch.float32),
+    }
+
+
+def _run_single_ov(compiled_model, ov_inputs: dict[str, np.ndarray]) -> np.ndarray:
+    outputs = compiled_model(ov_inputs)
+    output_port = compiled_model.output(0)
+    return outputs[output_port]
+
+
+def _run_pytorch_action_pred(policy: Gr00tPolicy, collated_inputs: dict) -> np.ndarray:
+    with torch.inference_mode():
+        model_output = policy.model.get_action(collated_inputs["inputs"])
+    return model_output["action_pred"].detach().float().cpu().numpy()
+
+
+def _compare_action_tensors(reference: np.ndarray, candidate: np.ndarray) -> dict[str, float]:
+    reference_tensor = torch.from_numpy(reference).float().flatten()
+    candidate_tensor = torch.from_numpy(candidate).float().flatten()
+
+    cosine = torch.nn.functional.cosine_similarity(
+        reference_tensor.unsqueeze(0), candidate_tensor.unsqueeze(0)
+    ).item()
+    mae = torch.mean(torch.abs(reference_tensor - candidate_tensor)).item()
+    mse = torch.mean((reference_tensor - candidate_tensor) ** 2).item()
+    max_abs = torch.max(torch.abs(reference_tensor - candidate_tensor)).item()
+    return {
+        "cosine": cosine,
+        "mae": mae,
+        "mse": mse,
+        "max_abs": max_abs,
+    }
+
+
+def _log_metrics(label: str, metrics: dict[str, float]) -> None:
+    logger.info(
+        "  %s: cosine=%.6f mae=%.6f mse=%.6f max_abs=%.6f",
+        label,
+        metrics["cosine"],
+        metrics["mae"],
+        metrics["mse"],
+        metrics["max_abs"],
+    )
+
+
+def _verify_against_pytorch(
+    policy: Gr00tPolicy,
+    collated_inputs: dict,
+    ov_predicted_action: np.ndarray,
+    pytorch_action: np.ndarray | None = None,
+) -> None:
+    logger.info("\n[Verify] Comparing single-OV output against PyTorch model output...")
+    if pytorch_action is None:
+        pytorch_action = _run_pytorch_action_pred(policy, collated_inputs)
+
+    if pytorch_action.shape != ov_predicted_action.shape:
+        raise ValueError(
+            f"PyTorch action shape {pytorch_action.shape} does not match OV output shape {ov_predicted_action.shape}"
+        )
+
+    full_metrics = _compare_action_tensors(pytorch_action, ov_predicted_action)
+    _log_metrics("Raw action_pred", full_metrics)
+
+    pytorch_trimmed = _trim_predicted_action(policy, pytorch_action)
+    ov_trimmed = _trim_predicted_action(policy, ov_predicted_action)
+    trimmed_metrics = _compare_action_tensors(pytorch_trimmed, ov_trimmed)
+    _log_metrics("Trimmed action_pred", trimmed_metrics)
+
+    actual_action_dim = pytorch_trimmed.shape[-1]
+    padded_action_dim = pytorch_action.shape[-1] - actual_action_dim
+    logger.info("  Active action dim: %d / %d", actual_action_dim, pytorch_action.shape[-1])
+    if padded_action_dim > 0:
+        pytorch_padded = pytorch_action[..., actual_action_dim:]
+        ov_padded = ov_predicted_action[..., actual_action_dim:]
+        padded_metrics = _compare_action_tensors(pytorch_padded, ov_padded)
+        _log_metrics("Padded tail only", padded_metrics)
+        logger.info("  Raw cosine includes %d inactive padded channels; trimmed cosine is the serving metric", padded_action_dim)
+
+
+def _trim_predicted_action(policy: Gr00tPolicy, predicted_action: np.ndarray) -> np.ndarray:
+    embodiment_key = policy.embodiment_tag.value
+    actual_action_dim = policy.processor.state_action_processor.get_action_dim(embodiment_key)
+    if predicted_action.shape[-1] < actual_action_dim:
+        raise ValueError(
+            f"Predicted action last dim {predicted_action.shape[-1]} is smaller than expected {actual_action_dim}"
+        )
+    return predicted_action[..., :actual_action_dim]
+
+
+def _split_action_by_joint_group(policy: Gr00tPolicy, action: np.ndarray) -> dict[str, np.ndarray]:
+    embodiment_key = policy.embodiment_tag.value
+    joint_groups = policy.modality_configs["action"].modality_keys
+    action_horizon = len(policy.modality_configs["action"].delta_indices)
+
+    out_dict: dict[str, np.ndarray] = {}
+    start_idx = 0
+    for key in joint_groups:
+        joint_dim = policy.processor.state_action_processor.norm_params[embodiment_key]["action"][key][
+            "dim"
+        ].item()
+        out_dict[key] = action[..., :action_horizon, start_idx : start_idx + joint_dim].astype(np.float32)
+        start_idx += joint_dim
+    return out_dict
+
+
+def _decode_action_safe(
+    policy: Gr00tPolicy,
+    trimmed_action: np.ndarray,
+    batched_states: dict[str, np.ndarray],
+) -> tuple[dict[str, np.ndarray], str]:
+    try:
+        decoded_action = policy.processor.decode_action(
+            trimmed_action.astype(np.float32),
+            policy.embodiment_tag,
+            batched_states,
+        )
+        return decoded_action, "decoded"
+    except Exception as exc:
+        logger.warning(
+            "decode_action failed for embodiment %s; falling back to grouped normalized actions: %s",
+            policy.embodiment_tag.value,
+            exc,
+        )
+        return _split_action_by_joint_group(policy, trimmed_action), "grouped_normalized"
+
+
+def _summarize_results(results: list[float]) -> None:
+    times = np.asarray(results, dtype=np.float64)
+    logger.info("=" * 80)
+    logger.info("Summary")
+    logger.info("  Samples: %d", len(times))
+    logger.info("  Mean: %.3f s", times.mean())
+    logger.info("  Median: %.3f s", np.median(times))
+    logger.info("  Min: %.3f s", times.min())
+    logger.info("  Max: %.3f s", times.max())
+    logger.info("  FPS: %.3f", 1.0 / times.mean() if times.mean() > 0 else float("inf"))
+    logger.info("=" * 80)
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        description="Run single-OV OpenVINO inference on the GR00T base model (dummy input)",
+        formatter_class=argparse.RawTextHelpFormatter,
+    )
+    parser.add_argument("--model-path", type=str, required=True, help="Path to PyTorch checkpoint")
+    parser.add_argument(
+        "--ov-model-dir",
+        type=str,
+        required=True,
+        help="Path to the OpenVINO export directory containing exactly one XML model",
+    )
+    parser.add_argument("--embodiment-tag", type=str, default="REAL_G1", help="Embodiment tag")
+    parser.add_argument("--num-samples", type=int, default=10, help="Number of inference iterations")
+    parser.add_argument("--num-warmup", type=int, default=5, help="Number of warmup iterations")
+    parser.add_argument(
+        "--verify-pytorch",
+        action="store_true",
+        help="Run one extra comparison between single-OV output and the original PyTorch model output",
+    )
+    parser.add_argument(
+        "--device", type=str, default="CPU", choices=["CPU", "GPU", "NPU", "AUTO"], help="OpenVINO device"
+    )
+    parser.add_argument(
+        "--language", type=str, default="Pick and place the object.", help="Language instruction for dummy input"
+    )
+    parser.add_argument(
+        "--image-size", type=int, nargs=2, default=[224, 224], help="Image size (H W) for dummy input"
+    )
+    parser.add_argument(
+        "--diffusion-seed",
+        type=int,
+        default=0,
+        help="Seed used to sample the initial diffusion trajectory fed to both PyTorch verification and OV inference",
+    )
+    parser.add_argument(
+        "--info_log",
+        action="store_true",
+        help="Enable info logging for per-iteration action details during timed inference",
+    )
+    parser.epilog = (
+        "Examples:\n\n"
+        "  python scripts/deployment/run_base_single_ov_inference.py \\\n"
+        "    --model-path checkpoints/GR00T-N1.7-3B \\\n"
+        "    --ov-model-dir checkpoints/gr00t_n1d7_ov_g1 \\\n"
+        "    --embodiment-tag REAL_G1 \\\n"
+        "    --device CPU\n"
+    )
+    return parser
+
+
+def main() -> None:
+    args = build_parser().parse_args()
+    ov_model_xml = resolve_ov_model_xml(args.ov_model_dir)
+
+    logger.info("=" * 80)
+    logger.info("GR00T N1.7 Base Single-OV Inference (Dummy Input)")
+    logger.info("=" * 80)
+    logger.info("PyTorch checkpoint: %s", args.model_path)
+    logger.info("OpenVINO directory: %s", args.ov_model_dir)
+    logger.info("Resolved OpenVINO XML: %s", ov_model_xml)
+    logger.info("Embodiment tag: %s", args.embodiment_tag)
+    logger.info("Device: %s", args.device)
+    logger.info("Num samples: %d", args.num_samples)
+    logger.info("Num warmup: %d", args.num_warmup)
+    logger.info("Verify PyTorch: %s", args.verify_pytorch)
+    logger.info("Diffusion seed: %d", args.diffusion_seed)
+    logger.info("Language: %s", args.language)
+    logger.info("Image size: %s", args.image_size)
+    logger.info("=" * 80)
+
+    logger.info("\n[Step 1] Loading modality configs from checkpoint...")
+    modality_configs = load_modality_configs_from_checkpoint(args.model_path, args.embodiment_tag)
+    state_dims = load_state_dimensions(args.model_path, args.embodiment_tag)
+    logger.info("  Video keys: %s", modality_configs["video"].modality_keys)
+    logger.info("  Video frames: %d", len(modality_configs["video"].delta_indices))
+    logger.info("  State keys: %s", modality_configs["state"].modality_keys)
+    logger.info("  State dims: %s", state_dims)
+    logger.info("  Action keys: %s", modality_configs["action"].modality_keys)
+    logger.info("  Action horizon: %d", len(modality_configs["action"].delta_indices))
+    logger.info("  Language keys: %s", modality_configs["language"].modality_keys)
+
+    logger.info("\n[Step 2] Loading GR00T policy for processor + decode path...")
+    embodiment_tag = EmbodimentTag.resolve(args.embodiment_tag)
+    policy = _load_policy_cpu_fp32(args.model_path, embodiment_tag)
+    logger.info("Policy loaded (PyTorch, CPU)")
+
+    logger.info("\n[Step 3] Compiling single OpenVINO model...")
+    core = ov.Core()
+    compiled_model = core.compile_model(ov_model_xml, args.device.upper())
+    logger.info("Compiled single OV model with %d inputs and %d outputs", len(compiled_model.inputs), len(compiled_model.outputs))
+
+    logger.info("\n[Step 4] Creating dummy observation...")
+    observation = create_dummy_observation(policy, language_instruction=args.language, image_size=tuple(args.image_size))
+    logger.info("  Dummy observation created")
+    for modality, data in observation.items():
+        if isinstance(data, dict):
+            for key, value in data.items():
+                if isinstance(value, np.ndarray):
+                    logger.info("    %s.%s: shape=%s, dtype=%s", modality, key, value.shape, value.dtype)
+                else:
+                    logger.info("    %s.%s: %s", modality, key, type(value).__name__)
+
+    logger.info("\n[Step 5] Preparing processor inputs and single-OV tensors...")
+    collated_inputs, _, batched_states = _prepare_collated_inputs(policy, observation)
+    pytorch_action = None
+    runtime_llm_capture = None
+    initial_actions = _sample_initial_actions(
+        policy,
+        batch_size=collated_inputs["inputs"]["input_ids"].shape[0],
+        device=collated_inputs["inputs"]["input_ids"].device,
+        seed=args.diffusion_seed,
+    )
+    if args.verify_pytorch:
+        pytorch_action, runtime_llm_capture = _capture_runtime_llm_inputs(
+            policy,
+            collated_inputs,
+            diffusion_seed=args.diffusion_seed,
+        )
+    ov_inputs = _prepare_single_ov_inputs(
+        policy,
+        collated_inputs,
+        initial_actions=initial_actions,
+        runtime_llm_capture=runtime_llm_capture,
+    )
+    for input_name, value in ov_inputs.items():
+        logger.info("  %s: shape=%s, dtype=%s", input_name, value.shape, value.dtype)
+
+    if args.verify_pytorch:
+        ov_predicted_action = _run_single_ov(compiled_model, ov_inputs)
+        _verify_against_pytorch(policy, collated_inputs, ov_predicted_action, pytorch_action=pytorch_action)
+
+    logger.info("\n[Step 6] Warmup (%d iterations)...", args.num_warmup)
+    for index in range(args.num_warmup):
+        start = time.time()
+        _ = _run_single_ov(compiled_model, ov_inputs)
+        elapsed = time.time() - start
+        logger.info("  Warmup %d/%d: %.3fs", index + 1, args.num_warmup, elapsed)
+    logger.info("Warmup complete.")
+
+    logger.info("\n[Step 7] Timed inference (%d iterations)...", args.num_samples)
+    logger.info("=" * 80)
+    results: list[float] = []
+
+    for index in range(args.num_samples):
+        start = time.time()
+        predicted_action = _run_single_ov(compiled_model, ov_inputs)
+        elapsed = time.time() - start
+        results.append(elapsed)
+
+        trimmed_action = _trim_predicted_action(policy, predicted_action)
+
+        decoded_action, decode_mode = _decode_action_safe(policy, trimmed_action, batched_states)
+        action_shapes = {key: value.shape for key, value in decoded_action.items()}
+
+        logger.info("Iteration %d/%d:", index + 1, args.num_samples)
+        logger.info("  Total inference time: %.3fs", elapsed)
+        if args.info_log:
+            logger.info("  Predicted action tensor: shape=%s, dtype=%s", predicted_action.shape, predicted_action.dtype)
+            logger.info("  Trimmed action tensor: shape=%s, dtype=%s", trimmed_action.shape, trimmed_action.dtype)
+            logger.info("  Action output mode: %s", decode_mode)
+            logger.info("  Decoded action keys: %s", list(decoded_action.keys()))
+            logger.info("  Decoded action shapes: %s", action_shapes)
+
+    _summarize_results(results)
+
+
+if __name__ == "__main__":
+    main()
