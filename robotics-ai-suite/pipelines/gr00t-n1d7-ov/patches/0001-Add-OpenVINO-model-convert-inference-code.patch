+        logger.info(f"  Warmup {i + 1}/{args.num_warmup}: {elapsed:.3f}s")
+    logger.info("Warmup complete.")
+
+    logger.info(f"\n[Step 6] Timed inference ({args.num_samples} iterations)...")
+    logger.info("=" * 80)
