+        if isinstance(data, dict):
+            for key, val in data.items():
+                if isinstance(val, np.ndarray):
+                    logger.info(f"    {modality}.{key}: shape={val.shape}, dtype={val.dtype}")
+                else:
+                    logger.info(f"    {modality}.{key}: {type(val).__name__}")
+
+    logger.info(f"\n[Step 5] Warmup ({args.num_warmup} iterations)...")
+    for i in range(args.num_warmup):
