+        logger.info(
+            f"    VL Self-Attn (PyTorch):  {stats['mean'] * 1000:7.1f}ms ± {stats['std'] * 1000:5.1f}ms  [{stats['min'] * 1000:.1f} - {stats['max'] * 1000:.1f}]"
