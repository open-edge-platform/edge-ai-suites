+            logger.info(f"  Action output: {len(action)} keys, first shape={list(action.values())[0].shape}")
+        else:
+            logger.info(f"Inference {i + 1}/{args.num_samples}: {inference_time:.3f}s")
+
+        results.append({
+            "episode_idx": i,
+            "inference_time": inference_time,
+            "timing_breakdown": _collect_timing_breakdown(policy),
+        })
+
+    _summarize_results(results, total_time)
