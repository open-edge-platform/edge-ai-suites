+
+    if args.export_mode == "dit_only":
+        logger.info("\n[Step 4] Exporting DiT to OpenVINO IR (dit_only mode)...")
+        dit_output_path = os.path.join(args.output_dir, f"dit_{precision_tag}.xml")
+        export_dit_to_ov(
