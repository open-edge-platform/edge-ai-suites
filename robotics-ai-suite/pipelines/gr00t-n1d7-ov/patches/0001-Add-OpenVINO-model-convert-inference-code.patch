+    logger.info("\n[Step 2] Loading GR00T policy...")
+    embodiment_tag = EmbodimentTag.resolve(args.embodiment_tag)
+    policy = Gr00tPolicy(model_path=args.model_path, embodiment_tag=embodiment_tag, device="cpu", enable_ov=True)
+    logger.info("Policy loaded (PyTorch, CPU)")
+
+    logger.info("\n[Step 3] Setting up OpenVINO models...")
+    _setup_openvino_policy(args, policy)
+
+    logger.info("\n[Step 4] Creating dummy observation...")
+    observation = create_dummy_observation(
