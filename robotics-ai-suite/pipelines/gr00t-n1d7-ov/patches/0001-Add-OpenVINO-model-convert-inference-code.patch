+def _apply_rotary_real(x, cos, sin):
+    orig_dtype = x.dtype
+    x = x.float()
+    cos = cos.float().unsqueeze(1)
+    sin = sin.float().unsqueeze(1)
+    half = x.shape[-1] // 2
+    x1 = x[..., :half]
+    x2 = x[..., half:]
+    rotated = torch.cat((-x2, x1), dim=-1)
+    return (x * cos + rotated * sin).to(orig_dtype)
+
+
+def _make_onnx_vision_attention_forward(attn_module, chunk_sizes=None):
+    def forward(hidden_states, cu_seqlens=None, rotary_pos_emb=None, position_embeddings=None, **kwargs):
+        seq_length = hidden_states.shape[0]
+        qkv = attn_module.qkv(hidden_states)
+        qkv = qkv.reshape(seq_length, 3, attn_module.num_heads, -1)
+        qkv = qkv.permute(1, 0, 2, 3)
+        q, k, v = qkv.unbind(0)
+        cos, sin = position_embeddings
+        q = _apply_rotary_real(q, cos, sin)
+        k = _apply_rotary_real(k, cos, sin)
+
+        if chunk_sizes is not None and len(chunk_sizes) > 1:
+            q_chunks = torch.split(q, chunk_sizes, dim=0)
+            k_chunks = torch.split(k, chunk_sizes, dim=0)
+            v_chunks = torch.split(v, chunk_sizes, dim=0)
+            outputs = []
+            for q_chunk, k_chunk, v_chunk in zip(q_chunks, k_chunks, v_chunks):
+                q_chunk = q_chunk.transpose(0, 1)
+                k_chunk = k_chunk.transpose(0, 1)
+                v_chunk = v_chunk.transpose(0, 1)
+                weights = torch.matmul(q_chunk, k_chunk.transpose(-2, -1)) * attn_module.scaling
+                weights = F.softmax(weights.float(), dim=-1).to(v_chunk.dtype)
+                outputs.append(torch.matmul(weights, v_chunk).transpose(0, 1))
+            attn_output = torch.cat(outputs, dim=0)
+        else:
+            q = q.transpose(0, 1)
+            k = k.transpose(0, 1)
+            v = v.transpose(0, 1)
+            weights = torch.matmul(q, k.transpose(-2, -1)) * attn_module.scaling
+            weights = F.softmax(weights.float(), dim=-1).to(v.dtype)
+            attn_output = torch.matmul(weights, v).transpose(0, 1)
+
+        attn_output = attn_output.reshape(seq_length, -1).contiguous()
+        return attn_module.proj(attn_output)
+
+    return forward
+
+
+def _patch_vision_attention_for_export(vision_model, chunk_sizes=None):
+    originals = []
+    for block in vision_model.blocks:
+        attn = block.attn
+        originals.append(attn.forward)
+        attn.forward = _make_onnx_vision_attention_forward(attn, chunk_sizes=chunk_sizes)
+    logger.info("  Patched %d vision attention blocks for export", len(originals))
+    return originals
+
+
+def _restore_vision_attention(vision_model, originals):
+    for block, original in zip(vision_model.blocks, originals):
+        block.attn.forward = original
+
+
+class Qwen3VisionForExport(nn.Module):
+    def __init__(self, vision_model, grid_thw: torch.Tensor):
+        super().__init__()
+        self.patch_embed = vision_model.patch_embed
+        self.blocks = vision_model.blocks
+        self.merger = vision_model.merger
+        self.deepstack_visual_indexes = vision_model.deepstack_visual_indexes
+        self.deepstack_merger_list = vision_model.deepstack_merger_list
+        with torch.no_grad():
+            pos_embeds = vision_model.fast_pos_embed_interpolate(grid_thw)
+            rotary = vision_model.rot_pos_emb(grid_thw)
+            emb = torch.cat((rotary, rotary), dim=-1)
+        self.register_buffer("_pos_embeds", pos_embeds.clone().detach().contiguous())
+        self.register_buffer("_rot_cos", emb.cos().clone().detach().contiguous())
+        self.register_buffer("_rot_sin", emb.sin().clone().detach().contiguous())
+
+    def forward(self, pixel_values):
+        hidden_states = self.patch_embed(pixel_values)
+        hidden_states = hidden_states + self._pos_embeds
+        position_embeddings = (self._rot_cos, self._rot_sin)
+        deepstack_features = []
+        for layer_num, block in enumerate(self.blocks):
+            hidden_states = block(
+                hidden_states,
+                cu_seqlens=None,
+                position_embeddings=position_embeddings,
+            )
+            if layer_num in self.deepstack_visual_indexes:
+                idx = self.deepstack_visual_indexes.index(layer_num)
+                deepstack_features.append(self.deepstack_merger_list[idx](hidden_states))
+        image_embeds = self.merger(hidden_states)
+        if deepstack_features:
+            deepstack = torch.stack(deepstack_features)
+        else:
+            deepstack = image_embeds.new_zeros(1, 1, 1)
+        return image_embeds, deepstack
+
+
+def _export_module_via_onnx_to_ov(
+    *,
+    model: torch.nn.Module,
+    example_inputs: tuple[torch.Tensor, ...],
+    input_names: list[str],
+    output_names: list[str],
+    dynamic_axes: Optional[dict[str, dict[int, str]]],
+    output_path: str,
+    opset_version: int = 19,
+    do_constant_folding: bool = False,
+    verify_label: Optional[str] = None,
+) -> str:
+    onnx_path = output_path.replace(".xml", ".onnx")
+    os.makedirs(os.path.dirname(output_path), exist_ok=True)
+    with torch.inference_mode():
+        torch.onnx.export(
+            model,
+            example_inputs,
+            onnx_path,
+            input_names=input_names,
+            output_names=output_names,
+            dynamic_axes=dynamic_axes,
+            opset_version=opset_version,
+            do_constant_folding=do_constant_folding,
+            export_params=True,
+            dynamo=False,
+        )
+    logger.info("  ONNX export successful: %s", onnx_path)
+    _consolidate_external_data(onnx_path)
+    verify_onnx_export(onnx_path)
+    if verify_label is not None:
+        sample_inputs = {name: tensor for name, tensor in zip(input_names, example_inputs)}
+        verify_onnx_with_ort(
+            onnx_path=onnx_path,
+            pytorch_module=model,
+            sample_inputs=sample_inputs,
+            output_names=output_names,
+            label=verify_label,
+        )
+    ov_model = ov.convert_model(onnx_path)
+    ov.save_model(ov_model, output_path, compress_to_fp16=_COMPRESS_TO_FP16)
+    logger.info("  Saved OpenVINO IR: %s", output_path)
+    return output_path
+
+
+def export_vit_to_ov(policy, output_dir, captured_vit, use_fp32=True, batch_size=1):
+    logger.info("\n%s\nExporting ViT (Qwen3-VL Vision) via ONNX -> OpenVINO\n%s", "=" * 80, "=" * 80)
+    backbone = policy.model.backbone
+    qwen_model = backbone.model
+    vision = qwen_model.model.visual
+    dtype = torch.float32 if use_fp32 else torch.bfloat16
+    device = _get_device()
+    vision = vision.to(dtype).eval().to(device)
+
+    grid_thw = captured_vit.grid_thw.to(device=device)
+    if batch_size > 1:
+        grid_thw = grid_thw.repeat(batch_size, 1)
+    chunk_sizes = torch.repeat_interleave(grid_thw[:, 1] * grid_thw[:, 2], grid_thw[:, 0]).tolist()
+    originals = _patch_vision_attention_for_export(vision, chunk_sizes=chunk_sizes)
+    wrapper = Qwen3VisionForExport(vision, grid_thw).to(dtype).eval().to(device)
+    pv_shape = captured_vit.pixel_values_shape
+    if batch_size > 1:
+        pv_shape = (pv_shape[0] * batch_size, pv_shape[1])
+    pixel_values = torch.randn(pv_shape, dtype=dtype, device=device)
+    precision_tag = "fp16" if _COMPRESS_TO_FP16 else "fp32"
+    output_path = os.path.join(output_dir, f"vit_{precision_tag}.xml")
+    try:
+        return _export_module_via_onnx_to_ov(
+            model=wrapper,
+            example_inputs=(pixel_values,),
+            input_names=["pixel_values"],
+            output_names=["image_embeds", "deepstack"],
+            dynamic_axes={
+                "pixel_values": {0: "num_patches"},
+                "image_embeds": {0: "num_merged_patches"},
+                "deepstack": {1: "num_vis_tokens"},
+            },
+            output_path=output_path,
+            verify_label="ViT",
+        )
+    finally:
+        _restore_vision_attention(vision, originals)
+
+
+def export_llm_to_ov(policy, captured_llm, output_dir, use_fp32=True, batch_size=1):
+    logger.info("\n%s\nExporting LLM (Qwen3-VL Text Model) via ONNX -> OpenVINO\n%s", "=" * 80, "=" * 80)
+    backbone = policy.model.backbone
+    qwen_model = backbone.model
+    inner_model = qwen_model.model
+    text_model = inner_model.language_model
+    select_layer = backbone.select_layer
+    from transformers.models.qwen3_vl.modeling_qwen3_vl import Qwen3VLTextDecoderLayer, Qwen3VLTextRMSNorm, Qwen3VLTextRotaryEmbedding
+
+    text_config = copy.deepcopy(text_model.config)
+    text_config._attn_implementation = "eager"
+    text_config.num_hidden_layers = select_layer
+    num_deepstack = len(captured_llm.deepstack_visual_embeds) if captured_llm.deepstack_visual_embeds is not None else 0
+
+    class LLMForExport(nn.Module):
+        def __init__(self, config, deepstack_count):
+            super().__init__()
+            self.layers = nn.ModuleList(
+                [Qwen3VLTextDecoderLayer(config, layer_idx) for layer_idx in range(config.num_hidden_layers)]
+            )
+            self.rotary_emb = Qwen3VLTextRotaryEmbedding(config=config)
+            self.norm = Qwen3VLTextRMSNorm(config.hidden_size, eps=config.rms_norm_eps)
+            self.deepstack_count = deepstack_count
+
+        def _traceable_causal_mask(self, inputs_embeds, attention_mask):
+            batch_size, seq_len = inputs_embeds.shape[:2]
+            device = inputs_embeds.device
+            dtype = inputs_embeds.dtype
+            min_dtype = torch.finfo(dtype).min
+            causal = torch.tril(torch.ones((seq_len, seq_len), device=device, dtype=torch.bool))
+            mask = causal.unsqueeze(0).unsqueeze(0).expand(batch_size, 1, seq_len, seq_len)
+            if attention_mask is not None:
+                padding_mask = attention_mask[:, None, None, :].to(torch.bool)
+                mask = mask & padding_mask
+            return torch.where(
+                mask,
+                torch.zeros((), device=device, dtype=dtype),
+                torch.full((), min_dtype, device=device, dtype=dtype),
+            )
+
+        def _deepstack_add(self, hidden_states, deepstack_delta):
+            return hidden_states + deepstack_delta
+
+        def forward(self, inputs_embeds, position_ids, attention_mask=None, deepstack_delta_0=None, deepstack_delta_1=None, deepstack_delta_2=None):
+            device = inputs_embeds.device
+            text_position_ids = position_ids[0]
+            cache_position = torch.arange(inputs_embeds.shape[1], device=device)
+            attn_mask = self._traceable_causal_mask(inputs_embeds, attention_mask)
+            hidden_states = inputs_embeds
+            position_embeddings = self.rotary_emb(hidden_states, position_ids)
+            deepstack_list = [tensor for tensor in (deepstack_delta_0, deepstack_delta_1, deepstack_delta_2) if tensor is not None]
+            for layer_idx, decoder_layer in enumerate(self.layers):
+                hidden_states = decoder_layer(
+                    hidden_states,
+                    attention_mask=attn_mask,
+                    position_ids=text_position_ids,
+                    past_key_values=None,
+                    cache_position=cache_position,
+                    position_embeddings=position_embeddings,
+                )
+                if layer_idx < len(deepstack_list):
+                    hidden_states = self._deepstack_add(hidden_states, deepstack_list[layer_idx])
+            # Match Qwen3Backbone.forward(), which consumes hidden_states[-1]
+            # before the language model's final RMSNorm.
+            return hidden_states
+
+    dtype = torch.float32 if use_fp32 else torch.bfloat16
+    device = _get_device()
+    seq_len = captured_llm.inputs_embeds.shape[1]
+    hidden_size = text_config.hidden_size
+    wrapper = LLMForExport(text_config, num_deepstack)
+    src_state = text_model.state_dict()
+    dst_state = wrapper.state_dict()
+    for key in list(dst_state):
+        if key in src_state:
+            dst_state[key] = src_state[key]
+    wrapper.load_state_dict(dst_state, strict=False)
+    wrapper = wrapper.to(dtype).eval().to(device)
+
+    inputs_embeds = torch.randn(batch_size, seq_len, hidden_size, dtype=dtype, device=device)
+    position_ids = torch.zeros(3, batch_size, seq_len, dtype=torch.int64, device=device)
+    example_inputs: list[torch.Tensor] = [inputs_embeds, position_ids]
+    input_names = ["inputs_embeds", "position_ids"]
+    dynamic_axes = {
+        "inputs_embeds": {0: "batch", 1: "seq_len"},
+        "position_ids": {1: "batch", 2: "seq_len"},
+        "hidden_states": {0: "batch", 1: "seq_len"},
+    }
+    if captured_llm.attention_mask is not None:
+        attention_mask = captured_llm.attention_mask.to(device=device)
+        if attention_mask.shape[0] == 1 and batch_size > 1:
+            attention_mask = attention_mask.expand(batch_size, -1)
+        example_inputs.append(attention_mask)
+        input_names.append("attention_mask")
+        dynamic_axes["attention_mask"] = {0: "batch", 1: "seq_len"}
+    if num_deepstack > 0 and captured_llm.visual_pos_masks is not None:
+        visual_pos_masks = captured_llm.visual_pos_masks.to(device=device)
+        for index in range(num_deepstack):
+            deepstack = captured_llm.deepstack_visual_embeds[index]
+            dense_delta = build_dense_token_delta(
+                visual_pos_masks=visual_pos_masks,
+                visual_embeds=deepstack,
+                batch_size=batch_size,
+                device=device,
+                dtype=dtype,
+            )
+            example_inputs.append(dense_delta)
+            input_name = f"deepstack_delta_{index}"
+            input_names.append(input_name)
+            dynamic_axes[input_name] = {0: "batch", 1: "seq_len"}
+
+    precision_tag = "fp16" if _COMPRESS_TO_FP16 else "fp32"
+    output_path = os.path.join(output_dir, f"llm_{precision_tag}.xml")
+    return _export_module_via_onnx_to_ov(
+        model=wrapper,
+        example_inputs=tuple(example_inputs),
+        input_names=input_names,
+        output_names=["hidden_states"],
+        dynamic_axes=dynamic_axes,
+        output_path=output_path,
+        verify_label="LLM",
+    )
+
+
+def parse_observation_gr00t(obs: dict[str, Any], modality_configs: dict[str, Any]) -> dict[str, Any]:
+    new_obs: dict[str, Any] = {}
+    for modality in ["video", "state", "language"]:
+        new_obs[modality] = {}
+        for key in modality_configs[modality].modality_keys:
+            parsed_key = key if modality == "language" else f"{modality}.{key}"
+            arr = obs[parsed_key]
+            if isinstance(arr, str):
+                new_obs[modality][key] = [[arr]]
+            else:
+                new_obs[modality][key] = arr[None, :]
+    return new_obs
+
+
+def prepare_observation(policy, dataset, traj_idx=0):
+    logger.info("\nPreparing observation from trajectory %d...", traj_idx)
+    traj = dataset[traj_idx]
+    modality_configs = policy.get_modality_config()
+    data_point = extract_step_data(
+        traj,
+        0,
+        modality_configs=modality_configs,
+        embodiment_tag=policy.embodiment_tag,
+    )
+    observation = {}
+    for key, value in data_point.states.items():
+        observation[f"state.{key}"] = value
+    for key, value in data_point.images.items():
+        observation[f"video.{key}"] = np.array(value)
+    for key in modality_configs["language"].modality_keys:
+        observation[key] = data_point.text
+    return parse_observation_gr00t(observation, modality_configs)
+
+
+def _infer_feature_dim_from_stats(norm_stats: Any, fallback: int) -> int:
+    if norm_stats is None:
+        return fallback
+    for attr_name in ("mean", "std", "min", "max"):
+        attr = getattr(norm_stats, attr_name, None)
+        if attr is not None:
+            try:
+                return int(np.asarray(attr).shape[-1])
+            except Exception:
+                continue
+    return fallback
+
+
+def _build_dummy_observation(policy: Gr00tPolicy) -> dict[str, Any]:
+    modality_configs = policy.get_modality_config()
+    observation: dict[str, Any] = {"video": {}, "state": {}, "language": {}}
+    state_norm_params = getattr(policy.processor.state_action_processor, "norm_params", {})
+    embodiment_key = policy.embodiment_tag.value
+    embodiment_state_params = state_norm_params.get(embodiment_key, {}).get("state", {})
+    state_horizon = len(modality_configs["state"].delta_indices)
+    video_horizon = len(modality_configs["video"].delta_indices)
+    language_horizon = len(modality_configs["language"].delta_indices)
+
+    for key in modality_configs["state"].modality_keys:
+        dims = 1
+        if key in embodiment_state_params:
+            dim_value = embodiment_state_params[key].get("dim")
+            if dim_value is not None:
+                dims = int(np.asarray(dim_value).item())
+            else:
+                dims = _infer_feature_dim_from_stats(embodiment_state_params[key], fallback=1)
+        state_value = np.zeros((1, state_horizon, dims), dtype=np.float32)
+        if dims >= 9 and "eef" in key:
+            state_value[..., 3] = 1.0
+            state_value[..., 7] = 1.0
+        observation["state"][key] = state_value
+
+    for key in modality_configs["video"].modality_keys:
+        observation["video"][key] = np.zeros((1, video_horizon, 224, 224, 3), dtype=np.uint8)
+
+    default_text = "Pick and place the object."
+    for key in modality_configs["language"].modality_keys:
+        observation["language"][key] = [[default_text for _ in range(language_horizon)]]
+    return observation
+
+
+def _capture_inputs_without_dataset(policy: Gr00tPolicy, args: ExportConfig):
+    logger.info("\n[Step 2] Using synthesized dummy observation (no dataset)...")
+    observation = _build_dummy_observation(policy)
+
+    logger.info("\n[Step 3] Capturing model inputs from dummy inference...")
+    dit_capture = DiTInputCapture()
+    dit_hook = policy.model.action_head.model.register_forward_pre_hook(dit_capture.hook_fn, with_kwargs=True)
+
+    vit_capture = None
+    vit_hook = None
+    llm_capture = None
+    llm_hook = None
+    vl_sa_capture = None
+    vl_sa_hook = None
+    if args.export_mode == "full_pipeline":
+        vit_capture = ViTInputCapture()
+        qwen_model = policy.model.backbone.model
+        vit_hook = qwen_model.model.visual.register_forward_hook(vit_capture.hook_fn, with_kwargs=True)
+
+        llm_capture = LLMInputCapture()
+        llm_hook = qwen_model.model.language_model.register_forward_pre_hook(llm_capture.hook_fn, with_kwargs=True)
+
+        vl_sa_capture = VLSelfAttentionInputCapture()
+        vl_sa_hook = policy.model.action_head.vl_self_attention.register_forward_pre_hook(vl_sa_capture.hook_fn, with_kwargs=True)
+
+    try:
+        unbatched_observations = policy._unbatch_observation(observation)
+        processed_inputs = []
+        for obs in unbatched_observations:
+            vla_step_data = policy._to_vla_step_data(obs)
+            messages = [{"type": MessageType.EPISODE_STEP.value, "content": vla_step_data}]
+            processed_inputs.append(policy.processor(messages))
+
+        collated_inputs = policy.collate_fn(processed_inputs)
+        collated_inputs = _rec_to_dtype(collated_inputs, dtype=torch.bfloat16)
+        with torch.inference_mode():
+            _ = policy.model.get_action(**collated_inputs)
+    finally:
+        dit_hook.remove()
+        if vit_hook is not None:
+            vit_hook.remove()
+        if llm_hook is not None:
+            llm_hook.remove()
+        if vl_sa_hook is not None:
+            vl_sa_hook.remove()
+
+    if not dit_capture.captured:
+        raise RuntimeError("Failed to capture DiT inputs without dataset")
+    if args.export_mode == "full_pipeline" and not vit_capture.captured:
+        raise RuntimeError("Failed to capture ViT inputs without dataset")
+    if args.export_mode == "full_pipeline" and not llm_capture.captured:
+        raise RuntimeError("Failed to capture LLM inputs without dataset")
+    if args.export_mode == "full_pipeline" and not vl_sa_capture.captured:
+        raise RuntimeError("Failed to capture VL self-attention inputs without dataset")
+
+    return dit_capture, vit_capture, llm_capture, vl_sa_capture
+
+
+def export_vl_self_attention_to_ov(policy, output_dir, vl_seq_len, use_fp32=True, batch_size=1, captured_hidden_states=None):
