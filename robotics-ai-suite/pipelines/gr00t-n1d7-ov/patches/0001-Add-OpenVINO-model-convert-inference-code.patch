+def export_dit_to_ov(policy, captured_inputs, output_path, use_fp32=True, batch_size=1):
+    """Export the DiT to OpenVINO IR."""
+    logger.info("\n" + "=" * 80)
+    logger.info("Exporting DiT to OpenVINO IR")
+    logger.info("=" * 80)
+
+    dit_model = policy.model.action_head.model
+    dit_model.eval()
+
+    # Replace processors so attention and mask handling stay export-friendly.
+    logger.info("  Replacing attention processors with export-friendly versions...")
+    original_processors = replace_attention_processors_for_export(dit_model)
+
+    dtype = torch.float32 if use_fp32 else torch.bfloat16
+    device = _get_device()
+    dit_model = dit_model.to(dtype).to(device)
+
+    # Use captured shapes but replace batch dim with batch_size
+    sa_shape = (batch_size,) + captured_inputs.sa_embs.shape[1:]
+    vl_shape = (batch_size,) + captured_inputs.vl_embs.shape[1:]
+    ts_shape = (batch_size,)
+
+    sa_embs = torch.randn(sa_shape, dtype=dtype, device=device)
+    vl_embs = torch.randn(vl_shape, dtype=dtype, device=device)
+    timestep = torch.ones(ts_shape, dtype=torch.int64, device=device)
+
+    export_inputs = [sa_embs, vl_embs, timestep]
+    has_image_mask = captured_inputs.image_mask is not None
+    has_backbone_mask = captured_inputs.backbone_attention_mask is not None
+
+    if has_image_mask:
+        # CRITICAL: Use actual captured mask pattern, not all-ones!
+        # The mask pattern matters because it affects which tokens the model attends to
+        # Keep as boolean since the model uses & operator
+        im_shape = (batch_size,) + captured_inputs.image_mask.shape[1:]
+        if batch_size == 1:
+            # Use the actual captured mask pattern (keep as boolean)
+            image_mask = captured_inputs.image_mask.to(device=device)
+        else:
+            # For batch_size > 1, replicate the pattern
+            image_mask = captured_inputs.image_mask.to(device=device).repeat(batch_size, 1)
+        export_inputs.append(image_mask)
+
+    if has_backbone_mask:
+        # CRITICAL: Use actual captured mask pattern, not all-ones!
+        # Keep as boolean since the model uses & operator
+        bm_shape = (batch_size,) + captured_inputs.backbone_attention_mask.shape[1:]
+        if batch_size == 1:
+            backbone_attention_mask = captured_inputs.backbone_attention_mask.to(device=device)
+        else:
+            backbone_attention_mask = captured_inputs.backbone_attention_mask.to(device=device).repeat(batch_size, 1)
+        export_inputs.append(backbone_attention_mask)
+
+    logger.info("  Export input shapes:")
+    for i, tensor in enumerate(export_inputs):
+        logger.info(f"    input_{i}: {tensor.shape} ({tensor.dtype})")
+
+    os.makedirs(os.path.dirname(output_path), exist_ok=True)
+
+    # Create wrapper to handle keyword arguments
+    class DiTWrapper(torch.nn.Module):
+        def __init__(self, dit, use_image_mask, use_backbone_mask):
+            super().__init__()
+            self.dit = dit
+            self.use_image_mask = use_image_mask
+            self.use_backbone_mask = use_backbone_mask
+
+        def forward(
+            self, sa_embs, vl_embs, timestep, image_mask=None, backbone_attention_mask=None
+        ):
+            # Pass masks through to the DiT model
+            # The model will convert them to boolean internally if needed
+            kwargs = {}
+            if self.use_image_mask and image_mask is not None:
+                kwargs["image_mask"] = image_mask
+            if self.use_backbone_mask and backbone_attention_mask is not None:
+                kwargs["backbone_attention_mask"] = backbone_attention_mask
+            return self.dit(sa_embs, vl_embs, timestep, **kwargs)
+
+    wrapped_model = DiTWrapper(dit_model, has_image_mask, has_backbone_mask)
+    wrapped_model.eval()
+
+    precision_tag = "fp32" if not _COMPRESS_TO_FP16 else "fp16"
+    logger.info(f"  Converting to OpenVINO IR: {output_path}...")
+
+    try:
+        with torch.inference_mode():
+            pt_output = wrapped_model(*export_inputs)
+            input_names = ["sa_embs", "vl_embs", "timestep"]
+
+            if has_image_mask:
+                input_names.append("image_mask")
+            if has_backbone_mask:
+                input_names.append("backbone_attention_mask")
+
+            ov_model = ov.convert_model(wrapped_model, example_input=export_inputs)
+            _log_ov_vs_pytorch("Direct OV", ov_model, input_names, export_inputs, pt_output)
+            ov.save_model(ov_model, output_path, compress_to_fp16=_COMPRESS_TO_FP16)
+            logger.info("  ✓ DiT exported successfully to OpenVINO IR!")
+    finally:
+        # Always restore original processors
+        logger.info("  Restoring original attention processors...")
+        restore_attention_processors(dit_model, original_processors)
+
+    return output_path
+
