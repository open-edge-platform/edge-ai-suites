+def action_head_openvino_forward(self, backbone_output, action_input, options=None):
+    if not hasattr(self, "_timing_stats"):
+        self._timing_stats = {}
+
+    backbone_features = backbone_output["backbone_features"]
+
+    t0 = time.perf_counter()
+    vlln_param = next(self.vlln.parameters(), None)
+    if vlln_param is not None and backbone_features.dtype != vlln_param.dtype:
+        backbone_features = backbone_features.to(vlln_param.dtype)
+    backbone_features = self.vlln(backbone_features)
+    self._timing_stats["vlln"] = time.perf_counter() - t0
+
+    t0 = time.perf_counter()
+    backbone_features = self.vl_self_attention(backbone_features)
+    self._timing_stats["vl_self_attention"] = time.perf_counter() - t0
+
+    vl_embeds = backbone_features.to(torch.float32) if backbone_features.dtype != torch.float32 else backbone_features
+    embodiment_id = action_input.embodiment_id.to(torch.int64) if action_input.embodiment_id.dtype != torch.int64 else action_input.embodiment_id
+    state = action_input.state.view(action_input.state.shape[0], 1, -1)
+    if state.dtype != torch.float32:
+        state = state.to(torch.float32)
+
+    t0 = time.perf_counter()
+    state_features = self.state_encoder_ov_model([state.cpu().numpy(), embodiment_id.cpu().numpy()])[0]
+    state_features = torch.from_numpy(state_features) if isinstance(state_features, np.ndarray) else state_features
+    self._timing_stats["state_encoder"] = time.perf_counter() - t0
+
+    batch_size = vl_embeds.shape[0]
+    device = state.device
+    actions = torch.randn(
+        size=(batch_size, self.config.action_horizon, self.action_dim),
+        dtype=torch.float32,
+        device=device,
+    )
+    if hasattr(self, "init_actions"):
+        actions = self.init_actions.expand((batch_size, -1, -1))
+
+    num_steps = self.num_inference_timesteps
+    dt = 1.0 / num_steps
+    self._timing_stats["action_encoder_total"] = 0.0
+    self._timing_stats["dit_total"] = 0.0
+    self._timing_stats["action_decoder_total"] = 0.0
+
+    for t in range(num_steps):
+        t_cont = t / float(num_steps)
+        t_discretized = int(t_cont * self.num_timestep_buckets)
+        timesteps_tensor = torch.full((batch_size,), t_discretized, device=device, dtype=torch.int64)
+
+        t0 = time.perf_counter()
+        action_features = self.action_encoder_ov_model([
+            actions.cpu().numpy(),
+            timesteps_tensor.cpu().numpy(),
+            embodiment_id.cpu().numpy(),
+        ])[0]
+        action_features = torch.from_numpy(action_features) if isinstance(action_features, np.ndarray) else action_features
+        self._timing_stats["action_encoder_total"] += time.perf_counter() - t0
+
+        if self.config.add_pos_embed:
+            pos_ids = torch.arange(action_features.shape[1], dtype=torch.long, device=device)
+            pos_embs = self.position_embedding(pos_ids).unsqueeze(0).to(torch.float32)
+            action_features = action_features + pos_embs
+
+        sa_embs = torch.cat((state_features, action_features), dim=1)
+        image_mask, backbone_mask = _resolve_backbone_masks(backbone_output, batch_size, vl_embeds.shape[1], device)
+
+        t0 = time.perf_counter()
+        model_output = self.dit_ov_model([
+            sa_embs.cpu().numpy(),
+            vl_embeds.cpu().numpy(),
+            timesteps_tensor.cpu().numpy(),
+            image_mask.cpu().numpy(),
+            backbone_mask.cpu().numpy(),
+        ])[0]
+        model_output = torch.from_numpy(model_output) if isinstance(model_output, np.ndarray) else model_output
+        self._timing_stats["dit_total"] += time.perf_counter() - t0
+
+        t0 = time.perf_counter()
+        pred = self.action_decoder_ov_model([model_output.cpu().numpy(), embodiment_id.cpu().numpy()])[0]
+        pred = torch.from_numpy(pred) if isinstance(pred, np.ndarray) else pred
+        self._timing_stats["action_decoder_total"] += time.perf_counter() - t0
+        pred_velocity = pred[:, -self.action_horizon :, :]
+        actions = actions + dt * pred_velocity
+
+    return BatchFeature(data={"action_pred": actions})
+
