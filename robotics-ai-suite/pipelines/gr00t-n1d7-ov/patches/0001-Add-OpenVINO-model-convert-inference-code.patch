+class DiT_Fused(nn.Module):
+    def __init__(self, action_head):
+        super().__init__()
+        self.config = action_head.config
+        self.action_encoder = action_head.action_encoder
+        self.action_decoder = action_head.action_decoder
+        self.dit = action_head.model
+        self.add_pos_embed = action_head.config.add_pos_embed
+        if self.add_pos_embed:
+            self.position_embedding = action_head.position_embedding
+        self.use_alternate_vl_dit = action_head.config.use_alternate_vl_dit
+        self.denoising_steps = action_head.num_inference_timesteps
+        self.action_horizon = action_head.config.action_horizon
+        self.num_timestep_buckets = action_head.config.num_timestep_buckets
+
+    def forward(self, state_features, vl_embs_tensor, embodiment_id_tensor, actions_tensor, image_mask=None, backbone_attention_mask=None):
+        batch_size = actions_tensor.shape[0]
+        device = actions_tensor.device
+        dt = 1.0 / float(self.denoising_steps)
+        if image_mask is not None:
+            image_mask = image_mask.to(dtype=torch.bool)
+        if backbone_attention_mask is not None:
+            backbone_attention_mask = backbone_attention_mask.to(dtype=torch.bool)
+        for t in range(self.denoising_steps):
+            t_cont = t / float(self.denoising_steps)
+            t_discretized = int(t_cont * self.num_timestep_buckets)
+            timesteps_tensor = torch.full((batch_size,), t_discretized, dtype=torch.int64, device=device)
+            action_features = self.action_encoder(actions_tensor, timesteps_tensor, embodiment_id_tensor)
+            if self.add_pos_embed:
+                pos_ids = torch.arange(action_features.shape[1], dtype=torch.int64, device=device)
+                action_features = action_features + self.position_embedding(pos_ids).unsqueeze(0)
+            sa_embs = torch.cat((state_features, action_features), dim=1)
+            if self.use_alternate_vl_dit:
+                model_output = self.dit(
+                    hidden_states=sa_embs,
+                    encoder_hidden_states=vl_embs_tensor,
+                    timestep=timesteps_tensor,
+                    image_mask=image_mask,
+                    backbone_attention_mask=backbone_attention_mask,
+                )
+            else:
+                model_output = self.dit(hidden_states=sa_embs, encoder_hidden_states=vl_embs_tensor, timestep=timesteps_tensor)
+            pred = self.action_decoder(model_output, embodiment_id_tensor)
+            pred_velocity = pred[:, -self.action_horizon :]
+            actions_tensor = actions_tensor + dt * pred_velocity
+        return actions_tensor
+
+
+def export_dit_fused_to_ov(policy, captured_inputs, output_dir, use_fp32=True, batch_size=1):
+    logger.info("\n%s\nExporting Fused DiT via ONNX -> OpenVINO\n%s", "=" * 80, "=" * 80)
+    config = policy.model.action_head.config
+    dtype = torch.float32 if use_fp32 else torch.bfloat16
+    device = _get_device()
+    fused_model = DiT_Fused(policy.model.action_head).to(dtype).eval().to(device)
+    original_processors = replace_attention_processors_for_onnx(fused_model)
+    try:
+        state_seq_len = captured_inputs.sa_embs.shape[1] - config.action_horizon
+        vl_seq_len = captured_inputs.vl_embs.shape[1]
+        state_features = torch.randn(batch_size, state_seq_len, config.input_embedding_dim, dtype=dtype, device=device)
+        vl_embs_tensor = torch.randn(batch_size, vl_seq_len, config.backbone_embedding_dim, dtype=dtype, device=device)
+        embodiment_id_tensor = torch.zeros(batch_size, dtype=torch.int64, device=device)
+        actions_tensor = torch.randn(batch_size, config.action_horizon, config.max_action_dim, dtype=dtype, device=device)
+        example_inputs: list[torch.Tensor] = [state_features, vl_embs_tensor, embodiment_id_tensor, actions_tensor]
+        input_names = ["state_features", "vl_embs", "embodiment_id", "actions"]
+        dynamic_axes = {
+            "state_features": {0: "batch", 1: "state_seq_len"},
+            "vl_embs": {0: "batch", 1: "vl_seq_len"},
+            "embodiment_id": {0: "batch"},
+            "actions": {0: "batch"},
+            "predicted_action": {0: "batch"},
+        }
+        if config.use_alternate_vl_dit:
+            image_mask = torch.ones(batch_size, vl_seq_len, dtype=torch.bool, device=device)
+            backbone_attention_mask = torch.ones(batch_size, vl_seq_len, dtype=torch.bool, device=device)
+            example_inputs.extend([image_mask, backbone_attention_mask])
+            input_names.extend(["image_mask", "backbone_attention_mask"])
+            dynamic_axes["image_mask"] = {0: "batch", 1: "vl_seq_len"}
+            dynamic_axes["backbone_attention_mask"] = {0: "batch", 1: "vl_seq_len"}
+        precision_tag = "fp16" if _COMPRESS_TO_FP16 else "fp32"
+        output_path = os.path.join(output_dir, f"dit_fused_{precision_tag}.xml")
+        return _export_module_via_onnx_to_ov(
+            model=fused_model,
+            example_inputs=tuple(example_inputs),
+            input_names=input_names,
+            output_names=["predicted_action"],
+            dynamic_axes=dynamic_axes,
+            output_path=output_path,
+            do_constant_folding=True,
+        )
+    finally:
+        restore_attention_processors(fused_model, original_processors)
+
+
+def _resolve_embodiment_tag(model_path: str, embodiment_tag: Optional[EmbodimentTag]) -> EmbodimentTag:
+    if embodiment_tag is not None:
+        return EmbodimentTag.resolve(embodiment_tag)
+    config_file = Path(model_path) / "processor_config.json"
+    if not config_file.exists():
+        raise ValueError(
+            f"Cannot auto-detect embodiment_tag: {config_file} not found. Please provide --embodiment-tag explicitly."
+        )
+    with open(config_file, "r") as f:
+        processor_config = json.load(f)
+    modality_configs = processor_config.get("processor_kwargs", {}).get("modality_configs", {})
+    if len(modality_configs) == 0:
+        raise ValueError(
+            "Cannot auto-detect embodiment_tag: no modality_configs found in processor_config.json. Please provide --embodiment-tag explicitly."
+        )
+    if len(modality_configs) == 1:
+        embodiment_key = next(iter(modality_configs))
+        return EmbodimentTag.resolve(embodiment_key)
+    available = sorted(modality_configs.keys())
+    raise ValueError(
+        f"Multiple embodiments found in processor_config.json: {available}. Please provide --embodiment-tag explicitly."
+    )
+
+
+def main(args: ExportConfig) -> None:
+    global _DEVICE, _COMPRESS_TO_FP16
+    args.embodiment_tag = _resolve_embodiment_tag(args.model_path, args.embodiment_tag)
+    _DEVICE = args.device
+    _COMPRESS_TO_FP16 = args.precision == "fp16"
+
+    logger.info("=" * 80)
+    logger.info("GR00T N1.7 OpenVINO Export Script")
+    logger.info("=" * 80)
+    logger.info(f"Model path: {args.model_path}")
+    logger.info(f"Dataset path: {args.dataset_path}")
+    logger.info(f"Embodiment: {args.embodiment_tag}")
+    logger.info(f"Export mode: {args.export_mode}")
+    logger.info(f"Batch size: {args.batch_size}")
+    logger.info(f"Output directory: {args.output_dir}")
+    logger.info(f"Device: {args.device}")
+    logger.info("Enable OV: True")
+    logger.info(f"Precision: {args.precision}")
+    logger.info("=" * 80)
+
+    attention_patched = patch_diffusers_attention_for_openvino()
+    try:
+        logger.info("\n[Step 1] Loading policy...")
+        policy = Gr00tPolicy(
+            embodiment_tag=args.embodiment_tag,
+            model_path=args.model_path,
+            device=args.device,
+            enable_ov=True,
+        )
+        logger.info("  Policy loaded")
+
+        if getattr(args, "num_inference_timesteps", None) is not None:
+            requested_steps = int(args.num_inference_timesteps)
+            if requested_steps <= 0:
+                raise ValueError("num_inference_timesteps must be a positive integer")
+            original_steps = int(policy.model.action_head.num_inference_timesteps)
+            if requested_steps != original_steps:
+                logger.info(
+                    "  Overriding action-head denoising steps for export: %d -> %d",
+                    original_steps,
+                    requested_steps,
+                )
+                policy.model.action_head.num_inference_timesteps = requested_steps
+
+        if args.dataset_path:
+            logger.info("\n[Step 2] Loading dataset...")
+            dataset = LeRobotEpisodeLoader(
+                dataset_path=args.dataset_path,
+                modality_configs=policy.get_modality_config(),
+                video_backend=args.video_backend,
+                video_backend_kwargs=None,
+            )
+            logger.info(f"  Dataset loaded ({len(dataset)} trajectories)")
+            logger.info("\n[Step 3] Capturing model inputs from actual inference...")
+
+            dit_capture = DiTInputCapture()
+            dit_hook = policy.model.action_head.model.register_forward_pre_hook(dit_capture.hook_fn, with_kwargs=True)
+
+            vit_capture = None
+            vit_hook = None
+            llm_capture = None
+            llm_hook = None
+            vl_sa_capture = None
+            vl_sa_hook = None
+            if args.export_mode == "full_pipeline":
+                vit_capture = ViTInputCapture()
+                qwen_model = policy.model.backbone.model
+                vit_hook = qwen_model.model.visual.register_forward_hook(vit_capture.hook_fn, with_kwargs=True)
+
+                llm_capture = LLMInputCapture()
+                llm_hook = qwen_model.model.language_model.register_forward_pre_hook(llm_capture.hook_fn, with_kwargs=True)
+
+                vl_sa_capture = VLSelfAttentionInputCapture()
+                vl_sa_hook = policy.model.action_head.vl_self_attention.register_forward_pre_hook(vl_sa_capture.hook_fn, with_kwargs=True)
+
+            observation = prepare_observation(policy, dataset, traj_idx=0)
+            with torch.inference_mode():
+                _ = policy.get_action(observation)
+
+            dit_hook.remove()
+            if vit_hook is not None:
+                vit_hook.remove()
+            if llm_hook is not None:
+                llm_hook.remove()
+            if vl_sa_hook is not None:
+                vl_sa_hook.remove()
+        else:
+            dit_capture, vit_capture, llm_capture, vl_sa_capture = _capture_inputs_without_dataset(policy, args)
+
+        if not dit_capture.captured:
+            raise RuntimeError("Failed to capture DiT inputs")
+        if args.export_mode == "full_pipeline" and not vit_capture.captured:
+            raise RuntimeError("Failed to capture ViT inputs")
+        if args.export_mode == "full_pipeline" and not llm_capture.captured:
+            raise RuntimeError("Failed to capture LLM inputs")
+        if args.export_mode == "full_pipeline" and not vl_sa_capture.captured:
+            raise RuntimeError("Failed to capture VL self-attention inputs")
+
+        action_head_config = policy.model.action_head.config
+        sa_seq_len = 1 + action_head_config.action_horizon
+        vl_seq_len = dit_capture.vl_embs.shape[1]
+        num_patches = vit_capture.pixel_values_shape[0] if vit_capture and vit_capture.captured else 256
+        num_merged_patches = vit_capture.output_shape[0] if vit_capture and vit_capture.captured else 64
+        llm_seq_len = llm_capture.inputs_embeds.shape[1] if llm_capture and llm_capture.captured else vl_seq_len
+        llm_hidden_size = llm_capture.inputs_embeds.shape[2] if llm_capture and llm_capture.captured else 0
+        num_deepstack = len(llm_capture.deepstack_visual_embeds) if (llm_capture and llm_capture.deepstack_visual_embeds) else 0
+        num_vis_tokens = llm_capture.deepstack_visual_embeds[0].shape[0] if num_deepstack > 0 else 0
+
+        export_metadata = {
+            "model_version": "n1d7",
+            "format": "openvino",
+            "sa_seq_len": int(sa_seq_len),
+            "vl_seq_len": int(vl_seq_len),
+            "llm_seq_len": int(llm_seq_len),
+            "llm_hidden_size": int(llm_hidden_size),
+            "num_deepstack": int(num_deepstack),
+            "num_vis_tokens": int(num_vis_tokens),
+            "num_patches": int(num_patches),
+            "num_merged_patches": int(num_merged_patches),
