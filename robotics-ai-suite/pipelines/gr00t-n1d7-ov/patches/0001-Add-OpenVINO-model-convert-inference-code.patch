+def export_dit_to_ov(policy, captured_inputs, output_path, use_fp32=True, batch_size=1):
+    logger.info("\n%s\nExporting DiT via ONNX -> OpenVINO\n%s", "=" * 80, "=" * 80)
+    dit_model = policy.model.action_head.model.eval()
+    original_processors = replace_attention_processors_for_onnx(dit_model)
+    dtype = torch.float32 if use_fp32 else torch.bfloat16
+    device = _get_device()
+    dit_model = dit_model.to(dtype).to(device)
+
+    sa_embs = torch.randn((batch_size,) + captured_inputs.sa_embs.shape[1:], dtype=dtype, device=device)
+    vl_embs = torch.randn((batch_size,) + captured_inputs.vl_embs.shape[1:], dtype=dtype, device=device)
+    timestep = torch.ones((batch_size,), dtype=torch.int64, device=device)
+    example_inputs: list[torch.Tensor] = [sa_embs, vl_embs, timestep]
+    input_names = ["sa_embs", "vl_embs", "timestep"]
+    dynamic_axes = {
+        "sa_embs": {0: "batch", 1: "sa_seq_len"},
+        "vl_embs": {0: "batch", 1: "vl_seq_len"},
+        "timestep": {0: "batch"},
+        "output": {0: "batch", 1: "sa_seq_len"},
+    }
+
+    use_image_mask = captured_inputs.image_mask is not None
+    use_backbone_mask = captured_inputs.backbone_attention_mask is not None
+    if use_image_mask:
+        image_mask = captured_inputs.image_mask.to(device=device)
+        if batch_size > 1 and image_mask.shape[0] == 1:
+            image_mask = image_mask.repeat(batch_size, 1)
+        example_inputs.append(image_mask)
+        input_names.append("image_mask")
+        dynamic_axes["image_mask"] = {0: "batch", 1: "vl_seq_len"}
+    if use_backbone_mask:
+        backbone_mask = captured_inputs.backbone_attention_mask.to(device=device)
+        if batch_size > 1 and backbone_mask.shape[0] == 1:
+            backbone_mask = backbone_mask.repeat(batch_size, 1)
+        example_inputs.append(backbone_mask)
+        input_names.append("backbone_attention_mask")
+        dynamic_axes["backbone_attention_mask"] = {0: "batch", 1: "vl_seq_len"}
+
+    class DiTWrapper(nn.Module):
+        def __init__(self, dit, with_image_mask, with_backbone_mask):
+            super().__init__()
+            self.dit = dit
+            self.with_image_mask = with_image_mask
+            self.with_backbone_mask = with_backbone_mask
+
+        def forward(self, sa_embs, vl_embs, timestep, image_mask=None, backbone_attention_mask=None):
+            kwargs = {}
+            if self.with_image_mask and image_mask is not None:
+                kwargs["image_mask"] = image_mask
+            if self.with_backbone_mask and backbone_attention_mask is not None:
+                kwargs["backbone_attention_mask"] = backbone_attention_mask
+            return self.dit(sa_embs, vl_embs, timestep, **kwargs)
+
+    try:
+        return _export_module_via_onnx_to_ov(
+            model=DiTWrapper(dit_model, use_image_mask, use_backbone_mask).eval(),
+            example_inputs=tuple(example_inputs),
+            input_names=input_names,
+            output_names=["output"],
+            dynamic_axes=dynamic_axes,
+            output_path=output_path,
+            do_constant_folding=True,
+            verify_label="DiT",
+        )
+    finally:
+        restore_attention_processors(dit_model, original_processors)
+
