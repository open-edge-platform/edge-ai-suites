+#!/usr/bin/env python3
+
+"""Export a single OpenVINO IR for the GR00T N1.7 neural pipeline.
+
+This script reuses the ONNX-first export helpers from
+`export_ov_n1d7_all_onnx.py`, but composes the model into one wrapper instead
+of exporting separate ViT / LLM / VL-Self-Attn / action-head components.
+
+The exported model intentionally starts from processor-ready tensors rather than
+raw Python observations. The single OV model covers all learned neural modules:
+
+    pixel_values -> vision tower -> image_embeds / deepstack
+    input_ids + image_embeds + position_ids -> LLM
+    LLM -> vlln -> vl_self_attention
+    state + embodiment_id -> state_encoder
+    backbone features + state features + embodiment_id + actions -> fused DiT
+
+Inputs:
+    - input_ids: [B, S]
+    - attention_mask: [B, S]
+    - pixel_values: [num_patches, patch_dim]
+    - position_ids: [3, B, S]
+    - state: [B, state_history_len, state_dim]
+    - embodiment_id: [B]
+    - actions: [B, action_horizon, action_dim]
+
+Output:
+    - predicted_action: [B, action_horizon, action_dim]
+
+Notes:
+    - The model still expects runtime-prepared `position_ids`. This keeps the
+      export stable while still collapsing the learned modules into one IR.
+    - The vision grid geometry is captured from one sample and baked into the
+      exported vision wrapper, matching the existing split-component exporter.
+"""
+
+from __future__ import annotations
+
+import copy
+from dataclasses import dataclass
+import json
+import logging
+import os
+from pathlib import Path
+from typing import Literal, Optional
+
+from diffusers.models.attention_processor import AttnProcessor2_0
+from gr00t.data.dataset.lerobot_episode_loader import LeRobotEpisodeLoader
+from gr00t.data.embodiment_tags import EmbodimentTag
+from gr00t.data.types import MessageType
+from gr00t.policy.gr00t_policy import Gr00tPolicy, _rec_to_dtype
+import numpy as np
+import torch
+import torch.nn as nn
+import tyro
+
+import export_ov_n1d7_all_onnx as shared
+
+
+logging.basicConfig(level=logging.INFO, format="%(asctime)s - %(levelname)s - %(message)s")
+logger = logging.getLogger(__name__)
+
+
+@dataclass
+class ExportConfig:
+    model_path: str
+    dataset_path: Optional[str] = None
+    embodiment_tag: Optional[EmbodimentTag] = None
+    output_dir: str = "./gr00t_n1d7_single_ov"
+    output_name: str = "gr00t_n1d7_single"
+    video_backend: Literal["decord", "torchvision_av", "torchcodec"] = "torchcodec"
+    precision: Literal["fp32", "fp16"] = "fp32"
+    batch_size: int = 1
+    num_inference_timesteps: Optional[int] = None
+    device: str = "cpu"
+
+
+class LLMForSingleOV(nn.Module):
+    def __init__(self, text_model: nn.Module, select_layer: int):
+        super().__init__()
+        from transformers.models.qwen3_vl.modeling_qwen3_vl import (
+            Qwen3VLTextDecoderLayer,
+            Qwen3VLTextRotaryEmbedding,
+        )
+
+        text_config = copy.deepcopy(text_model.config)
+        text_config._attn_implementation = "eager"
+        text_config.num_hidden_layers = select_layer
+        self.layers = nn.ModuleList(
+            [Qwen3VLTextDecoderLayer(text_config, layer_idx) for layer_idx in range(text_config.num_hidden_layers)]
+        )
+        self.rotary_emb = Qwen3VLTextRotaryEmbedding(config=text_config)
+
+        src_state = text_model.state_dict()
+        dst_state = self.state_dict()
+        for key in list(dst_state):
+            if key in src_state:
+                dst_state[key] = src_state[key]
+        self.load_state_dict(dst_state, strict=False)
+
+    def _traceable_causal_mask(self, inputs_embeds, attention_mask):
+        batch_size, seq_len = inputs_embeds.shape[:2]
+        device = inputs_embeds.device
+        dtype = inputs_embeds.dtype
+        min_dtype = torch.finfo(dtype).min
+
+        causal = torch.tril(torch.ones((seq_len, seq_len), device=device, dtype=torch.bool))
+        mask = causal.unsqueeze(0).unsqueeze(0).expand(batch_size, 1, seq_len, seq_len)
+        if attention_mask is not None:
+            padding_mask = attention_mask[:, None, None, :].to(torch.bool)
+            mask = mask & padding_mask
+        return torch.where(
+            mask,
+            torch.zeros((), device=device, dtype=dtype),
+            torch.full((), min_dtype, device=device, dtype=dtype),
+        )
+
+    def forward(
+        self,
+        inputs_embeds,
+        position_ids,
+        attention_mask=None,
+        deepstack_delta_0=None,
+        deepstack_delta_1=None,
+        deepstack_delta_2=None,
+    ):
+        device = inputs_embeds.device
+        text_position_ids = position_ids[0]
+        cache_position = torch.arange(inputs_embeds.shape[1], device=device)
+        attn_mask = self._traceable_causal_mask(inputs_embeds, attention_mask)
+        hidden_states = inputs_embeds
+        position_embeddings = self.rotary_emb(hidden_states, position_ids)
+        deepstack_list = [
+            tensor for tensor in (deepstack_delta_0, deepstack_delta_1, deepstack_delta_2) if tensor is not None
+        ]
+
+        for layer_idx, decoder_layer in enumerate(self.layers):
+            hidden_states = decoder_layer(
+                hidden_states,
+                attention_mask=attn_mask,
+                position_ids=text_position_ids,
+                past_key_values=None,
+                cache_position=cache_position,
+                position_embeddings=position_embeddings,
+            )
+            if layer_idx < len(deepstack_list):
+                hidden_states = hidden_states + deepstack_list[layer_idx]
+        return hidden_states
+
+
+class SingleOVWrapper(nn.Module):
+    def __init__(self, policy: Gr00tPolicy, grid_thw: torch.Tensor, use_fp32: bool):
+        super().__init__()
+        backbone = policy.model.backbone
+        action_head = policy.model.action_head
+        qwen_model = backbone.model
+        inner_model = qwen_model.model
+        dtype = torch.float32 if use_fp32 else torch.bfloat16
+
+        vision_model = qwen_model.model.visual.to(dtype).eval()
+        self.vision = shared.Qwen3VisionForExport(vision_model, grid_thw).to(dtype).eval()
+        self.embed_tokens = inner_model.language_model.embed_tokens
+        self.image_token_id = qwen_model.config.image_token_id
+        self.llm = LLMForSingleOV(inner_model.language_model, backbone.select_layer).to(dtype).eval()
+        self.vlln = action_head.vlln.to(dtype).eval()
+        self.vl_self_attention = action_head.vl_self_attention.to(dtype).eval()
+        self.state_encoder = action_head.state_encoder.to(dtype).eval()
+        self.dit_fused = shared.DiT_Fused(action_head).to(dtype).eval()
+        self.state_history_length = action_head.config.state_history_length
+        self.register_buffer("_grid_thw", grid_thw.clone().detach().to(torch.int64), persistent=False)
+
+    def _build_dense_delta(self, visual_embeds, visual_pos_masks, batch_size, device, dtype):
+        """Build [B, S, H] dense deltas from ordered visual tokens without boolean indexing.
+
+        This keeps the graph ONNX-friendly by avoiding boolean indexing / NonZero-heavy
+        subgraphs. The visual tokens are assumed to be ordered the same way as the true
+        positions in `visual_pos_masks`.
+        """
+        mask = visual_pos_masks.to(device=device, dtype=torch.bool)
+        if mask.shape[0] == 1 and batch_size > 1:
+            mask = mask.expand(batch_size, -1)
+
+        visual_embeds = visual_embeds.to(device=device, dtype=dtype)
+        if visual_embeds.ndim == 2:
+            visual_embeds = visual_embeds.unsqueeze(0).expand(batch_size, -1, -1)
+        elif visual_embeds.shape[0] == 1 and batch_size > 1:
+            visual_embeds = visual_embeds.expand(batch_size, -1, -1)
+
+        token_indices = torch.cumsum(mask.to(torch.int64), dim=1) - 1
+        token_indices = torch.clamp(token_indices, min=0)
+        gather_index = token_indices.unsqueeze(-1).expand(-1, -1, visual_embeds.shape[-1])
+        gathered = torch.gather(visual_embeds, 1, gather_index)
+        return gathered * mask.unsqueeze(-1).to(dtype)
+
+    def _dense_deepstack_deltas(self, deepstack, visual_pos_masks, seq_len, batch_size, device, dtype):
+        deepstack_visual_embeds = []
+        if deepstack.ndim >= 3 and deepstack.shape[0] > 1:
+            for layer_idx in range(min(3, deepstack.shape[0])):
+                layer_tensor = deepstack[layer_idx]
+                if layer_tensor.ndim == 3:
+                    layer_tensor = layer_tensor.reshape(-1, layer_tensor.shape[-1])
+                deepstack_visual_embeds.append(layer_tensor)
+        elif deepstack.numel() > 1:
+            if deepstack.ndim == 3:
+                deepstack = deepstack.reshape(-1, deepstack.shape[-1])
+            deepstack_visual_embeds = [deepstack]
+
+        dense_deltas = []
+        for visual_embeds in deepstack_visual_embeds[:3]:
+            dense_deltas.append(
+                self._build_dense_delta(
+                    visual_embeds=visual_embeds,
+                    visual_pos_masks=visual_pos_masks,
+                    batch_size=batch_size,
+                    device=device,
+                    dtype=dtype,
+                )
+            )
+        return dense_deltas
+
+    def _dense_visual_delta(self, image_embeds, visual_pos_masks, seq_len, batch_size, device, dtype):
+        return self._build_dense_delta(
+            visual_embeds=image_embeds,
+            visual_pos_masks=visual_pos_masks,
+            batch_size=batch_size,
+            device=device,
+            dtype=dtype,
+        )
+
+    def forward(
+        self,
+        input_ids,
+        attention_mask,
+        pixel_values,
+        position_ids,
+        state,
+        embodiment_id,
+        actions,
+    ):
+        image_embeds, deepstack = self.vision(pixel_values)
+        if image_embeds.ndim == 3:
+            image_embeds = image_embeds.reshape(-1, image_embeds.shape[-1])
+
+        word_embeddings = self.embed_tokens(input_ids)
+        if word_embeddings.dtype != image_embeds.dtype:
+            word_embeddings = word_embeddings.to(image_embeds.dtype)
+
+        # Build the image placeholder mask explicitly instead of tracing the
+        # Qwen helper, which expands into fragile shape/NonZero ONNX subgraphs.
+        visual_pos_masks = input_ids == self.image_token_id
+        image_delta = self._dense_visual_delta(
+            image_embeds=image_embeds,
+            visual_pos_masks=visual_pos_masks,
+            seq_len=word_embeddings.shape[1],
+            batch_size=word_embeddings.shape[0],
+            device=word_embeddings.device,
+            dtype=word_embeddings.dtype,
+        )
+        inputs_embeds = word_embeddings + image_delta
+        deepstack_deltas = self._dense_deepstack_deltas(
+            deepstack=deepstack,
+            visual_pos_masks=visual_pos_masks,
+            seq_len=inputs_embeds.shape[1],
+            batch_size=inputs_embeds.shape[0],
+            device=inputs_embeds.device,
+            dtype=inputs_embeds.dtype,
+        )
+
+        llm_hidden_states = self.llm(
+            inputs_embeds,
+            position_ids,
+            attention_mask,
+            *deepstack_deltas,
+        )
+        llm_hidden_states = self.vlln(llm_hidden_states)
+        vl_embs = self.vl_self_attention(llm_hidden_states)
+
+        if state.shape[1] != self.state_history_length:
+            raise ValueError("state history length does not match model config")
+        state = state.view(state.shape[0], 1, -1)
+        state_features = self.state_encoder(state, embodiment_id)
+
+        image_mask_out = input_ids == self.image_token_id
+        backbone_attention_mask = attention_mask == 1
+        predicted_action = self.dit_fused(
+            state_features,
+            vl_embs,
+            embodiment_id,
+            actions,
+            image_mask=image_mask_out,
+            backbone_attention_mask=backbone_attention_mask,
+        )
+        return predicted_action
+
+
+def _expand_batch_tensor(tensor: torch.Tensor, batch_size: int, batch_dim: int = 0) -> torch.Tensor:
+    if batch_size == 1:
+        return tensor
+    if tensor.shape[batch_dim] == batch_size:
+        return tensor
+    if tensor.shape[batch_dim] != 1:
+        raise ValueError(f"Cannot expand tensor with shape {tuple(tensor.shape)} along dim {batch_dim}")
+    expand_shape = list(tensor.shape)
+    expand_shape[batch_dim] = batch_size
+    return tensor.expand(*expand_shape).clone()
+
+
+def _prepare_observation_and_collated_inputs(policy: Gr00tPolicy, args: ExportConfig):
+    if args.dataset_path:
+        logger.info("\n[Step 2] Loading dataset...")
+        dataset = LeRobotEpisodeLoader(
+            dataset_path=args.dataset_path,
+            modality_configs=policy.get_modality_config(),
+            video_backend=args.video_backend,
+            video_backend_kwargs=None,
+        )
+        logger.info("  Dataset loaded (%d trajectories)", len(dataset))
+        observation = shared.prepare_observation(policy, dataset, traj_idx=0)
+    else:
+        logger.info("\n[Step 2] Using synthesized dummy observation (no dataset)...")
+        observation = shared._build_dummy_observation(policy)
+
+    unbatched_observations = policy._unbatch_observation(observation)
+    processed_inputs = []
+    for obs in unbatched_observations:
+        vla_step_data = policy._to_vla_step_data(obs)
+        messages = [{"type": MessageType.EPISODE_STEP.value, "content": vla_step_data}]
+        processed_inputs.append(policy.processor(messages))
+
+    collated = policy.collate_fn(processed_inputs)
+    collated = _rec_to_dtype(collated, dtype=torch.bfloat16)
+    return collated, observation
+
+
+def _capture_export_artifacts(policy: Gr00tPolicy, collated_inputs: dict):
+    vit_capture = shared.ViTInputCapture()
+    llm_capture = shared.LLMInputCapture()
+    qwen_model = policy.model.backbone.model
+    vit_hook = qwen_model.model.visual.register_forward_hook(vit_capture.hook_fn, with_kwargs=True)
+    llm_hook = qwen_model.model.language_model.register_forward_pre_hook(llm_capture.hook_fn, with_kwargs=True)
+    try:
+        with torch.inference_mode():
+            _ = policy.model.get_action(**collated_inputs)
+    finally:
+        vit_hook.remove()
+        llm_hook.remove()
+
+    if not vit_capture.captured:
+        raise RuntimeError("Failed to capture ViT inputs for single OV export")
+    if not llm_capture.captured:
+        raise RuntimeError("Failed to capture LLM inputs for single OV export")
+    return vit_capture, llm_capture
+
+
+def _build_example_inputs(
+    raw_inputs: dict,
+    llm_capture: shared.LLMInputCapture,
+    batch_size: int,
+    device: str,
+    action_horizon: int,
+    action_dim: int,
+    compute_dtype: torch.dtype,
+):
+    input_ids = _expand_batch_tensor(raw_inputs["input_ids"].to(device), batch_size, batch_dim=0)
+    attention_mask = _expand_batch_tensor(raw_inputs["attention_mask"].to(device), batch_size, batch_dim=0)
+
+    pixel_values = raw_inputs["pixel_values"].to(device=device, dtype=compute_dtype)
+    if batch_size > 1:
+        pixel_values = pixel_values.repeat(batch_size, 1)
+
+    position_ids = _expand_batch_tensor(llm_capture.position_ids.to(device), batch_size, batch_dim=1)
+    state = _expand_batch_tensor(raw_inputs["state"].to(device=device, dtype=compute_dtype), batch_size, batch_dim=0)
+    embodiment_id = _expand_batch_tensor(raw_inputs["embodiment_id"].to(device), batch_size, batch_dim=0).to(torch.int64)
+    actions = torch.zeros(
+        batch_size,
+        action_horizon,
+        action_dim,
+        dtype=compute_dtype,
+        device=device,
+    )
+    return input_ids, attention_mask, pixel_values, position_ids, state, embodiment_id, actions
+
+
+def verify_openvino_single_ov(
+    output_path: str,
+    pytorch_module: torch.nn.Module,
+    example_inputs: tuple[torch.Tensor, ...],
+    input_names: list[str],
+    output_name: str,
+    device: str,
+) -> dict[str, float]:
+    logger.info("  OpenVINO verification for Single-OV Full Pipeline...")
+
+    with torch.inference_mode():
+        pt_output = pytorch_module(*example_inputs)
+        if isinstance(pt_output, (tuple, list)):
+            pt_output = pt_output[0]
+
+    core = shared.ov.Core()
+    ov_device = device.upper()
+    if ov_device not in core.available_devices:
+        logger.warning(
+            "  Requested OV device %s unavailable, falling back to CPU for verification",
+            ov_device,
+        )
+        ov_device = "CPU"
+
+    compiled = core.compile_model(output_path, ov_device)
+    ov_inputs = {name: tensor.detach().cpu().numpy() for name, tensor in zip(input_names, example_inputs)}
+    ov_result = compiled(ov_inputs)
+    ov_output = ov_result[output_name]
+
+    pt_flat = pt_output.float().flatten().cpu()
+    ov_flat = torch.tensor(ov_output).float().flatten()
+    cosine = torch.nn.functional.cosine_similarity(pt_flat.unsqueeze(0), ov_flat.unsqueeze(0)).item()
+    mae = torch.mean(torch.abs(pt_flat - ov_flat)).item()
+    mse = torch.mean((pt_flat - ov_flat) ** 2).item()
+    logger.info(
+        "    %s: OpenVINO vs PyTorch cosine = %.6f, mae = %.6f, mse = %.6f",
+        output_name,
+        cosine,
+        mae,
+        mse,
+    )
+    return {"cosine": cosine, "mae": mae, "mse": mse}
+
+
+def export_single_ov(policy: Gr00tPolicy, collated_inputs: dict, vit_capture, llm_capture, args: ExportConfig) -> str:
+    raw_inputs = collated_inputs["inputs"]
+    # Match the split exporters: export/verify in FP32, then rely on OpenVINO
+    # weight compression to produce the final FP16 IR when requested.
+    dtype = torch.float32
+    device = args.device
+
+    grid_thw = vit_capture.grid_thw.to(device=device)
+    if args.batch_size > 1:
+        grid_thw = grid_thw.repeat(args.batch_size, 1)
+
+    wrapper = SingleOVWrapper(policy, grid_thw=grid_thw, use_fp32=args.precision == "fp32")
+    wrapper = wrapper.to(dtype).eval().to(device)
+
+    qwen_model = policy.model.backbone.model
+    vision_model = qwen_model.model.visual
+    chunk_sizes = torch.repeat_interleave(grid_thw[:, 1] * grid_thw[:, 2], grid_thw[:, 0]).tolist()
+    vision_originals = shared._patch_vision_attention_for_export(vision_model, chunk_sizes=chunk_sizes)
+    original_processors = shared.replace_attention_processors_for_onnx(wrapper)
+    try:
+        example_inputs = _build_example_inputs(
+            raw_inputs,
+            llm_capture,
+            args.batch_size,
+            device,
+            action_horizon=policy.model.action_head.config.action_horizon,
+            action_dim=policy.model.action_head.config.max_action_dim,
+            compute_dtype=dtype,
+        )
+        input_names = [
+            "input_ids",
+            "attention_mask",
+            "pixel_values",
+            "position_ids",
+            "state",
+            "embodiment_id",
+            "actions",
+        ]
+        dynamic_axes = {
+            "input_ids": {0: "batch", 1: "seq_len"},
+            "attention_mask": {0: "batch", 1: "seq_len"},
+            "pixel_values": {0: "num_patches"},
+            "position_ids": {1: "batch", 2: "seq_len"},
+            "state": {0: "batch"},
+            "embodiment_id": {0: "batch"},
+            "actions": {0: "batch"},
+            "predicted_action": {0: "batch"},
+        }
+        precision_tag = "fp16" if shared._COMPRESS_TO_FP16 else "fp32"
+        output_path = os.path.join(args.output_dir, f"{args.output_name}_{precision_tag}.xml")
+        logger.info("\n%s\nExporting single-OV full pipeline via ONNX -> OpenVINO\n%s", "=" * 80, "=" * 80)
+        exported_path = shared._export_module_via_onnx_to_ov(
+            model=wrapper,
+            example_inputs=example_inputs,
+            input_names=input_names,
+            output_names=["predicted_action"],
+            dynamic_axes=dynamic_axes,
+            output_path=output_path,
+            do_constant_folding=False,
+            verify_label="Single-OV Full Pipeline",
+        )
+        verify_openvino_single_ov(
+            output_path=exported_path,
+            pytorch_module=wrapper,
+            example_inputs=example_inputs,
+            input_names=input_names,
+            output_name="predicted_action",
+            device=device,
+        )
+        return exported_path
+    finally:
+        shared.restore_attention_processors(wrapper, original_processors)
+        shared._restore_vision_attention(vision_model, vision_originals)
+
+
+def main(args: ExportConfig) -> None:
+    args.embodiment_tag = shared._resolve_embodiment_tag(args.model_path, args.embodiment_tag)
+    shared._DEVICE = args.device
+    shared._COMPRESS_TO_FP16 = args.precision == "fp16"
+
+    logger.info("=" * 80)
+    logger.info("GR00T N1.7 Single-OV Export Script")
+    logger.info("=" * 80)
+    logger.info("Model path: %s", args.model_path)
+    logger.info("Dataset path: %s", args.dataset_path)
+    logger.info("Embodiment: %s", args.embodiment_tag)
+    logger.info("Output directory: %s", args.output_dir)
+    logger.info("Device: %s", args.device)
+    logger.info("Precision: %s", args.precision)
+    logger.info("Batch size: %d", args.batch_size)
+
+    attention_patched = shared.patch_diffusers_attention_for_openvino()
+    try:
+        logger.info("\n[Step 1] Loading policy...")
+        policy = Gr00tPolicy(
+            embodiment_tag=args.embodiment_tag,
+            model_path=args.model_path,
+            device=args.device,
+            enable_ov=True,
+        )
+        logger.info("  Policy loaded")
+
+        if args.num_inference_timesteps is not None:
+            requested_steps = int(args.num_inference_timesteps)
+            if requested_steps <= 0:
+                raise ValueError("num_inference_timesteps must be a positive integer")
+            policy.model.action_head.num_inference_timesteps = requested_steps
+
+        collated_inputs, _ = _prepare_observation_and_collated_inputs(policy, args)
+        vit_capture, llm_capture = _capture_export_artifacts(policy, collated_inputs)
+
+        os.makedirs(args.output_dir, exist_ok=True)
+        metadata = {
+            "model_version": "n1d7",
+            "format": "openvino",
+            "export_mode": "single_ov",
+            "precision": args.precision,
+            "batch_size": args.batch_size,
+            "embodiment_tag": str(args.embodiment_tag),
+            "fixed_grid_thw": vit_capture.grid_thw.tolist(),
+            "seq_len": int(llm_capture.inputs_embeds.shape[1]),
+            "hidden_size": int(llm_capture.inputs_embeds.shape[2]),
+            "num_inference_timesteps": int(policy.model.action_head.num_inference_timesteps),
+            "notes": [
+                "single OV expects runtime-prepared position_ids",
+                "vision grid_thw is captured once and baked into the export",
+                "actions input is the initial denoising trajectory / noise seed",
+            ],
+        }
+        metadata_path = os.path.join(args.output_dir, f"{args.output_name}_metadata.json")
+        with open(metadata_path, "w") as f:
+            json.dump(metadata, f, indent=2)
+        logger.info("  Saved export metadata to %s", metadata_path)
+
+        output_path = export_single_ov(policy, collated_inputs, vit_capture, llm_capture, args)
+        logger.info("\nSingle-OV export complete: %s", output_path)
+    finally:
+        if attention_patched:
+            shared.restore_diffusers_attention()
+
+
+if __name__ == "__main__":
