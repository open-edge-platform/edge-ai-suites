+
+    # Step 4: Export
+    bs = args.batch_size
+    # IMPORTANT: Always use FP32 for PyTorch→OpenVINO conversion to avoid mixed precision issues
+    # The actual precision is controlled by compress_to_fp16 parameter in ov.save_model()
+    use_fp32 = True  # Always convert with FP32 tensors
+    precision_tag = "fp32" if args.precision == "fp32" else "fp16"
+
+    # Set global compression flag based on desired precision
