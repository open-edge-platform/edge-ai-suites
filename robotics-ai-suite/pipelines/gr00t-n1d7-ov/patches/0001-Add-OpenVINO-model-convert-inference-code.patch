+        t0 = time.perf_counter()
+        model_output = self.dit_ov_model([
+            sa_embs.cpu().numpy(),
+            vl_embeds.cpu().numpy(),
+            timesteps_tensor.cpu().numpy(),
+            image_mask.cpu().numpy(),
+            backbone_mask.cpu().numpy(),
+        ])[0]
+        model_output = torch.from_numpy(model_output) if isinstance(model_output, np.ndarray) else model_output
+        self._timing_stats["dit_total"] += time.perf_counter() - t0
+
+        t0 = time.perf_counter()
+        pred = self.action_decoder_ov_model([model_output.cpu().numpy(), embodiment_id.cpu().numpy()])[0]
+        pred = torch.from_numpy(pred) if isinstance(pred, np.ndarray) else pred
+        self._timing_stats["action_decoder_total"] += time.perf_counter() - t0
+        pred_velocity = pred[:, -self.action_horizon :, :]
+        actions = actions + dt * pred_velocity
+
+    return BatchFeature(data={"action_pred": actions})
+
+
+def action_head_fused_openvino_forward_full(self, backbone_output, action_input, options=None):
+    if not hasattr(self, "_timing_stats"):
+        self._timing_stats = {}
+    vl_embeds = backbone_output["backbone_features"]
+    if vl_embeds.dtype != torch.float32:
+        vl_embeds = vl_embeds.to(torch.float32)
+
+    embodiment_id = action_input.embodiment_id.to(torch.int64) if action_input.embodiment_id.dtype != torch.int64 else action_input.embodiment_id
+    state = action_input.state.view(action_input.state.shape[0], 1, -1)
+    if state.dtype != torch.float32:
+        state = state.to(torch.float32)
+
+    t0 = time.perf_counter()
+    state_features = self.state_encoder_ov_model([state.cpu().numpy(), embodiment_id.cpu().numpy()])[0]
+    state_features = torch.from_numpy(state_features) if isinstance(state_features, np.ndarray) else state_features
+    self._timing_stats["state_encoder"] = time.perf_counter() - t0
+
+    batch_size = vl_embeds.shape[0]
+    device = state.device
+    actions = torch.randn((batch_size, self.config.action_horizon, self.action_dim), dtype=torch.float32, device=device)
+    if hasattr(self, "init_actions"):
+        actions = self.init_actions.expand((batch_size, -1, -1))
+    image_mask = backbone_output["image_mask"].to(torch.bool).to(device)
+    backbone_mask = backbone_output["backbone_attention_mask"].to(torch.bool).to(device)
+
+    t0 = time.perf_counter()
+    actions_out = self.dit_fused_ov_model([
+        state_features.cpu().numpy(),
+        vl_embeds.cpu().numpy(),
+        embodiment_id.cpu().numpy(),
+        actions.cpu().numpy(),
+        image_mask.cpu().numpy(),
+        backbone_mask.cpu().numpy(),
+    ])[0]
+    actions = torch.from_numpy(actions_out) if isinstance(actions_out, np.ndarray) else actions_out
+    self._timing_stats["dit_fused"] = time.perf_counter() - t0
+    return BatchFeature(data={"action_pred": actions})
+
