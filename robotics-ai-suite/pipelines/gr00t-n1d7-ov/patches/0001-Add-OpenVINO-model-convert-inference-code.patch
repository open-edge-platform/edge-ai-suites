+    state_features = self.state_encoder_ov_model([state.cpu().numpy(), embodiment_id.cpu().numpy()])[0]
+    state_features = torch.from_numpy(state_features) if isinstance(state_features, np.ndarray) else state_features
+
+    batch_size = vl_embeds.shape[0]
+    device = state.device
+    actions = torch.randn((batch_size, self.config.action_horizon, self.action_dim), dtype=torch.float32, device=device)
+    if hasattr(self, "init_actions"):
