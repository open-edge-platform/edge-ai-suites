+
+    model_path: str
+    """Path to the model checkpoint (required)."""
+
+    dataset_path: Optional[str] = None
+    """Optional dataset path. If omitted, the exporter uses a synthesized dummy observation to capture input shapes."""
+
+    embodiment_tag: Optional[EmbodimentTag] = None
+    """Embodiment tag. If not provided, auto-detected from model's processor_config.json."""
+
+    output_dir: str = "./gr00t_n1d7_ov"
+    """Output directory for OpenVINO IR models."""
+
+    export_mode: Literal["dit_only", "action_head", "full_pipeline"] = "dit_only"
+    """Export mode: 'dit_only', 'action_head' (4 components), or 'full_pipeline' (ViT + action head)."""
+
+    use_fused_dit: bool = False
+    """Export fused DiT (combines action_encoder + DiT + action_decoder into single model)."""
+
+    video_backend: Literal["decord", "torchvision_av", "torchcodec"] = "torchcodec"
+    """Video backend to use."""
+
+    precision: Literal["fp32", "fp16"] = "fp32"
+    """Export precision: 'fp32' (default) or 'fp16'. OpenVINO weight compression is controlled at save time."""
+
+    batch_size: int = 1
+    """Batch size baked into the exported models (default: 1)."""
+
+    num_inference_timesteps: Optional[int] = None
+    """Optional override for action-head denoising steps during export."""
+
+    device: str = "cpu"
+    """Device to use for export: 'cpu' (default, no GPU needed) or 'cuda'."""
+
