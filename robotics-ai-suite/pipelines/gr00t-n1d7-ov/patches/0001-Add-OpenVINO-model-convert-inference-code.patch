+    logger.info(f"  State keys: {modality_configs['state'].modality_keys}")
+    logger.info(f"  State dims: {state_dims}")
+    logger.info(f"  Action keys: {modality_configs['action'].modality_keys}")
+    logger.info(f"  Action horizon: {len(modality_configs['action'].delta_indices)}")
+    logger.info(f"  Language keys: {modality_configs['language'].modality_keys}")
