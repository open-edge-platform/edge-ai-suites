@@ -0,0 +1,1516 @@
+#!/usr/bin/env python3
+"""Generic OpenVINO-accelerated GR00T N1.7 dataset runner.
+
+This module centralizes the common runtime flow used by embodiment-specific
+wrappers:
+- load Gr00tPolicy
+- swap PyTorch modules for OpenVINO modules
+- iterate over a LeRobot dataset
+- warm up, time inference, and summarize timings
+
+Embodiment-specific wrappers provide a small adapter that defines how to:
+- map `num_cameras` to camera names
+- build modality configs
+- load any dataset-specific task metadata
+- convert one dataset row into an observation for `policy.get_action()`
+"""
+
+from __future__ import annotations
+
+import argparse
+from dataclasses import dataclass
+from functools import partial
+import logging
+import time
+from pathlib import Path
+from typing import Any, Callable
+
+import numpy as np
+import openvino as ov
+import openvino.properties.hint as hints
+import torch
+from transformers.feature_extraction_utils import BatchFeature
+
+from gr00t.data.dataset.lerobot_episode_loader import LeRobotEpisodeLoader
+from gr00t.data.embodiment_tags import EmbodimentTag
+from gr00t.data.types import ModalityConfig
+from gr00t.policy.gr00t_policy import Gr00tPolicy
+from export_ov_n1d7 import build_dense_token_delta
+
+
+logging.basicConfig(level=logging.INFO, format="%(asctime)s - %(levelname)s - %(message)s")
+logger = logging.getLogger(__name__)
+
+
+def _build_dense_deepstack_deltas(
+    deepstack_visual_embeds: list[torch.Tensor],
+    visual_pos_masks: torch.Tensor | None,
+    batch_size: int,
+    device: torch.device,
+) -> list[np.ndarray]:
+    if visual_pos_masks is None:
+        return []
+
+    dense_deltas: list[np.ndarray] = []
+    for visual_embeds in deepstack_visual_embeds[:3]:
+        dense_deltas.append(
+            build_dense_token_delta(
+                visual_pos_masks=visual_pos_masks,
+                visual_embeds=visual_embeds,
+                batch_size=batch_size,
+                device=device,
+                dtype=torch.float32,
+            ).cpu().numpy()
+        )
+
+    return dense_deltas
+
+
+def _format_ov_partial_shape(port) -> str:
+    try:
+        return str(port.get_partial_shape())
+    except RuntimeError:
+        return "<unknown>"
+
+
+def _ov_port_rank(port) -> int | None:
+    try:
+        return len(port.get_partial_shape())
+    except RuntimeError:
+        return None
+
+
+def _ov_port_type_name(port) -> str:
+    try:
+        return port.get_element_type().get_type_name().lower()
+    except RuntimeError:
+        return ""
+
+
+def _detect_precision_suffix(ov_model_path: Path) -> str:
+    for suffix in ["fp16_int8", "fp16_int4", "fp16", "fp32"]:
+        if (ov_model_path / f"vit_{suffix}.xml").exists():
+            return suffix
+    raise FileNotFoundError(
+        f"No precision-suffixed ViT model found in {ov_model_path}. "
+        "Expected vit_fp16.xml, vit_fp32.xml, vit_fp16_int8.xml, or vit_fp16_int4.xml"
+    )
+
+
+def _set_device_precision_hint(core, device: str, available_devices: list[str], precision_suffix: str) -> None:
+    device_upper = device.upper()
+    if device_upper == "GPU" and "GPU" in available_devices:
+        if precision_suffix == "fp32":
+            core.set_property("GPU", {hints.inference_precision: ov.Type.f32})
+            print("  GPU inference precision: FP32")
+        elif precision_suffix == "fp16":
+            core.set_property("GPU", {hints.inference_precision: ov.Type.f16})
+            print("  GPU inference precision: FP16")
+        else:
+            print(f"  GPU inference precision: native {precision_suffix.upper()}")
+
+
+def _load_compiled_model(core, ov_model_path: Path, component_name: str, precision_suffix: str, device: str):
+    model_path = ov_model_path / f"{component_name}_{precision_suffix}.xml"
+    if not model_path.exists():
+        raise FileNotFoundError(f"Expected model file not found: {model_path}")
+    model = core.read_model(str(model_path))
+    return core.compile_model(model, device_name=device)
+
+
+def _resolve_backbone_masks(backbone_output, batch_size: int, seq_len: int, device):
+    image_mask = backbone_output.get("image_mask")
+    backbone_mask = backbone_output.get("backbone_attention_mask")
+
+    if image_mask is None:
+        image_mask = torch.ones((batch_size, seq_len), dtype=torch.bool, device=device)
+    else:
+        image_mask = image_mask.to(device=device, dtype=torch.bool)
+
+    if backbone_mask is None:
+        backbone_mask = torch.ones((batch_size, seq_len), dtype=torch.bool, device=device)
+    else:
+        backbone_mask = backbone_mask.to(device=device, dtype=torch.bool)
+
+    return image_mask, backbone_mask
+
+
+def _should_use_fused_dit(ov_model_path: Path, precision_suffix: str, requested: bool) -> bool:
+    if not requested:
+        return False
+
+    fused_path = ov_model_path / f"dit_fused_{precision_suffix}.xml"
+    if fused_path.exists():
+        return True
+
+    component_paths = [
+        ov_model_path / f"action_encoder_{precision_suffix}.xml",
+        ov_model_path / f"dit_{precision_suffix}.xml",
+        ov_model_path / f"action_decoder_{precision_suffix}.xml",
+    ]
+    if all(path.exists() for path in component_paths):
+        print(
+            f"  WARNING: requested fused DiT, but {fused_path.name} was not found. "
+            "Falling back to 4-component mode."
+        )
+        return False
+
+    raise FileNotFoundError(
+        f"Requested fused DiT, but {fused_path} was not found, and the fallback 4-component files "
+        f"are also incomplete under {ov_model_path}."
+    )
+
+
+def qwen3_backbone_openvino_forward(self, vl_input):
+    if not hasattr(self, "_timing_stats"):
+        self._timing_stats = {}
+
+    qwen_model = self.model
+    inner_model = self.model
+
+    pixel_values = vl_input["pixel_values"]
+    if pixel_values.dtype != torch.float32:
+        pixel_values = pixel_values.to(torch.float32)
+
+    t0 = time.perf_counter()
+    vit_result = self.vit_ov_model([pixel_values.cpu().numpy()])
+    self._timing_stats["vit"] = time.perf_counter() - t0
+    image_embeds = torch.from_numpy(vit_result[0]) if isinstance(vit_result[0], np.ndarray) else vit_result[0]
+    deepstack = torch.from_numpy(vit_result[1]) if isinstance(vit_result[1], np.ndarray) else vit_result[1]
+
+    if deepstack.shape[0] == 3:
+        deepstack_visual_embeds = [deepstack[0], deepstack[1], deepstack[2]]
+    else:
+        deepstack_visual_embeds = [deepstack, deepstack, deepstack]
+
+    original_visual_forward = None
+    if hasattr(inner_model, "visual"):
+        original_visual_forward = inner_model.visual.forward
+        inner_model.visual.forward = lambda pixel_values, grid_thw: (image_embeds, deepstack_visual_embeds)
+
+    try:
+        t0 = time.perf_counter()
+        outputs = qwen_model(**vl_input, output_hidden_states=True)
+        self._timing_stats["llm"] = time.perf_counter() - t0
+        last_hidden_state = outputs.hidden_states[-1]
