+    vl_embeds = backbone_features.to(torch.float32) if backbone_features.dtype != torch.float32 else backbone_features
+    embodiment_id = action_input.embodiment_id.to(torch.int64) if action_input.embodiment_id.dtype != torch.int64 else action_input.embodiment_id
+    state = action_input.state.view(action_input.state.shape[0], 1, -1)
+    if state.dtype != torch.float32:
