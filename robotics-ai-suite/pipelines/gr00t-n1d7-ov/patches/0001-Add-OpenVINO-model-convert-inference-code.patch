+def _collect_timing_breakdown(policy: Gr00tPolicy) -> dict[str, Any]:
+    timing_breakdown: dict[str, Any] = {}
+    if hasattr(policy.model.backbone, "_timing_stats"):
+        backbone_stats = policy.model.backbone._timing_stats
+        timing_breakdown["vit"] = backbone_stats.get("vit", 0)
+        timing_breakdown["llm_prep"] = backbone_stats.get("llm_prep", 0)
+        timing_breakdown["llm_prep_embed_tokens"] = backbone_stats.get("llm_prep_embed_tokens", 0)
+        timing_breakdown["llm_prep_mask_scatter"] = backbone_stats.get("llm_prep_mask_scatter", 0)
+        timing_breakdown["llm_prep_rope"] = backbone_stats.get("llm_prep_rope", 0)
+        timing_breakdown["llm_prep_trim"] = backbone_stats.get("llm_prep_trim", 0)
+        timing_breakdown["llm_prep_to_numpy"] = backbone_stats.get("llm_prep_to_numpy", 0)
+        timing_breakdown["llm_prep_dense_delta"] = backbone_stats.get("llm_prep_dense_delta", 0)
+        timing_breakdown["llm"] = backbone_stats.get("llm", 0)
+        timing_breakdown["vl_self_attention_backbone"] = backbone_stats.get("vl_self_attention", 0)
+    if hasattr(policy.model.action_head, "_timing_stats"):
+        action_stats = policy.model.action_head._timing_stats
+        timing_breakdown["vlln"] = action_stats.get("vlln", 0)
+        timing_breakdown["vl_self_attention"] = action_stats.get("vl_self_attention", 0)
+        timing_breakdown["state_encoder"] = action_stats.get("state_encoder", 0)
+        timing_breakdown["dit_fused"] = action_stats.get("dit_fused", 0)
+        timing_breakdown["action_encoder_total"] = action_stats.get("action_encoder_total", 0)
+        timing_breakdown["dit_total"] = action_stats.get("dit_total", 0)
+        timing_breakdown["action_decoder_total"] = action_stats.get("action_decoder_total", 0)
+        timing_breakdown["num_steps"] = policy.model.action_head.num_inference_timesteps
+    return timing_breakdown
+
+
+def _summarize_results(results: list[dict[str, Any]], total_time: float) -> None:
+    logger.info("\n" + "=" * 80)
+    logger.info("RESULTS (excluding warmup)")
+    logger.info("=" * 80)
+
+    if not results:
+        logger.warning("No successful inferences")
+        logger.info("=" * 80)
+        return
+
+    avg_time = total_time / len(results)
+    fps = len(results) / total_time
+    inference_times = [result["inference_time"] for result in results]
+    min_inference_time = min(inference_times)
+    max_inference_time = max(inference_times)
+
+    logger.info(f"Episodes processed: {len(results)}")
+    logger.info(f"Average inference time (steady state): {avg_time:.3f}s")
+    logger.info(f"Min inference time: {min_inference_time:.3f}s")
+    logger.info(f"Max inference time: {max_inference_time:.3f}s")
+    logger.info(f"FPS: {fps:.2f}")
+    logger.info("")
+    logger.info("Timing Breakdown (average across all episodes):")
+    logger.info("-" * 80)
+
+    if not results[0]["timing_breakdown"]:
+        logger.info("  Timing breakdown not available")
+        logger.info("")
+        logger.info("=" * 80)
+        return
+
+    timing_keys = [
+        "vit",
+        "llm_prep",
+        "llm_prep_embed_tokens",
+        "llm_prep_mask_scatter",
+        "llm_prep_rope",
+        "llm_prep_trim",
+        "llm_prep_to_numpy",
+        "llm_prep_dense_delta",
+        "llm",
+        "vl_self_attention_backbone",
+        "vlln",
+        "vl_self_attention",
+        "state_encoder",
+        "dit_fused",
+        "action_encoder_total",
+        "dit_total",
+        "action_decoder_total",
+    ]
+    timing_stats = {}
+    for key in timing_keys:
+        values = [r["timing_breakdown"].get(key, 0) for r in results if r["timing_breakdown"].get(key, 0) > 0]
+        if values:
+            timing_stats[key] = {
+                "mean": np.mean(values),
+                "std": np.std(values),
+                "min": np.min(values),
+                "max": np.max(values),
+            }
+
+    num_steps = results[0]["timing_breakdown"].get("num_steps", 4)
+
+    logger.info("  Backbone:")
+    if "vit" in timing_stats:
+        stats = timing_stats["vit"]
+        logger.info(
+            f"    ViT (OpenVINO):          {stats['mean'] * 1000:7.1f}ms ± {stats['std'] * 1000:5.1f}ms  [{stats['min'] * 1000:.1f} - {stats['max'] * 1000:.1f}]"
+        )
+    if "llm_prep" in timing_stats:
+        stats = timing_stats["llm_prep"]
+        logger.info(
+            f"    LLM prep (PyTorch):      {stats['mean'] * 1000:7.1f}ms ± {stats['std'] * 1000:5.1f}ms  [{stats['min'] * 1000:.1f} - {stats['max'] * 1000:.1f}]"
+        )
+        for stat_key, label in [
+            ("llm_prep_embed_tokens", "embed_tokens"),
+            ("llm_prep_mask_scatter", "mask + scatter"),
+            ("llm_prep_rope", "rope index"),
+            ("llm_prep_trim", "padding trim"),
+            ("llm_prep_to_numpy", "to numpy"),
+            ("llm_prep_dense_delta", "dense delta"),
+        ]:
+            if stat_key in timing_stats:
+                detail_stats = timing_stats[stat_key]
+                logger.info(
+                    f"      - {label:18} {detail_stats['mean'] * 1000:7.1f}ms ± {detail_stats['std'] * 1000:5.1f}ms  [{detail_stats['min'] * 1000:.1f} - {detail_stats['max'] * 1000:.1f}]"
+                )
+    if "llm" in timing_stats:
+        stats = timing_stats["llm"]
+        logger.info(
+            f"    LLM (OpenVINO):          {stats['mean'] * 1000:7.1f}ms ± {stats['std'] * 1000:5.1f}ms  [{stats['min'] * 1000:.1f} - {stats['max'] * 1000:.1f}]"
+        )
+    if "vl_self_attention_backbone" in timing_stats:
+        stats = timing_stats["vl_self_attention_backbone"]
+        logger.info(
+            f"    VL Self-Attn (OpenVINO): {stats['mean'] * 1000:7.1f}ms ± {stats['std'] * 1000:5.1f}ms  [{stats['min'] * 1000:.1f} - {stats['max'] * 1000:.1f}]"
+        )
+
+    logger.info("  Action Head:")
+    if "vlln" in timing_stats:
+        stats = timing_stats["vlln"]
+        logger.info(
+            f"    VLLN (PyTorch):          {stats['mean'] * 1000:7.1f}ms ± {stats['std'] * 1000:5.1f}ms  [{stats['min'] * 1000:.1f} - {stats['max'] * 1000:.1f}]"
+        )
+    if "vl_self_attention" in timing_stats:
