+class DiT_Fused(torch.nn.Module):
+    """
+    Fused DiT model that combines the entire denoising loop into a single forward pass.
+
+    This optimization reduces runtime overhead from multiple model calls during inference.
+    Instead of calling action_encoder → DiT → action_decoder for each timestep,
+    this fused model runs all denoising steps internally.
+
+    Adapted from N1.5 DiT_Fused (deployment_scripts/export_ov.py) for N1.7 architecture.
+    Key difference: N1.7 concatenates (state_features, action_features) while N1.5
+    uses (state_features, future_tokens, action_features).
+    """
+    def __init__(self, action_head):
+        super().__init__()
+        self.config = action_head.config
+        self.action_encoder = action_head.action_encoder
+        self.action_decoder = action_head.action_decoder
+        self.dit = action_head.model
+
+        # N1.7 specific attributes
+        self.add_pos_embed = action_head.config.add_pos_embed
+        if self.add_pos_embed:
+            self.position_embedding = action_head.position_embedding
+
+        self.use_alternate_vl_dit = action_head.config.use_alternate_vl_dit
+        self.denoising_steps = action_head.num_inference_timesteps
+        self.action_horizon = action_head.config.action_horizon
+        self.num_timestep_buckets = action_head.config.num_timestep_buckets
+        self.action_dim = action_head.action_dim
+
+    def forward(
+        self,
+        state_features,
+        vl_embs_tensor,
+        embodiment_id_tensor,
+        actions_tensor,
+        image_mask=None,
+        backbone_attention_mask=None
+    ):
+        """
+        Run the full denoising loop (N1.7 style).
+
+        Args:
+            state_features: Encoded state features (B, state_seq_len, input_embedding_dim)
+                           Already encoded by state_encoder - passed in directly
+            vl_embs_tensor: Vision-language embeddings (B, vl_seq_len, backbone_embedding_dim)
+            embodiment_id_tensor: Embodiment ID (B,)
+            actions_tensor: Initial noisy actions (B, action_horizon, action_dim)
+            image_mask: Optional image mask for AlternateVLDiT (B, vl_seq_len)
+            backbone_attention_mask: Optional attention mask for AlternateVLDiT (B, vl_seq_len)
+
+        Returns:
+            Denoised actions (B, action_horizon, action_dim)
+        """
+        batch_size = actions_tensor.shape[0]
+        device = actions_tensor.device
+        dt = 1.0 / float(self.denoising_steps)
+
+        if image_mask is not None:
+            image_mask = image_mask.to(dtype=torch.bool)
+        if backbone_attention_mask is not None:
+            backbone_attention_mask = backbone_attention_mask.to(dtype=torch.bool)
+
+        # Denoising loop (following N1.7 get_action_with_features implementation)
+        for t in range(self.denoising_steps):
+            t_cont = t / float(self.denoising_steps)  # 0, 1/N, 2/N, ..., (N-1)/N
+            t_discretized = int(t_cont * self.num_timestep_buckets)
+
+            # Embed noised action trajectory
+            timesteps_tensor = torch.full(
+                size=(batch_size,),
+                fill_value=t_discretized,
+                dtype=torch.int64,
+                device=device
+            )
+            action_features = self.action_encoder(
+                actions_tensor, timesteps_tensor, embodiment_id_tensor
+            )
+
+            # Add position embedding (if enabled)
+            if self.add_pos_embed:
+                pos_ids = torch.arange(
+                    action_features.shape[1],
+                    dtype=torch.int64,
+                    device=device
+                )
+                pos_embs = self.position_embedding(pos_ids).unsqueeze(0)
+                action_features = action_features + pos_embs
+
+            # Join state and action embeddings (N1.7 style - no future_tokens)
+            sa_embs = torch.cat((state_features, action_features), dim=1)
+
+            # Run DiT model
+            if self.use_alternate_vl_dit:
+                model_output = self.dit(
+                    hidden_states=sa_embs,
+                    encoder_hidden_states=vl_embs_tensor,
+                    timestep=timesteps_tensor,
+                    image_mask=image_mask,
+                    backbone_attention_mask=backbone_attention_mask,
+                )
+            else:
+                model_output = self.dit(
+                    hidden_states=sa_embs,
+                    encoder_hidden_states=vl_embs_tensor,
+                    timestep=timesteps_tensor,
+                )
+
+            # Decode to velocity
+            pred = self.action_decoder(model_output, embodiment_id_tensor)
+            pred_velocity = pred[:, -self.action_horizon:]
+
+            # Update actions using euler integration
+            actions_tensor = actions_tensor + dt * pred_velocity
+
+        return actions_tensor
+
+
+def export_dit_fused_to_ov(policy, captured_inputs, output_dir, use_fp32=False, batch_size=1):
+    """
+    Export the fused DiT model to OpenVINO IR.
+
+    The fused DiT combines the entire denoising loop (action_encoder → DiT → action_decoder
+    for multiple timesteps) into a single model, which is more efficient for deployment.
+
+    Note: The fused model takes state_features (already encoded) as input, not raw state.
+    During inference, you need to run state_encoder first, then pass the result to dit_fused.
+    """
+    logger.info("\n" + "=" * 80)
+    logger.info("Exporting Fused DiT to OpenVINO IR")
+    logger.info("=" * 80)
+    logger.info("  Note: Fused DiT combines the denoising loop into a single model")
+    logger.info(f"        Denoising steps: {policy.model.action_head.num_inference_timesteps}")
+
+    config = policy.model.action_head.config
+    dtype = torch.float32 if use_fp32 else torch.bfloat16
+    device = _get_device()
+
+    # Create fused model
+    fused_model = DiT_Fused(policy.model.action_head).to(dtype).eval().to(device)
+
+    # Replace processors so attention and mask handling stay export-friendly.
+    logger.info("  Replacing attention processors with export-friendly versions...")
+    original_processors = replace_attention_processors_for_export(fused_model)
+
+    # Create example inputs
+    # state_features should be already encoded by state_encoder
+    state_seq_len = captured_inputs.sa_embs.shape[1] - config.action_horizon
+    vl_seq_len = captured_inputs.vl_embs.shape[1]
+
+    state_features = torch.randn(
+        batch_size, state_seq_len, config.input_embedding_dim,
+        dtype=dtype, device=device
+    )
+    vl_embs_tensor = torch.randn(
+        batch_size, vl_seq_len, config.backbone_embedding_dim,
+        dtype=dtype, device=device
+    )
+    embodiment_id_tensor = torch.zeros(batch_size, dtype=torch.int64, device=device)
+    actions_tensor = torch.randn(
+        batch_size, config.action_horizon, config.max_action_dim,
+        dtype=dtype, device=device
+    )
+
+    # Optional inputs for AlternateVLDiT
+    if config.use_alternate_vl_dit:
+        image_mask = torch.ones(batch_size, vl_seq_len, dtype=torch.bool, device=device)
+        backbone_attention_mask = torch.ones(batch_size, vl_seq_len, dtype=torch.bool, device=device)
+        example_inputs = [
+            state_features,
+            vl_embs_tensor,
+            embodiment_id_tensor,
+            actions_tensor,
+            image_mask,
+            backbone_attention_mask
+        ]
+        logger.info(f"  state_features: {state_features.shape} ({state_features.dtype})")
+        logger.info(f"  vl_embs_tensor: {vl_embs_tensor.shape} ({vl_embs_tensor.dtype})")
+        logger.info(f"  embodiment_id_tensor: {embodiment_id_tensor.shape} ({embodiment_id_tensor.dtype})")
+        logger.info(f"  actions_tensor: {actions_tensor.shape} ({actions_tensor.dtype})")
+        logger.info(f"  image_mask: {image_mask.shape} ({image_mask.dtype})")
+        logger.info(f"  backbone_attention_mask: {backbone_attention_mask.shape} ({backbone_attention_mask.dtype})")
+    else:
+        example_inputs = [state_features, vl_embs_tensor, embodiment_id_tensor, actions_tensor]
+        logger.info(f"  state_features: {state_features.shape} ({state_features.dtype})")
+        logger.info(f"  vl_embs_tensor: {vl_embs_tensor.shape} ({vl_embs_tensor.dtype})")
+        logger.info(f"  embodiment_id_tensor: {embodiment_id_tensor.shape} ({embodiment_id_tensor.dtype})")
+        logger.info(f"  actions_tensor: {actions_tensor.shape} ({actions_tensor.dtype})")
+
+    precision_tag = "fp32" if not _COMPRESS_TO_FP16 else "fp16"
+    output_path = os.path.join(output_dir, f"dit_fused_{precision_tag}.xml")
+    os.makedirs(os.path.dirname(output_path), exist_ok=True)
+
+    logger.info(f"  Converting to OpenVINO IR: {output_path}...")
+    logger.info("  This may take a while due to the denoising loop...")
+
+    try:
+        input_names = ["state_features", "vl_embs", "embodiment_id", "actions"]
+
+        if config.use_alternate_vl_dit:
+            input_names.extend(["image_mask", "backbone_attention_mask"])
+
+        with torch.inference_mode():
+            pt_output = fused_model(*example_inputs)
+            ov_model = ov.convert_model(fused_model, example_input=example_inputs)
+        _log_ov_vs_pytorch("Direct OV", ov_model, input_names, example_inputs, pt_output)
+        ov.save_model(ov_model, output_path, compress_to_fp16=_COMPRESS_TO_FP16)
+
+        logger.info("  ✓ Fused DiT exported successfully to OpenVINO IR!")
+        logger.info(f"  Saved: {output_path}")
+        logger.info(f"  Saved: {output_path.replace('.xml', '.bin')}")
+        logger.info("\n  IMPORTANT: Fused DiT expects state_features (already encoded) as input")
+        logger.info("             During inference: state_encoder → dit_fused")
+
+        return output_path
+
+    except Exception as e:
+        logger.error(f"  ✗ Fused DiT export failed: {type(e).__name__}: {e}")
+        logger.info("  You can still use the individual models (action_encoder, dit, action_decoder)")
+        raise
+    finally:
+        # Always restore original processors
+        logger.info("  Restoring original attention processors...")
+        restore_attention_processors(fused_model, original_processors)
+
