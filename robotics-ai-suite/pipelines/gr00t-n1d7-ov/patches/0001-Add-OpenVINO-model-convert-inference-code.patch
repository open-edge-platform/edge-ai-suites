+"""
+Export GR00T N1.7 model components directly to OpenVINO IR format.
+
+This script builds on the N1.7 export flow and uses direct OpenVINO conversion,
+supporting three export modes:
+  - dit_only:      Export only the DiT (backward compatible with N1.6).
+  - action_head:   Export 4 action head components (ViT + LLM stay in PyTorch).
+  - full_pipeline: Export ViT + LLM + 4 action head components.
+
+Usage:
+    # Download base model first
+    uv run hf download nvidia/GR00T-N1.7-3B --local-dir checkpoints/GR00T-N1.7-3B
+
+    # DiT only (default)
+    python scripts/deployment/export_ov_n1d7.py \\
+        --model-path checkpoints/GR00T-N1.7-3B \\
+        --dataset-path demo_data/libero_demo \\
+        --embodiment-tag LIBERO_PANDA \\
+        --output-dir ./gr00t_n1d7_ov
+
+    # Action head (4 components)
+    python scripts/deployment/export_ov_n1d7.py \\
+        --model-path checkpoints/GR00T-N1.7-3B \\
+        --dataset-path demo_data/libero_demo \\
+        --embodiment-tag LIBERO_PANDA \\
+        --output-dir ./gr00t_n1d7_ov \\
+        --export-mode action_head
+
+    # Full pipeline
+    python scripts/deployment/export_ov_n1d7.py \\
+        --model-path checkpoints/GR00T-N1.7-3B \\
+        --dataset-path demo_data/libero_demo \\
+        --embodiment-tag LIBERO_PANDA \\
+        --output-dir ./gr00t_n1d7_ov \\
+        --export-mode full_pipeline
+"""
