+@dataclass(frozen=True)
+class EmbodimentAdapter:
+    name: str
+    get_camera_names: Callable[[int], list[str]]
+    create_modality_configs: Callable[[list[str]], dict[str, ModalityConfig]]
+    prepare_observation_from_row: Callable[[Any, Gr00tPolicy, list[str], Any], dict[str, Any]]
+    load_task_mapping: Callable[[str], Any] | None = None
+
+
+def add_common_arguments(
+    parser: argparse.ArgumentParser,
+    *,
+    description: str,
+    default_embodiment_tag: str,
+    default_num_cameras: int = 4,
+    num_camera_choices: list[int] | None = None,
+) -> argparse.ArgumentParser:
+    parser.description = description
+    parser.add_argument("--model-path", type=str, required=True, help="Path to PyTorch checkpoint")
+    parser.add_argument("--dataset-path", type=str, required=True, help="Path to dataset")
+    parser.add_argument("--ov-model-dir", type=str, required=True, help="Directory containing OpenVINO IR models")
+    parser.add_argument(
+        "--embodiment-tag",
+        type=str,
+        default=default_embodiment_tag,
+        help="Embodiment tag",
+    )
+    parser.add_argument(
+        "--num-cameras",
+        type=int,
+        default=default_num_cameras,
+        choices=num_camera_choices,
+        help="Number of cameras for the selected embodiment adapter",
+    )
+    parser.add_argument("--num-samples", type=int, default=10, help="Number of episodes to process")
+    parser.add_argument(
+        "--device",
+        type=str,
+        default="GPU",
+        choices=["CPU", "GPU", "NPU", "AUTO"],
+        help="OpenVINO device",
+    )
+    parser.add_argument("--use-fused-dit", action="store_true", help="Use fused DiT if available")
+    parser.add_argument(
+        "--full-ov",
+        action="store_true",
+        help="Use full OpenVINO path including LLM and VL self-attention",
+    )
+    parser.add_argument(
+        "--force-fp32",
+        action="store_true",
+        help="Force FP32 precision for full GPU inference",
+    )
+    return parser
+
+
+def _setup_openvino_policy(args: argparse.Namespace, policy: Gr00tPolicy) -> None:
+    logger.info("\nSetting up OpenVINO models...")
+    if args.full_ov:
+        if args.force_fp32:
+            logger.info("  Using FP32-forced full loader")
+            setup_openvino_models_n1d7_full_fp32(
+                policy,
+                ov_model_path=args.ov_model_dir,
+                device=args.device,
+                use_fused_dit=args.use_fused_dit,
+            )
+        else:
+            logger.info("  Using auto-detected precision full loader")
+            setup_openvino_models_n1d7_full(
+                policy,
+                ov_model_path=args.ov_model_dir,
+                device=args.device,
+                use_fused_dit=args.use_fused_dit,
+            )
+    else:
+        logger.info("  Using auto-detected precision partial loader")
+        setup_openvino_models_n1d7(
+            policy,
+            ov_model_path=args.ov_model_dir,
+            device=args.device,
+            use_fused_dit=args.use_fused_dit,
+        )
+    logger.info("✓ OpenVINO setup complete")
+
+
+def _log_backbone_timing(backbone_stats: dict[str, Any]) -> None:
+    logger.info("  Backbone timing:")
+    if "vit_inference" in backbone_stats:
+        vit_total = backbone_stats.get("vit", 0) * 1000
+        vit_prep = backbone_stats.get("vit_data_prep", 0) * 1000
+        vit_infer = backbone_stats.get("vit_inference", 0) * 1000
+        vit_post = backbone_stats.get("vit_postproc", 0) * 1000
+        pixel_device = backbone_stats.get("pixel_values_device", "unknown")
+        pixel_shape = backbone_stats.get("pixel_values_shape", "unknown")
+        vit_ov_device = backbone_stats.get("vit_ov_device", "unknown")
+
+        logger.info(f"    ViT (OpenVINO):           {vit_total:.1f}ms")
+        logger.info(f"      Input: {pixel_device}, Shape: {pixel_shape}")
+        logger.info(f"      Execution: {vit_ov_device}")
+        logger.info(f"      - Data prep:            {vit_prep:.1f}ms")
+
+        if "vit_gpu_to_cpu" in backbone_stats:
+            gpu_to_cpu = backbone_stats.get("vit_gpu_to_cpu", 0) * 1000
+            dtype_conv = backbone_stats.get("vit_dtype_conversion", 0) * 1000
+            logger.info(f"        * dtype conversion:   {dtype_conv:.1f}ms")
+            logger.info(f"        * GPU→CPU transfer:   {gpu_to_cpu:.1f}ms")
+
+        logger.info(f"      - Inference:            {vit_infer:.1f}ms")
+        logger.info(f"      - Postprocess:          {vit_post:.1f}ms")
+    else:
+        logger.info(f"    ViT (OpenVINO):           {backbone_stats.get('vit', 0) * 1000:.1f}ms")
+
+    if "llm_prep" in backbone_stats:
+        logger.info(f"    LLM prep (PyTorch):       {backbone_stats.get('llm_prep', 0) * 1000:.1f}ms")
+        for stat_key, label in [
+            ("llm_prep_embed_tokens", "embed_tokens"),
+            ("llm_prep_mask_scatter", "mask + scatter"),
+            ("llm_prep_rope", "rope index"),
+            ("llm_prep_trim", "padding trim"),
+            ("llm_prep_to_numpy", "to numpy"),
+            ("llm_prep_dense_delta", "dense delta"),
+        ]:
+            if stat_key in backbone_stats:
+                logger.info(f"      - {label:18} {backbone_stats.get(stat_key, 0) * 1000:.1f}ms")
+
+    logger.info(f"    LLM (OpenVINO):           {backbone_stats.get('llm', 0) * 1000:.1f}ms")
+    if "vl_self_attention" in backbone_stats:
+        logger.info(
+            f"    VL Self-Attn (OpenVINO):  {backbone_stats.get('vl_self_attention', 0) * 1000:.1f}ms"
+        )
+
+
+def _log_action_head_timing(action_stats: dict[str, Any], num_steps: int) -> None:
+    logger.info("  Action head timing:")
+    if "dit_fused" in action_stats:
+        logger.info(f"    State Encoder (OpenVINO): {action_stats.get('state_encoder', 0) * 1000:.1f}ms")
+        logger.info(
+            f"    Fused DiT (OpenVINO, {num_steps} steps): {action_stats.get('dit_fused', 0) * 1000:.1f}ms"
+        )
+        return
+
+    if "vlln" in action_stats:
+        logger.info(f"    VLLN (PyTorch):           {action_stats.get('vlln', 0) * 1000:.1f}ms")
+    if "vl_self_attention" in action_stats:
+        logger.info(
+            f"    VL Self-Attn (PyTorch):   {action_stats.get('vl_self_attention', 0) * 1000:.1f}ms"
+        )
+    logger.info(f"    State Encoder (OpenVINO): {action_stats.get('state_encoder', 0) * 1000:.1f}ms")
+
+    action_enc_total = action_stats.get("action_encoder_total", 0)
+    dit_total = action_stats.get("dit_total", 0)
+    action_dec_total = action_stats.get("action_decoder_total", 0)
+    if action_enc_total > 0 or dit_total > 0 or action_dec_total > 0:
+        logger.info(f"    Diffusion loop ({num_steps} steps):")
+        if action_enc_total > 0:
+            logger.info(
+                f"      Action Encoder (OpenVINO): {action_enc_total * 1000:.1f}ms ({action_enc_total / num_steps * 1000:.1f}ms/step)"
+            )
+        if dit_total > 0:
+            logger.info(
+                f"      DiT (OpenVINO):            {dit_total * 1000:.1f}ms ({dit_total / num_steps * 1000:.1f}ms/step)"
+            )
+        if action_dec_total > 0:
+            logger.info(
+                f"      Action Decoder (OpenVINO): {action_dec_total * 1000:.1f}ms ({action_dec_total / num_steps * 1000:.1f}ms/step)"
+            )
+
