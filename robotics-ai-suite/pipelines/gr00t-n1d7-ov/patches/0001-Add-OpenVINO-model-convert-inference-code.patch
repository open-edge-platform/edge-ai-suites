+
+        logger.info("\n--- [4d] State Encoder ---")
+        export_state_encoder_to_ov(policy, args.output_dir, use_fp32=use_fp32, batch_size=bs)
+
+        if args.use_fused_dit:
+            logger.info("\n--- [4e] Fused DiT (action_encoder + DiT + action_decoder) ---")
+            export_dit_fused_to_ov(policy, dit_capture, args.output_dir, use_fp32=use_fp32, batch_size=bs)
+        else:
+            logger.info("\n--- [4e] Action Encoder ---")
+            export_action_encoder_to_ov(policy, args.output_dir, use_fp32=use_fp32, batch_size=bs)
+
+            logger.info("\n--- [4f] DiT ---")
+            dit_output_path = os.path.join(args.output_dir, f"dit_{precision_tag}.xml")
