+#!/usr/bin/env python3
+"""Run OpenVINO-accelerated GR00T N1.7 inference on the base model.
+
+This is a generic script that works with any embodiment tag supported by the
+base checkpoint.  It does not require a dataset — it synthesizes dummy
+observations from the checkpoint's modality config and statistics, making it
+suitable for benchmarking and validating the exported OpenVINO IR models.
+
+Usage:
+    python scripts/deployment/run_base_ov_inference.py \
+        --model-path checkpoints/GR00T-N1.7-3B \
+        --ov-model-dir checkpoints/real_g1_full_direct \
+        --embodiment-tag REAL_G1 \
+        --num-samples 5 \
+        --device CPU \
+        --full-ov
+"""
+
+import argparse
+import json
+import logging
+import sys
+import time
+from pathlib import Path
+
+import numpy as np
+import torch
+
+script_dir = Path(__file__).parent
+if str(script_dir) not in sys.path:
+    sys.path.insert(0, str(script_dir))
+
