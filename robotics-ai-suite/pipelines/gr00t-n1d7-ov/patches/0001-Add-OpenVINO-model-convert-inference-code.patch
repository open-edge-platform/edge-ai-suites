+def run_openvino_dataset_inference(
+    args: argparse.Namespace,
+    adapter: EmbodimentAdapter,
+    *,
+    run_title: str,
+) -> None:
+    camera_names = adapter.get_camera_names(args.num_cameras)
+
+    logger.info("=" * 80)
+    logger.info(run_title)
+    logger.info("=" * 80)
+    logger.info(f"PyTorch checkpoint: {args.model_path}")
+    logger.info(f"OpenVINO models: {args.ov_model_dir}")
+    logger.info(f"Dataset: {args.dataset_path}")
+    logger.info(f"Embodiment adapter: {adapter.name}")
+    logger.info(f"Camera configuration: {args.num_cameras} ({', '.join(camera_names)})")
+    logger.info(f"Device: {args.device}")
+    logger.info(
+        f"Mode: {'FULL OpenVINO (ViT+LLM+VL+Action Head)' if args.full_ov else 'Partial OpenVINO (ViT-accelerated path)'}"
+    )
+    logger.info(f"Fused DiT: {'enabled' if args.use_fused_dit else 'disabled'}")
+    logger.info("=" * 80)
+
+    logger.info("\nLoading GR00T policy...")
+    embodiment_tag = EmbodimentTag.resolve(args.embodiment_tag)
+    policy = Gr00tPolicy(model_path=args.model_path, embodiment_tag=embodiment_tag, device="cpu")
+    logger.info("✓ Policy loaded (PyTorch)")
+
+    _setup_openvino_policy(args, policy)
+
+    logger.info("\nLoading dataset...")
+    task_mapping = adapter.load_task_mapping(args.dataset_path) if adapter.load_task_mapping else None
+    if task_mapping is not None:
+        try:
+            logger.info(f"✓ Loaded task mapping: {len(task_mapping)} tasks")
+        except TypeError:
+            logger.info("✓ Loaded task mapping")
+
+    modality_configs = adapter.create_modality_configs(camera_names)
+    loader = LeRobotEpisodeLoader(
+        dataset_path=args.dataset_path,
+        modality_configs=modality_configs,
+        video_backend="torchcodec",
+    )
+    logger.info(f"✓ Dataset loaded: {len(loader)} episodes")
+
+    logger.info("\n" + "=" * 80)
+    logger.info("WARMUP PHASE (10 runs)")
+    logger.info("=" * 80)
+    logger.info("Running 10 warmup inferences to compile and cache GPU kernels...")
+    logger.info("(First run will be slow, subsequent runs should stabilize)")
+
+    warmup_episodes = min(10, len(loader))
+    for warmup_idx in range(warmup_episodes):
+        episode_data = loader[warmup_idx % len(loader)]
+        if len(episode_data) == 0:
+            continue
+        row = episode_data.iloc[0]
+        observation = adapter.prepare_observation_from_row(row, policy, camera_names, task_mapping)
+
+        start = time.time()
+        with torch.no_grad():
+            policy.get_action(observation)
+        warmup_time = time.time() - start
+
+        if warmup_idx < 3:
+            logger.info(f"  Warmup {warmup_idx + 1}/10: {warmup_time:.3f}s (compiling kernels...)")
+        else:
+            logger.info(f"  Warmup {warmup_idx + 1}/10: {warmup_time:.3f}s")
+
+    logger.info("✓ Warmup complete! GPU kernels compiled and cached.\n")
+
+    logger.info("=" * 80)
+    logger.info(f"TIMED INFERENCE ({args.num_samples} episodes)")
+    logger.info("=" * 80)
+
+    results: list[dict[str, Any]] = []
+    total_time = 0.0
+
+    for ep_idx in range(min(args.num_samples, len(loader))):
+        try:
+            episode_data = loader[ep_idx]
+            if len(episode_data) == 0:
+                logger.warning(f"Episode {ep_idx} is empty, skipping")
+                continue
+
+            row = episode_data.iloc[0]
+            observation = adapter.prepare_observation_from_row(row, policy, camera_names, task_mapping)
+
+            if ep_idx == 0:
+                logger.info("[DEBUG] Checking observation data devices:")
+                for key, val in observation.items():
+                    if isinstance(val, dict):
+                        for subkey, subval in val.items():
+                            if isinstance(subval, np.ndarray):
+                                logger.info(f"  {key}.{subkey}: numpy array")
+                            elif isinstance(subval, torch.Tensor):
+                                logger.info(f"  {key}.{subkey}: torch.Tensor on {subval.device}")
+
+            start_time = time.time()
+            with torch.no_grad():
+                action, info = policy.get_action(observation)
+            del info
+            inference_time = time.time() - start_time
+            total_time += inference_time
+
+            logger.info(f"Episode {ep_idx + 1}/{args.num_samples}:")
+            logger.info(f"  Total inference time: {inference_time:.3f}s")
+
+            if hasattr(policy.model.backbone, "_timing_stats"):
+                _log_backbone_timing(policy.model.backbone._timing_stats)
+            if hasattr(policy.model.action_head, "_timing_stats"):
+                num_steps = policy.model.action_head.num_inference_timesteps
+                _log_action_head_timing(policy.model.action_head._timing_stats, num_steps)
+
+            logger.info(f"  Action summary: {len(action)} modalities, shape {list(action.values())[0].shape}")
+
+            results.append(
+                {
+                    "episode_idx": ep_idx,
+                    "inference_time": inference_time,
+                    "timing_breakdown": _collect_timing_breakdown(policy),
+                }
+            )
+        except Exception as exc:
+            logger.error(f"✗ Error on episode {ep_idx}: {exc}")
+            import traceback
+
+            traceback.print_exc()
+
+    _summarize_results(results, total_time)
