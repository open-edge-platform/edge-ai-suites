   // cout<<"IMU got at: "<<msg_in->header.stamp.toSec()<<endl;
   sensor_msgs::msg::Imu::SharedPtr msg(new sensor_msgs::msg::Imu(*msg_in));
 
+  mtx_buffer.lock();
+
   msg->header.stamp = get_ros_time(get_time_sec(msg_in->header.stamp) - time_diff_lidar_to_imu);
   if (abs(timediff_lidar_wrt_imu) > 0.1 && time_sync_en) {
     msg->header.stamp = rclcpp::Time(timediff_lidar_wrt_imu + get_time_sec(msg_in->header.stamp));
@@ -551,8 +556,6 @@ void imu_cbk(const sensor_msgs::msg::Imu::UniquePtr msg_in)
 
   double timestamp = get_time_sec(msg->header.stamp);
 
-  mtx_buffer.lock();
-
   if (timestamp < last_timestamp_imu) {
     std::cerr << "lidar loop back, clear buffer" << std::endl;
     imu_buffer.clear();
@@ -569,7 +572,9 @@ double lidar_mean_scantime = 0.0;
 int scan_num = 0;
 bool sync_packages(MeasureGroup & meas)
 {
+  mtx_buffer.lock();
   if (lidar_buffer.empty() || imu_buffer.empty()) {
+    mtx_buffer.unlock();
     return false;
   }
 
@@ -596,6 +601,7 @@ bool sync_packages(MeasureGroup & meas)
   }
 
   if (last_timestamp_imu < lidar_end_time) {
+    mtx_buffer.unlock();
     return false;
   }
 
@@ -612,6 +618,7 @@ bool sync_packages(MeasureGroup & meas)
   lidar_buffer.pop_front();
   time_buffer.pop_front();
   lidar_pushed = false;
+  mtx_buffer.unlock();
   return true;
 }
 
