+# G1 Deploy - Observation Configuration (VLA + Sonic variant)
+# ===========================================================
+# Same as observation_config.yaml, except planner runs on CPU.
+# The planner ONNX (planner/target_vel/V2/planner_sonic.onnx) currently
+# fails to legalize on the OpenVINO NPU compiler (vpux-compiler error on
+# /Mul_300 broadcast 1x1x1x1 -> 1x4x1x1). Encoder and policy still run
+# on NPU.
+
+observations:
+
+  - name: "token_state"
+    enabled: true
+
+  - name: "his_base_angular_velocity_10frame_step1"
+    enabled: true
+
+  - name: "his_body_joint_positions_10frame_step1"
+    enabled: true
+
+  - name: "his_body_joint_velocities_10frame_step1"
