+# ---------------------------------------------------------------------------
+# Action publisher abstraction
+# ---------------------------------------------------------------------------
+#
+# The two transports differ only in the sink for latent-action bytes:
+#   ZMQ:  PUB socket carrying (a) the 'pose' topic (latent action + hand joints)
+#         and (b) the 'command' topic (start/stop/mode switch).
+#   ROS2: rclpy publisher on ControlPolicy/vla_token carrying a Protocol-v4
+#         packed payload. There is NO command channel — mode transitions are
+#         folded into an edge-triggered ``toggle_vla_mode`` field inside the
+#         same packed payload (see ros2_input_handler.hpp:637-676).
+#
+# Both back-ends expose the same three methods so the main loop stays agnostic:
+#   send_latent_action(payload_bytes)   — the packed motion-token message
+#   send_command(start, stop, planner)  — ZMQ only; ROS 2 backend is a no-op
+#   close()                             — cleanup on shutdown
+# ---------------------------------------------------------------------------
+
+
+class _ZmqActionPublisher:
+    """ZMQ PUB back-end: latent actions on 'pose', control on 'command'."""
+
+    supports_toggle_vla_mode = False
+
+    def __init__(self, host: str, port: int):
+        self._ctx = zmq.Context()
+        self._sock = self._ctx.socket(zmq.PUB)
+        self._sock.bind(f"tcp://{host}:{port}")
+        time.sleep(0.1)  # let subscribers connect
+        print_green(f"ZMQ action socket bound to tcp://{host}:{port}")
+
+    def send_latent_action(
+        self,
+        motion_token: np.ndarray,
+        frame_index: np.ndarray,
+        left_hand_joints: np.ndarray = None,
+        right_hand_joints: np.ndarray = None,
+        toggle_vla_mode: bool = False,
+    ) -> None:
+        # toggle_vla_mode is a ROS 2 concept; the ZMQ path expresses mode
+        # switching via the separate 'command' topic. Silently drop the flag
+        # rather than smuggling an unexpected field onto the 'pose' topic.
+        payload = pack_latent_action_message(
+            motion_token=motion_token,
+            frame_index=frame_index,
+            left_hand_joints=left_hand_joints,
+            right_hand_joints=right_hand_joints,
+            toggle_vla_mode=False,
+            topic="pose",
+        )
+        self._sock.send(payload)
+
+    def send_command(self, start: bool, stop: bool, planner: bool) -> bool:
+        try:
+            self._sock.send(build_command_message(start=start, stop=stop, planner=planner))
+            time.sleep(0.01)  # give the subscriber a moment to pick it up
+            return True
+        except Exception as e:
+            print(f"Warning: Failed to send command message: {e}")
+            return False
+
+    def send_control_goal_toggle(self) -> bool:
+        # No-op in ZMQ mode — warm-up goes through send_command (start=True,
+        # planner=True). Kept for polymorphism with the ROS 2 back-end.
+        return False
+
+    def close(self) -> None:
+        self._sock.close()
+        self._ctx.term()
+
+
+class _Ros2ActionPublisher:
+    """ROS 2 back-end: latent actions on ControlPolicy/vla_token (ByteMultiArray).
+
+    Lazily imports rclpy so the ZMQ path never touches the ROS 2 stack.
+
+    Optionally publishes a msgpack-encoded ControlGoalMsg on
+    ControlPolicy/upper_body_pose (matching dummy_nav_publisher.py's wire
+    format) — used only for the warm-up 'k' pulse to start C++ control
+    without entering VLA mode.
+    """
+
+    supports_toggle_vla_mode = True
+
+    def __init__(self, vla_token_topic: str, control_goal_topic: str = ""):
+        import rclpy
+        from rclpy.qos import (
+            QoSDurabilityPolicy,
+            QoSHistoryPolicy,
+            QoSProfile,
+            QoSReliabilityPolicy,
+        )
+        from std_msgs.msg import ByteMultiArray
+
+        self._rclpy = rclpy
+        self._ByteMultiArray = ByteMultiArray
+
+        if not rclpy.ok():
+            rclpy.init()
+        self._node = rclpy.create_node("run_vla_inference")
+        qos = QoSProfile(
+            reliability=QoSReliabilityPolicy.RELIABLE,
+            history=QoSHistoryPolicy.KEEP_LAST,
+            depth=1,
+            durability=QoSDurabilityPolicy.VOLATILE,
+        )
+        self._pub = self._node.create_publisher(ByteMultiArray, vla_token_topic, qos)
+
+        # Optional ControlGoalMsg (msgpack) publisher for warm-up. Lazily
+        # created only if control_goal_topic is provided so `pip install
+        # msgpack msgpack-numpy` isn't required for the vla-only path.
+        self._goal_pub = None
+        self._msgpack = None
+        self._mnp = None
+        if control_goal_topic:
+            import msgpack
+            import msgpack_numpy as mnp
+
+            self._msgpack = msgpack
+            self._mnp = mnp
+            self._goal_pub = self._node.create_publisher(
+                ByteMultiArray, control_goal_topic, qos
+            )
+            print_green(
+                f"ROS 2 warm-up publisher created for topic '{control_goal_topic}'"
+            )
+
+        # Spin the node so publisher lifecycle events and DDS discovery keep
+        # progressing. Daemon so it dies with the process.
+        self._spin_stop = threading.Event()
+
+        def _spin():
+            while not self._spin_stop.is_set() and rclpy.ok():
+                try:
+                    rclpy.spin_once(self._node, timeout_sec=0.1)
+                except Exception:
+                    break
+
+        self._spin_thread = threading.Thread(target=_spin, daemon=True)
+        self._spin_thread.start()
+        print_green(f"ROS 2 publisher created for topic '{vla_token_topic}'")
+
+    def send_latent_action(
+        self,
+        motion_token: np.ndarray,
+        frame_index: np.ndarray,
+        left_hand_joints: np.ndarray = None,
+        right_hand_joints: np.ndarray = None,
+        toggle_vla_mode: bool = False,
+    ) -> None:
+        payload = pack_latent_action_message(
+            motion_token=motion_token,
+            frame_index=frame_index,
+            left_hand_joints=left_hand_joints,
+            right_hand_joints=right_hand_joints,
+            toggle_vla_mode=toggle_vla_mode,
+            topic="",  # ROS 2 uses topic in the URL, not as a byte prefix
+        )
+        # std_msgs/ByteMultiArray.data is bytes[] (each element 1 byte);
+        # matches dummy_vla_token_publisher.py:to_byte_multi_array.
+        msg = self._ByteMultiArray()
+        msg.data = [bytes([b]) for b in payload]
+        self._pub.publish(msg)
+
+    def send_command(self, start: bool, stop: bool, planner: bool) -> bool:
+        # No separate command channel in ROS 2 mode — the deploy auto-starts
+        # control on the first toggle_vla_mode rising edge; mode switching is
+        # driven by toggle_vla_mode pulses inside the vla_token stream.
+        print("[ROS2] send_command is a no-op (mode changes go through toggle_vla_mode)")
+        return True
+
+    def send_control_goal_toggle(self) -> bool:
+        """Publish one ControlGoalMsg with toggle_policy_action=True.
+      
+        On the deploy side this flips control_is_active_ true, warming up the planner
+        WITHOUT touching vla_mode_active_. Returns False if the goal
+        publisher wasn't created .
+        """
+        if self._goal_pub is None:
+            print("[ROS2] warm-up publisher not initialised — pass "
+                  "control_goal_topic to enable")
+            return False
+        payload = {
+            "navigate_cmd": [0.0, 0.0, 0.0],
+            "base_height_command": 0.78,
+            "toggle_policy_action": True,
+            "locomotion_mode": 1,
+            "ros_timestamp": time.time(),
+            "valid": True,
+        }
+        packed = self._msgpack.packb(payload, default=self._mnp.encode)
+        msg = self._ByteMultiArray()
+        msg.data = [bytes([b]) for b in packed]
+        self._goal_pub.publish(msg)
+        return True
+
+    def close(self) -> None:
+        self._spin_stop.set()
+        if self._spin_thread.is_alive():
+            self._spin_thread.join(timeout=1.0)
+        try:
+            self._node.destroy_node()
+        finally:
+            if self._rclpy.ok():
+                self._rclpy.shutdown()
 
 
