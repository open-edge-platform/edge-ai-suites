diff --git a/gear_sonic_deploy/policy/release/observation_config.yaml b/gear_sonic_deploy/policy/release/observation_config.yaml
index 48b1002..4984190 100644
--- a/gear_sonic_deploy/policy/release/observation_config.yaml
+++ b/gear_sonic_deploy/policy/release/observation_config.yaml
@@ -95,11 +95,13 @@ inference:
   encoder_priority: "HIGH"
   policy_priority: "HIGH"
   planner_priority: "NORMAL"
+  # NPU_TURBO for all NPU models: prioritize inference latency over power
+  # efficiency (mapped to ov::hint NPU_TURBO=YES). Recommended ON for real-time
+  # control. NPU-only hint; ignored on CPU/GPU. Set false to save power/thermal.
+  npu_turbo: true
   # Pin the inference/control thread to a specific CPU core to reduce latency jitter.
   # Set to -1 to disable pinning (default), or a core number (e.g., 10) to pin.
   # Here 10 is one of isolated core, dedicated for inference.
-  # use 'echo 10 | sudo tee /proc/irq/189/smp_affinity_list' to set vpu interrupt affitiy
-  # to reduce jitter in case NPU sync inference.
   cpu_affinity: 10
   # Emit a periodic "[Planner] Inference #N | latency | NaN/Inf check | mode/vel/dir"
   # summary line (every 10th planner inference, ~1 Hz on the 10 Hz planner thread).
diff --git a/gear_sonic_deploy/policy/release/observation_config_vla.yaml b/gear_sonic_deploy/policy/release/observation_config_vla.yaml
index f693320..90acb7f 100644
--- a/gear_sonic_deploy/policy/release/observation_config_vla.yaml
+++ b/gear_sonic_deploy/policy/release/observation_config_vla.yaml
@@ -92,18 +92,20 @@ inference:
   # Planner runs in a separate thread — can use more tiles for throughput.
   encoder_npu_tiles: 3
   policy_npu_tiles: 3
-  planner_npu_tiles: 0
+  planner_npu_tiles: 3
   # OpenVINO model priority: HIGH, NORMAL, or LOW. Controls how the OV scheduler
   # arbitrates models that share the same device (e.g. policy/encoder/planner on
   # one NPU). Mapped to ov::hint::model_priority. Default: NORMAL.
   encoder_priority: "HIGH"
   policy_priority: "HIGH"
   planner_priority: "NORMAL"
+  # NPU_TURBO for all NPU models: prioritize inference latency over power
+  # efficiency (mapped to ov::hint NPU_TURBO=YES). Recommended ON for real-time
+  # control. NPU-only hint; ignored on CPU/GPU. Set false to save power/thermal.
+  npu_turbo: true
   # Pin the inference/control thread to a specific CPU core to reduce latency jitter.
   # Set to -1 to disable pinning (default), or a core number (e.g., 10) to pin.
   # Here 10 is one of isolated core, dedicated for inference.
-  # use 'echo 10 | sudo tee /proc/irq/189/smp_affinity_list' to set vpu interrupt affitiy
-  # to reduce jitter in case NPU sync inference.
   cpu_affinity: 10
   # Emit a periodic "[Planner] Inference #N | latency | NaN/Inf check | mode/vel/dir"
   # summary line (every 10th planner inference, ~1 Hz on the 10 Hz planner thread).
