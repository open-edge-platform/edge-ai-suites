diff --git a/gear_sonic_deploy/src/OVInference/OVInferenceEngine.h b/gear_sonic_deploy/src/OVInference/OVInferenceEngine.h
index 7f3e71e..8e5c3cc 100644
--- a/gear_sonic_deploy/src/OVInference/OVInferenceEngine.h
+++ b/gear_sonic_deploy/src/OVInference/OVInferenceEngine.h
@@ -102,6 +102,15 @@ public:
     OVInferenceEngine();
     ~OVInferenceEngine();
 
+    // The engine owns a single OpenVINO compiled model plus pre-allocated
+    // tensor buffers (behind the pimpl). Copying would shallow-share that state
+    // via the shared_ptr and let two engines race on the same buffers, so copy
+    // is deleted; move transfers ownership cleanly (Coverity RULE_OF_ZERO_THREE_FIVE).
+    OVInferenceEngine(const OVInferenceEngine&) = delete;
+    OVInferenceEngine& operator=(const OVInferenceEngine&) = delete;
+    OVInferenceEngine(OVInferenceEngine&&) noexcept = default;
+    OVInferenceEngine& operator=(OVInferenceEngine&&) noexcept = default;
+
     using AxisSizes = std::map<std::string, int>;
 
     /**
diff --git a/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/include/control_policy.hpp b/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/include/control_policy.hpp
index 8141d15..295e554 100644
--- a/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/include/control_policy.hpp
+++ b/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/include/control_policy.hpp
@@ -46,6 +46,11 @@ public:
   PolicyEngine() = default;
   ~PolicyEngine() { Destroy(); }
 
+  // Owns a unique_ptr<TRTInferenceEngine> and I/O buffers; make the documented
+  // "non-copyable" contract explicit (Coverity RULE_OF_ZERO_THREE_FIVE).
+  PolicyEngine(const PolicyEngine&) = delete;
+  PolicyEngine& operator=(const PolicyEngine&) = delete;
+
   /**
    * @brief Initialize the control policy from a model path
    * @param model_path Path to ONNX model file
diff --git a/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/include/encoder.hpp b/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/include/encoder.hpp
