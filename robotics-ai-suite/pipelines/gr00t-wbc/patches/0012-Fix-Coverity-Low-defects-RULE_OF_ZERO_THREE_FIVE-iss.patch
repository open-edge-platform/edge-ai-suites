@@ -359,9 +359,14 @@ struct PlannerMotionState {
  */
 class MotionRecorder {
 public:
-  MotionRecorder(const std::string& base_dir = "reference/recorded_motion") 
+  MotionRecorder(const std::string& base_dir = "reference/recorded_motion")
     : base_dir_(base_dir), active_(false), frames_written_(0) {}
-  
+
+  // Owns output file streams finalized in the destructor; copying would duplicate
+  // that ownership, so it is deleted (Coverity RULE_OF_ZERO_THREE_FIVE).
+  MotionRecorder(const MotionRecorder&) = delete;
+  MotionRecorder& operator=(const MotionRecorder&) = delete;
+
   ~MotionRecorder() {
     if (active_) {
       Finalize();
diff --git a/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/include/state_logger.hpp b/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/include/state_logger.hpp
index 87bcc17..4197e47 100644
--- a/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/include/state_logger.hpp
+++ b/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/include/state_logger.hpp
@@ -142,7 +142,10 @@ class StateLogger {
   StateLogger(std::string csv_dir, size_t ring_capacity, int num_joints = -1, int num_actions = -1, double dt_seconds = 0.0, bool enable_csv = true,
               std::map<std::string, std::variant<std::string, int, double, bool>> robot_config = {});
 
-  // Non-copyable, movable
+  // Non-copyable, movable. Destructor declared explicitly so all five special
+  // members are declared together (Coverity RULE_OF_ZERO_THREE_FIVE); the
+  // default is correct since members clean up via RAII.
+  ~StateLogger() = default;
   StateLogger(const StateLogger&) = delete;
   StateLogger& operator=(const StateLogger&) = delete;
   StateLogger(StateLogger&&) = default;
diff --git a/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/src/fk.cpp b/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/src/fk.cpp
index b430995..cdedf49 100644
