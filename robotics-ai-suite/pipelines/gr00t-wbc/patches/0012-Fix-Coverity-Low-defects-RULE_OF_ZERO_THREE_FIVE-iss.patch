@@ -52,6 +52,11 @@ public:
   EncoderEngine() = default;
   ~EncoderEngine() { Destroy(); }
 
+  // Owns the inference engine and I/O buffers; make the documented
+  // "non-copyable" contract explicit (Coverity RULE_OF_ZERO_THREE_FIVE).
+  EncoderEngine(const EncoderEngine&) = delete;
+  EncoderEngine& operator=(const EncoderEngine&) = delete;
+
   /**
    * @brief Initialize the encoder engine from a model path
    * @param model_path Path to ONNX model file
