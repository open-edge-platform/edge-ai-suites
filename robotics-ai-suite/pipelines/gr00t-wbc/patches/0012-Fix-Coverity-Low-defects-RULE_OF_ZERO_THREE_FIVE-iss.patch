+++ b/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/src/fk.cpp
@@ -43,6 +43,11 @@ struct XMLOwner
         }
     }
 
+    // Owns a raw xml.h parse tree freed in the destructor; copying would
+    // double-free it, so copy is deleted (Coverity RULE_OF_ZERO_THREE_FIVE).
+    XMLOwner(const XMLOwner&) = delete;
+    XMLOwner& operator=(const XMLOwner&) = delete;
+
     XMLNode *root_ = nullptr;
 };
 
