diff --git a/gear_sonic_deploy/scripts/detect_openvino.sh b/gear_sonic_deploy/scripts/detect_openvino.sh
new file mode 100644
index 0000000..96e87f4
--- /dev/null
+++ b/gear_sonic_deploy/scripts/detect_openvino.sh
@@ -0,0 +1,87 @@
+# Shared OpenVINO detection — source this file, don't execute it.
+#
+# Provides two functions:
+#   detect_openvino      → sets global OPENVINO_FOUND (true/false); on success
+#                          exports OpenVINO_DIR and USE_OPENVINO=1.
+#                          Returns 0 if found, non-zero otherwise.
+#   openvino_install_hint → prints the "OpenVINO is required" install message.
+#
+# This project depends strictly on OpenVINO and never falls back to TensorRT/CUDA.
+# Both scripts/setup_env.sh and the .justfile `build` recipe use these helpers so
+# the detection logic lives in exactly one place.
+
+# Locations checked for an OpenVINO archive install (in priority order).
+# Entries are glob patterns, so e.g. "/opt/intel/openvino_2026*" also matches
+# "/opt/intel/openvino_2026.4.0", "/opt/intel/openvino_2026rc", etc.
+OPENVINO_PATHS=(
+  "/opt/intel/openvino_2026*"
+  "/opt/intel/openvino"
+  "/opt/intel/openvino_2025*"
+  "$HOME/intel/openvino*"
+)
+
+detect_openvino() {
+  # OpenVINO's setupvars.sh references vars that may be unset in a clean shell
+  # (LD_LIBRARY_PATH, PYTHONPATH, ...). Remember the caller's `nounset` state and
+  # relax it while sourcing so `set -u` callers (e.g. the justfile) don't abort.
+  local restore_u=0
+  case "$-" in *u*) restore_u=1 ;; esac
+  set +u
+  # Expand unmatched globs to nothing instead of the literal pattern.
+  local restore_nullglob
+  restore_nullglob="$(shopt -p nullglob)"
+  shopt -s nullglob
+
+  OPENVINO_FOUND=false
+  local pattern ov_path
+  for pattern in "${OPENVINO_PATHS[@]}"; do
+    for ov_path in $pattern; do   # unquoted → glob-expanded (nullglob skips misses)
+      [ -d "$ov_path" ] && [ -f "$ov_path/setupvars.sh" ] || continue
+      echo "✅ OpenVINO found at: $ov_path"
+      # shellcheck disable=SC1090
+      source "$ov_path/setupvars.sh" >/dev/null 2>&1 || true
+      # Prefer the path setupvars.sh resolved (follows symlinks); fall back to
+      # the archive's own runtime/cmake if it didn't export one.
+      export OpenVINO_DIR="${OpenVINO_DIR:-$ov_path/runtime/cmake}"
+      export USE_OPENVINO=1
+      OPENVINO_FOUND=true
+      break 2
+    done
+  done
+  eval "$restore_nullglob"
+
+  if [ "$OPENVINO_FOUND" = false ] && pkg-config --exists openvino 2>/dev/null; then
+    echo "✅ OpenVINO found via pkg-config"
+    export USE_OPENVINO=1
+    OPENVINO_FOUND=true
+  fi
+
+  if [ "$OPENVINO_FOUND" = false ] && [ "${USE_OPENVINO:-0}" = "1" ]; then
+    echo "✅ OpenVINO enabled via USE_OPENVINO=1"
+    OPENVINO_FOUND=true
+  fi
+
+  if [ "$restore_u" = 1 ]; then set -u; fi
+  [ "$OPENVINO_FOUND" = true ]
+}
+
+openvino_install_hint() {
+  cat <<'EOF'
+
+═══════════════════════════════════════════════════════════════════════
+❌ OpenVINO not found — this project REQUIRES the OpenVINO runtime.
+═══════════════════════════════════════════════════════════════════════
+
+This project depends strictly on OpenVINO and does NOT fall back to the
+TensorRT/CUDA backend. Please install the OpenVINO runtime using the
+official archive method for Linux:
+
+  https://docs.openvino.ai/2026/get-started/install-openvino/install-openvino-archive-linux.html
+
+Then run the standard setup from this directory:
+  source /opt/intel/openvino_2026/setupvars.sh
+  source scripts/setup_env.sh
+  just build
+
+EOF
+}
