-if [ "$OPENVINO_FOUND" = true ]; then
+# ── OpenVINO detection (required — shared helper) ──────────────────────────
+# OpenVINO is a hard dependency. Detection lives in scripts/detect_openvino.sh
+# and is shared with the .justfile `build` recipe. If OpenVINO is missing we
+# prompt the user to install it and stop here (this script is meant to be
+# *sourced*, so we `return` rather than kill the user's shell).
+SETUP_ENV_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck disable=SC1091
+source "$SETUP_ENV_DIR/detect_openvino.sh"
+
+if detect_openvino; then
     echo "🔵 OpenVINO mode enabled (USE_OPENVINO=1)"
     echo "   CUDA/TensorRT detection will be skipped"
+else
+    openvino_install_hint
+    return 1 2>/dev/null || exit 1
 fi
 
