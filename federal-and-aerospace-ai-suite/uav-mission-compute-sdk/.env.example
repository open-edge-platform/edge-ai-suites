# Copy this file to .env and set your own values before starting the stack.
#
#   cp .env.example .env
#
# .env is gitignored and never committed.
# If .env is absent, Docker Compose falls back to the defaults shown here.

# ── UAV Identity ─────────────────────────────────────────────────────────────
# Set this before starting the stack.
# Example: UAV_ID=uav-1
UAV_ID=

# ── Host bind address ────────────────────────────────────────────────────────
# Interface published ports (MAVLink, MQTT, RTSP, Grafana, InfluxDB) bind to.
# Defaults to loopback-only.
HOST_IP=127.0.0.1

# ── InfluxDB ──────────────────────────────────────────────────────────────────
# Fill these before starting the stack; leaving them empty will stop startup.
INFLUXDB_PASSWORD=
INFLUXDB_TOKEN=
INFLUXDB_ORG=

# ── Grafana ───────────────────────────────────────────────────────────────────
# Fill this before starting the stack; leaving it empty will stop startup.
GRAFANA_PASSWORD=

# ── GPU Device Paths (auto-detected by make init) ────────────────────────────
# Leave empty to use defaults; otherwise set to your GPU device paths.
# Examples: /dev/dri/card1, /dev/dri/renderD129, etc.
GPU_DEVICE=
GPU_RENDER_DEVICE=
# GID of the render group.
# Auto-detected by make init via stat /dev/dri/renderD*
GPU_RENDER_GID=

# ── USB Camera Bridge (opt-in, profile: usb-camera) ──────────────────────────
# Real V4L2 camera → RTSP, as an alternative to the simulated camera-bridge.
# Enumerate devices on the host with: v4l2-ctl --list-devices
#   docker compose --profile usb-camera up usb-camera-bridge
# Use v4l2-ctl --list-devices to enumerate. C922 Webcam detected at /dev/video32.
USB_VIDEO_DEVICE=/dev/video32
# Set to nadir/forward/rear to feed vision-processor in place of the sim camera.
USB_CAMERA_ID=nadir
USB_CAPTURE_WIDTH=1280
USB_CAPTURE_HEIGHT=720
USB_SENSOR_FPS=30
# mjpeg (most USB webcams) or raw (uncompressed YUY2, needs more USB bandwidth)
USB_CAPTURE_FORMAT=mjpeg

# ── Vision Processor Camera IDs ───────────────────────────────────────
# Which camera streams the vision processor listens to (comma-separated).
# Default (sim-camera): nadir,forward,rear
# For USB camera: match USB_CAMERA_ID (e.g., just "nadir" if USB_CAMERA_ID=nadir)
VISION_CAMERA_IDS=nadir,forward,rear
